      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Replace Odyss\303\251e reference quote with original Nova sanctuary copy starting with \'At Nova, we believe beauty is a personal expression of who you are.\'\",\"EndLine\":147,\"Instruction\":\"Update introduction.headline and introduction.body in src/data/salonData.ts with original Nova copy\",\"ReplacementContent\":\"  introduction: {\\n    kicker: \'THE SANCTUARY\',\\n    headline:\\n      \'At Nova, we believe beauty is a personal expression of who you are. Step into our sanctuary for unhurried rituals shaped around your natural rhythm.\',\\n    body:\\n      \'True radiance rarely comes from haste. Every appointment begins with attentive listening\342\200\224observing how you live, how your skin responds to the season, and what brings you a sense of calm restoration.\',\\n    ctaLabel: \'Book Consultation\',\\n  },\",\"StartLine\":138,\"TargetContent\":\"  introduction: {\\n    kicker: \'THE SANCTUARY\',\\n    headline:\\n      \'At Nova, we believe beauty is a personal expression of who you are. Visit our Hunters Hill space for a transformative experience in your aesthetic journey.\',\\n    body:\\n      \'Clarity precedes creation. Begin your tailored journey with a bespoke plan guided by science, precision, and exceptional care.\',\\n    ctaLabel: \'Book Consultation\',\\n  },\",\"TargetFile\":\"/src/data/salonData.ts\",\"toolAction\":\"Updating introduction copy to original Nova statement in salonData.ts\",\"toolSummary\":\"Update introduction copy in salonData.ts\"}"
