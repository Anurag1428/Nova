    replacement_infos {
      original_chunk {
        target_content: "            {/* 4. ODYSS\303\211E-STYLE ASYMMETRICAL INTRODUCTION (Matching reference `image_0c2f72bb.png`)\n                Left studio-blended portrait + Right col-start-4 indented light high-contrast serif statement */}\n            <section\n              id=\"introduction\"\n              aria-label=\"Sanctuary Introduction\"\n              className=\"pt-12 pb-28 md:pt-16 md:pb-40 px-4 sm:px-6 md:px-7 bg-[#FBF9F5] text-[#18224B]\"\n            >\n              <div className=\"mx-auto max-w-[1440px] grid grid-cols-1 md:grid-cols-12 gap-8 items-start\">\n                {/* Left Vertical Portrait \342\200\224 Clean rectangular frame with soft studio stone backdrop (#EAE8E3) */}\n                <div className=\"md:col-span-3 lg:col-span-2\">\n                  <div className=\"relative aspect-[3/4.15] w-full max-w-[245px] overflow-hidden bg-[#EAE8E3]\">\n                    <MediaSlot\n                      media={mediaSlots.introduction}\n                      subtleMotion={true}\n                      className=\"h-full w-full !bg-[#EAE8E3]\"\n                      imgClassName=\"mix-blend-multiply brightness-[0.98] contrast-[1.03] saturate-[0.9]\"\n                    />\n                  </div>\n                </div>\n\n                {/* Right Indented Serif Headline & Concise Call to Action (col-start-4 col-span-9) */}\n                <div className=\"md:col-span-9 lg:col-start-4 lg:col-span-9 flex flex-col justify-between pt-0.5\">\n                  <h2 className=\"font-serif-editorial text-[2.15rem] sm:text-[2.85rem] lg:text-[3.55rem] xl:text-[3.75rem] font-light leading-[1.08] tracking-[-0.024em] text-[#18224B] md:indent-[5.5rem] lg:indent-[7.5rem]\">\n                    {introduction.headline}\n                  </h2>\n\n                  <div className=\"mt-10 md:mt-12 max-w-[365px]\">\n                    <p className=\"font-basel text-[15px] md:text-[15.5px] font-normal leading-[1.46] tracking-[-0.01em] text-[#18224B]\">\n                      {introduction.body}\n                    </p>\n                    <div className=\"mt-7 md:mt-8\">\n                      <button\n                        type=\"button\"\n                        onClick={() => handleOpenBooking()}\n                        className=\"font-basel cursor-pointer text-[11px] font-normal uppercase tracking-[0.05em] text-[#18224B] hover:opacity-60 transition-opacity whitespace-nowrap shrink-0\"\n                      >\n                        {introduction.ctaLabel}\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </section>"
        replacement_content: "            {/* 4. ODYSS\303\211E-STYLE ASYMMETRICAL INTRODUCTION (Matching reference `image_0c2f72bb.png`)\n                Left studio-blended portrait + Right col-start-4 indented light high-contrast serif statement */}\n            <section\n              id=\"introduction\"\n              aria-label=\"Sanctuary Introduction\"\n              className=\"pt-12 pb-28 md:pt-16 md:pb-40 px-4 sm:px-6 md:px-7 bg-[#FBF9F5] text-[#18224B]\"\n            >\n              <div className=\"mx-auto max-w-[1440px] grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8 items-start\">\n                {/* Left Vertical Portrait \342\200\224 Clean rectangular frame with soft studio stone backdrop (#EBEAE6) */}\n                <div className=\"md:col-span-3 lg:col-span-2\">\n                  <div className=\"relative aspect-[3/4.35] w-full max-w-[240px] lg:w-[236px] overflow-hidden bg-[#EBEAE6]\">\n                    <MediaSlot\n                      media={mediaSlots.introduction}\n                      subtleMotion={true}\n                      className=\"h-full w-full !bg-[#EBEAE6]\"\n                      imgClassName=\"mix-blend-multiply brightness-[0.99] contrast-[1.05] saturate-[0.82]\"\n                    />\n                  </div>\n                </div>\n\n                {/* Right Indented Serif Headline & Concise Call to Action (col-start-4 col-span-9) */}\n                <div className=\"md:col-span-9 lg:col-start-4 lg:col-span-9 flex flex-col justify-between pt-1\">\n                  <h2 className=\"font-serif-editorial text-[1.95rem] sm:text-[2.4rem] lg:text-[2.82rem] xl:text-[2.95rem] font-light leading-[1.08] tracking-[-0.026em] text-[#18224B] md:indent-[5rem] lg:indent-[6.75rem]\">\n                    {introduction.headline}\n                  </h2>\n\n                  <div className=\"mt-9 md:mt-11 max-w-[365px]\">\n                    <p className=\"font-basel text-[15px] md:text-[15.5px] font-normal leading-[1.45] tracking-[-0.01em] text-[#18224B]\">\n                      {introduction.body}\n                    </p>\n                    <div className=\"mt-6 md:mt-7\">\n                      <button\n                        type=\"button\"\n                        onClick={() => handleOpenBooking()}\n                        className=\"font-basel cursor-pointer text-[11px] font-normal uppercase tracking-[0.05em] text-[#18224B] hover:opacity-60 transition-opacity whitespace-nowrap shrink-0\"\n                      >\n                        {introduction.ctaLabel}\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </section>"
        start_line: 234
        end_line: 280
      }
      num_matches: 1
