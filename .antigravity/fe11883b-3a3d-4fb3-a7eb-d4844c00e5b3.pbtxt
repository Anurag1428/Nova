            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        // Longitude angle on the front hemisphere (-PI/2 to +PI/2)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
