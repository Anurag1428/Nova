_a1024b4a.png\n/.aistudio/artifacts/brain/6ef9b674-1cbd-4c50-9b2a-bf22bad71f40/.tempmediaStorage/media_1792863100360_d786c5f7.png\n/.aistudio/artifacts/brain/6ef9b674-1cbd-4c50-9b2a-bf22bad71f40/.tempmediaStorage/media_1792863102717_5acdc7bf.png\n/.env.example\n/.gitignore\n/bun.lock\n/index.html\n/metadata.json\n/package.json\n/public/assets/aistudio/WhatsApp_Image_2026-10-25_at_09.55.21_cc97f413.jpeg\n/public/images/chapter-1-experience.jpg\n/public/images/chapter-2-tailored.jpg\n/public/images/chapter-3-professionals.jpg\n/public/images/chapter-4-rituals.jpg\n/public/images/footer-macro.jpg\n/public/images/hero-portrait.jpg\n/public/images/intro-profile.jpg\n/public/images/philosophy-space.jpg\n/public/images/service-consultation.jpg\n/public/images/service-facial.jpg\n/public/images/service-makeup.jpg\n/public/images/service-nails.jpg\n/public/images/spread-left-lips.jpg\n/public/images/spread-right-texture.jpg\n/public/images/team-1.jpg\n/public/images/team-2.jpg\n/public/images/team-3.jpg\n/public/videos/approach-1.mp4\n/public/videos/approach-2.mp4\n/public/videos/approach-3.mp4\n/public/videos/approach-4.mp4\n/public/videos/hero.mp4\n/src/App.tsx\n/src/components/AboutSection.tsx\n/src/components/BookingDrawer.tsx\n/src/components/Footer.tsx\n/src/components/Header.tsx\n/src/components/InteractiveChapters.tsx\n/src/components/MediaSlot.tsx\n/src/components/RollingMarble.tsx\n/src/components/TreatmentsSection.tsx\n/src/components/WordReveal.tsx\n/src/data/salonData.ts\n/src/index.css\n/src/main.tsx\n/src/utils/bookingLogic.test.ts\n/src/utils/bookingLogic.ts\n/tsconfig.json\n/vite.config.ts\n\nThe following dependencies are installed:\n@google/genai: ^2.4.0\n@tailwindcss/vite: ^4.3.3\n@vitejs/plugin-react: ^6.1.1\ndotenv: ^17.2.3\nexpress: ^4.21.2\nlucide-react: ^0.546.0\nmotion: ^12.23.24\nreact: ^19.0.1\nreact-dom: ^19.0.1\nvite: ^8.3.0\n\nThe following devDependencies are installed:\n@types/express: ^4.17.21\n@types/node: ^22.14.0\n@types/react: ^19.3.0\n@types/react-dom: ^19.3.0\nautoprefixer: ^10.4.21\nesbuild: ^0.25.0\ntailwindcss: ^4.3.3\ntsx: ^4.21.0\ntypescript: ^7.0.2\n\nKey file contents:\n\n--- /.env.example ---\n```\n# GEMINI_API_KEY: Required for Gemini AI API calls.\n# AI Studio automatically injects this at runtime from user secrets.\n# Users configure this via the Secrets panel in the AI Studio UI.\nGEMINI_API_KEY=\"MY_GEMINI_API_KEY\"\n\n# APP_URL: The URL where this applet is hosted.\n# AI Studio automatically injects this at runtime with the Cloud Run service URL.\n# Used for self-referential links, OAuth callbacks, and API endpoints.\nAPP_URL=\"MY_APP_URL\"\n\n```\n\n--- /index.html ---\n```html\n<!doctype html>\n<html lang=\"en\" class=\"scroll-smooth\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Hershita \342\200\224 Maison Aura Beauty &amp; Skin Sanctuary</title>\n    <meta name=\"description\" content=\"An immersive quiet-luxury beauty salon and skin sanctuary by Hershita, offering bespoke facials, natural nail artistry, bridal and editorial makeup, and personalized skincare consultations.\" />\n    <meta property=\"og:title\" content=\"Hershita \342\200\224 Maison Aura Beauty &amp; Skin Sanctuary\" />\n    <meta property=\"og:description\" content=\"Thoughtful rituals. Exceptional care. A more personal approach to beauty.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=JetBrains+Mono:wght@400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap\" rel=\"stylesheet\" />\n  </head>\n  <body class=\"bg-[#FBF9F5] text-[#18224B] antialiased selection:bg-[#18224B] selection:text-[#FBF9F5] overflow-x-hidden\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"Remix Maison Aura \342\200\224 Bespoke Beauty \\u0026 Skin Sanctuary\",\n  \"description\": \"An immersive quiet-luxury beauty salon and skin sanctuary offering bespoke facials, natural nail artistry, bridal and editorial makeup, and personalized skincare consultations.\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /src/App.tsx ---\n```typescript\n/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useEffect, useState } from \'react\';\nimport { SALON_CONFIG } from \'./data/salonData\';\nimport { ActivePage, Header } from \'./components/Header\';\nimport { MediaSlot } from \'./components/MediaSlot\';\nimport { InteractiveChapters } from \'./components/InteractiveChapters\';\nimport { TreatmentsSection } from \'./components/TreatmentsSection\';\nimport { AboutSection } from \'./components/AboutSection\';\nimport { BookingDrawer } from \'./components/BookingDrawer\';\nimport { Footer } from \'./components/Footer\';\nimport { ConfirmedDemoBooking } from \'./utils/bookingLogic\';\n\nexport default function App() {\n  const [openingStage, setOpeningStage] = useState<\'curtain\' | \'revealing\' | \'complete\'>(() => {\n    if (typeof window !== \'undefined\') {\n      const params = new URLSearchParams(window.location.search);\n      if (params.get(\'autostart\') === \'1\') return \'complete\';\n    }\n    return \'curtain\';\n  });\n\n  const [activePage, setActivePage] = useState<ActivePage>(\'home\');\n  const [bookingOpen, setBookingOpen] = useState(false);\n  const [bookingPreset, setBookingPreset] = useState<{\n    categoryId?: string;\n    ritualId?: string;\n  }>({});\n  const [savedBookings, setSavedBookings] = useState<ConfirmedDemoBooking[]>([]);\n\n  useEffect(() => {\n    if (openingStage === \'complete\') return;\n    const t1 = window.setTimeout(() => {\n      setOpeningStage(\'revealing\');\n    }, 450);\n    const t2 = window.setTimeout(() => {\n      setOpeningStage(\'complete\');\n    }, 1500);\n    return () => {\n      window.clearTimeout(t1);\n      window.clearTimeout(t2);\n    };\n  }, [openingStage]);\n\n  const handleReplayOpening = () => {\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n    setOpeningStage(\'curtain\');\n  };\n\n  const handleNavigatePage = (page: ActivePage, sectionId?: string) => {\n    setActivePage(page);\n    window.requestAnimationFrame(() => {\n      if (sectionId) {\n        const el = document.getElementById(sectionId);\n        if (el) {\n          el.scrollIntoView({ behavior: \'smooth\' });\n          return;\n        }\n      }\n      window.scrollTo({ top: 0, behavior: \'smooth\' });\n    });\n  };\n\n  const handleOpenBooking = (categoryId?: string, ritualId?: string) => {\n    setBookingPreset({ categoryId, ritualId });\n    setBookingOpen(true);\n  };\n\n  const handleBookingConfirmed = (record: ConfirmedDemoBooking) => {\n    setSavedBookings((prev) => [record, ...prev]);\n  };\n\n  const { brand, mediaSlots, introduction } = SALON_CONFIG;\n\n  return (\n    <div\n      id=\"top\"\n      data-view={activePage}\n      className=\"min-h-screen bg-[#FBF9F5] text-[#18224B] flex flex-col justify-between selection:bg-[#18224B] selection:text-[#FBF9F5]\"\n    >\n      {/* 1. CINEMATIC OPENING CURTAIN REVEAL LAYER */}\n      <div\n        aria-hidden=\"true\"\n        className={`pointer-events-none fixed inset-0 z-50 flex flex-col justify-between overflow-hidden transition-opacity duration-700 ${\n          openingStage === \'complete\' ? \'opacity-0\' : \'opacity-100\'\n        }`}\n      >\n        <div\n          className={`w-full flex-1 bg-[#7D7278] border-b border-[#FBF9F5]/25 transition-transform duration-1000 ease-[cubic-bezier(0.22,1,0.36,1)] ${\n            openingStage === \'curtain\' ? \'translate-y-0\' : \'-translate-y-full\'\n          }`}\n        />\n        <div\n          className={`w-full flex-1 bg-[#7D7278] transition-transform duration-1000 ease-[cubic-bezier(0.22,1,0.36,1)] ${\n            openingStage === \'curtain\' ? \'translate-y-0\' : \'translate-y-full\'\n          }`}\n        />\n      </div>\n\n      {/* 2. COMPACT STICKY HEADER & MENU OVERLAY */}\n      <Header\n        activePage={activePage}\n        onNavigatePage={handleNavigatePage}\n        onOpenBooking={handleOpenBooking}\n        bookingCount={savedBookings.length}\n      />\n\n      {/* MAIN VIEW SWITCHER */}\n      <main className=\"flex-1\">\n        {activePage === \'treatments\' && (\n          <TreatmentsSection\n            isFullPage={true}\n            onOpenBooking={handleOpenBooking}\n          />\n        )}\n\n        {activePage === \'about\' && (\n          <AboutSection\n            isFullPage={true}\n            onOpenBooking={() => handleOpenBooking()}\n          />\n        )}\n\n        {activePage === \'home\' && (\n          <article>\n            {/* 3. TWO-STAGE OPENING HERO FILM SEQUENCE (Preserving the exact opening video section the user loved) */}\n            <section\n              aria-label=\"Opening Hero\"\n              className=\"relative w-full bg-[#121620] text-[#FBF9F5]\"\n            >\n              {/* Sticky 50vh Continuous Horizon Header Line Across the Opening Composition */}\n              <div className=\"pointer-events-none absolute inset-0 z-20\">\n                <div className=\"pointer-events-auto sticky top-[46vh] md:top-[48vh] w-full px-5 sm:px-6 md:px-10\">\n                  <div className=\"mx-auto max-w-[1440px] flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-6 border-b border-[#FBF9F5]/30 pb-4 pt-2 drop-shadow-[0_2px_10px_rgba(0,0,0,0.45)]\">\n                    <div className=\"flex items-center justify-between w-full sm:w-auto gap-3\">\n                      <a\n                        href=\"#top\"\n                        onClick={(e) => {\n                          e.preventDefault();\n                          handleNavigatePage(\'home\');\n                        }}\n                        className=\"font-serif-editorial text-2xl sm:text-3xl md:text-[2.1rem] tracking-[0.16em] text-[#FBF9F5] whitespace-nowrap shrink-0\"\n                      >\n                        {brand.name}\n                      </a>\n\n                      <button\n                        type=\"button\"\n                        onClick={() => handleOpenBooking()}\n                        className=\"sm:hidden cursor-pointer px-3 py-1.5 text-[10px] uppercase tracking-[0.12em] bg-[#FBF9F5] text-[#18224B] transition-colors whitespace-nowrap shrink-0\"\n                      >\n                        Book Consultation\n                      </button>\n                    </div>\n\n                    {/* Middle: Serif Tagline along the continuous horizon (just like Odyss\303\251e) */}\n                    <p className=\"hidden xl:block font-serif-editorial text-lg tracking-wide text-[#FBF9F5]/95 whitespace-nowrap\">\n                      {brand.shortTagline}\n                    </p>\n\n                    {/* Right: Navigation Actions */}\n                    <nav\n                      aria-label=\"Opening Horizon Navigation\"\n                      className=\"flex flex-wrap items-center gap-6 md:gap-10 text-[11px] uppercase tracking-[0.14em]\"\n                    >\n                      <button\n                        type=\"button\"\n                        onClick={() => handleNavigatePage(\'treatments\')}\n                        className=\"cursor-pointer py-1 text-[#FBF9F5]/95 hover:opacity-70 transition-opacity whitespace-nowrap shrink-0\"\n                      >\n                        Treatments\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleNavigatePage(\'home\', \'our-approach\')}\n                        className=\"cursor-pointer py-1 text-[#FBF9F5]/95 hover:opacity-70 transition-opacity whitespace-nowrap shrink-0\"\n                      >\n                        Concerns\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleNavigatePage(\'about\')}\n                        className=\"cursor-pointer py-1 text-[#FBF9F5]/95 hover:opacity-70 transition-opacity whitespace-nowrap shrink-0\"\n                      >\n                        About\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleOpenBooking()}\n                        className=\"hidden sm:inline-block cursor-pointer py-1 text-[#FBF9F5] hover:opacity-70 transition-opacity whitespace-nowrap shrink-0\"\n                      >\n                        Book Consultation\n                      </button>\n                    </nav>\n                  </div>\n                </div>\n              </div>\n... (truncated)\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --bg-ivory: #F6F3EE;\n    --bg-warm-stone: #EDE8E0;\n    --bg-mauve-grey: #8B8086;\n    --bg-mauve-deep: #5E555A;\n    --ink-navy: #121620;\n    --ink-muted: #5A585D;\n    --accent-champagne: #C5B393;\n    --hairline-light: rgba(246, 243, 238, 0.22);\n    --hairline-dark: rgba(18, 22, 32, 0.12);\n  }\n\n  body {\n    font-family: \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, sans-serif;\n    background-color: var(--bg-ivory);\n    color: var(--ink-navy);\n    overflow-x: hidden;\n  }\n\n  h1, h2, h3, .font-serif-editorial {\n    font-family: \'Cormorant Garamond\', Georgia, serif;\n  }\n\n  .font-mono-tabular {\n    font-family: \'JetBrains Mono\', monospace;\n    font-variant-numeric: tabular-nums;\n  }\n}\n\n@keyframes slowKenBurns {\n  0% {\n    transform: scale(1.0) translate3d(0, 0, 0);\n  }\n  50% {\n    transform: scale(1.045) translate3d(-0.8%, -0.5%, 0);\n  }\n  100% {\n    transform: scale(1.0) translate3d(0, 0, 0);\n  }\n}\n\n@keyframes subtleFloat {\n  0%, 100% {\n    transform: translateY(0px);\n  }\n  50% {\n    transform: translateY(-4px);\n  }\n}\n\n.animate-editorial-film {\n  animation: slowKenBurns 26s cubic-bezier(0.25, 1, 0.5, 1) infinite;\n  will-change: transform;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .animate-editorial-film {\n    animation: none !important;\n    transform: none !important;\n  }\n  *, ::before, ::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n```\n\n--- /src/main.tsx ---\n```typescript\nimport {createRoot} from \'react-dom/client\';\nimport App from \'./App.tsx\';\nimport \'./index.css\';\n\ncreateRoot(document.getElementById(\'root\')!).render(<App />);\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"types\": [\"vite/client\"],\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  },\n  \"exclude\": [\"dist\"]\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport path from \'path\';\nimport {defineConfig} from \'vite\';\n\nexport default defineConfig(() => {\n  return {\n    plugins: [react(), tailwindcss()],\n    resolve: {\n      alias: {\n        \'@\': path.resolve(__dirname, \'.\'),\n      },\n    },\n    server: {\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // Do not modify\342\200\224file watching is disabled to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.\n      watch: process.env.DISABLE_HMR === \'true\' ? null : {},\n    },\n  };\n});\n\n```"
    }
  }
