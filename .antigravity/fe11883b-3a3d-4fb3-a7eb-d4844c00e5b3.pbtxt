  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    end_line: 560
    content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useEffect, useState } from \'react\';\nimport { SALON_CONFIG } from \'./data/salonData\';\nimport { ActivePage, Header } from \'./components/Header\';\nimport { MediaSlot } from \'./components/MediaSlot\';\nimport { InteractiveChapters } from \'./components/InteractiveChapters\';\nimport { TreatmentsSection } from \'./components/TreatmentsSection\';\nimport { AboutSection } from \'./components/AboutSection\';\nimport { BookingDrawer } from \'./components/BookingDrawer\';\nimport { Footer } from \'./components/Footer\';\nimport { ConfirmedDemoBooking } from \'./utils/bookingLogic\';\n\nexport default function App() {\n  const [openingStage, setOpeningStage] = useState<\'curtain\' | \'revealing\' | \'complete\'>(() => {\n    if (typeof window !== \'undefined\') {\n      const params = new URLSearchParams(window.location.search);\n      if (params.get(\'autostart\') === \'1\') return \'complete\';\n    }\n    return \'curtain\';\n  });\n\n  const [activePage, setActivePage] = useState<ActivePage>(\'home\');\n  const [bookingOpen, setBookingOpen] = useState(false);\n  const [bookingPreset, setBookingPreset] = useState<{\n    categoryId?: string;\n    ritualId?: string;\n  }>({});\n  const [savedBookings, setSavedBookings] = useState<ConfirmedDemoBooking[]>([]);\n\n  useEffect(() => {\n    if (openingStage === \'complete\') return;\n    const t1 = window.setTimeout(() => {\n      setOpeningStage(\'revealing\');\n    }, 450);\n    const t2 = window.setTimeout(() => {\n      setOpeningStage(\'complete\');\n    }, 1500);\n    return () => {\n      window.clearTimeout(t1);\n      window.clearTimeout(t2);\n    };\n  }, [openingStage]);\n\n  const handleReplayOpening = () => {\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n    setOpeningStage(\'curtain\');\n  };\n\n  const handleNavigatePage = (page: ActivePage, sectionId?: string) => {\n    setActivePage(page);\n    window.requestAnimationFrame(() => {\n      if (sectionId) {\n        const el = document.getElementById(sectionId);\n        if (el) {\n          el.scrollIntoView({ behavior: \'smooth\' });\n          return;\n        }\n      }\n      window.scrollTo({ top: 0, behavior: \'smooth\' });\n    });\n  };\n\n  const handleOpenBooking = (categoryId?: string, ritualId?: string) => {\n    setBookingPreset({ categoryId, ritualId });\n    setBookingOpen(true);\n  };\n\n  const handleBookingConfirmed = (record: ConfirmedDemoBooking) => {\n    setSavedBookings((prev) => [record, ...prev]);\n  };\n\n  const { brand, mediaSlots, introduction } = SALON_CONFIG;\n\n  return (\n    <div\n      id=\"top\"\n      data-view={activePage}\n      className=\"min-h-screen bg-[#FBF9F5] text-[#18224B] flex flex-col justify-between selection:bg-[#18224B] selection:text-[#FBF9F5]\"\n    >\n      {/* 1. CINEMATIC OPENING CURTAIN REVEAL LAYER */}\n      <div\n        aria-hidden=\"true\"\n        className={`pointer-events-none fixed inset-0 z-50 flex flex-col justify-between overflow-hidden transition-opacity duration-700 ${\n          openingStage === \'complete\' ? \'opacity-0\' : \'opacity-100\'\n        }`}\n      >\n        <div\n          className={`w-full flex-1 bg-[#7D7278] border-b border-[#FBF9F5]/25 transition-transform duration-1000 ease-[cubic-bezier(0.22,1,0.36,1)] ${\n            openingStage === \'curtain\' ? \'translate-y-0\' : \'-translate-y-full\'\n          }`}\n        />\n        <div\n          className={`w-full flex-1 bg-[#7D7278] transition-transform duration-1000 ease-[cubic-bezier(0.22,1,0.36,1)] ${\n            openingStage === \'curtain\' ? \'translate-y-0\' : \'translate-y-full\'\n          }`}\n        />\n      </div>\n\n      {/* 2. COMPACT STICKY HEADER & MENU OVERLAY */}\n      <Header\n        activePage={activePage}\n        onNavigatePage={handleNavigatePage}\n        onOpenBooking={handleOpenBooking}\n        bookingCount={savedBookings.length}\n      />\n\n      {/* MAIN VIEW SWITCHER */}\n      <main className=\"flex-1\">\n        {activePage === \'treatments\' && (\n          <TreatmentsSection\n            isFullPage={true}\n            onOpenBooking={handleOpenBooking}\n          />\n        )}\n\n        {activePage === \'about\' && (\n          <AboutSection\n            isFullPage={true}\n            onOpenBooking={() => handleOpenBooking()}\n          />\n        )}\n\n        {activePage === \'home\' && (\n          <article>\n            {/* 3. TWO-STAGE OPENING HERO FILM SEQUENCE (Preserving the exact opening video section the user loved) */}\n            <section\n              aria-label=\"Opening Hero\"\n              className=\"relative w-full bg-[#121620] text-[#FBF9F5]\"\n            >\n              {/* Sticky 50vh Continuous Horizon Header Line Across the Opening Composition */}\n              <div className=\"pointer-events-none absolute inset-0 z-20\">\n                <div className=\"pointer-events-auto sticky top-[46vh] md:top-[48vh] w-full px-5 sm:px-6 md:px-10\">\n                  <div className=\"mx-auto max-w-[1440px] flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-6 border-b border-[#FBF9F5]/30 pb-4 pt-2 drop-shadow-[0_2px_10px_rgba(0,0,0,0.45)]\">\n                    <div className=\"flex items-center justify-between w-full sm:w-auto gap-3\">\n                      <a\n                        href=\"#top\"\n                        onClick={(e) => {\n                          e.preventDefault();\n                          handleNavigatePage(\'home\');\n                        }}\n                        className=\"font-serif-editorial text-2xl sm:text-3xl md:text-[2.1rem] tracking-[0.16em] text-[#FBF9F5] whitespace-nowrap shrink-0\"\n                      >\n                        {brand.name}\n                      </a>\n\n                      <button\n                        type=\"button\"\n                        onClick={() => handleOpenBooking()}\n                        className=\"sm:hidden cursor-pointer px-3 py-1.5 text-[10px] uppercase tracking-[0.12em] bg-[#FBF9F5] text-[#18224B] transition-colors whitespace-nowrap shrink-0\"\n                      >\n                        Book Consultation\n                      </button>\n                    </div>\n\n                    {/* Middle: Serif Tagline along the continuous horizon (just like Odyss\303\251e) */}\n                    <p className=\"hidden xl:block font-serif-editorial text-lg tracking-wide text-[#FBF9F5]/95 whitespace-nowrap\">\n                      {brand.shortTagline}\n                    </p>\n\n                    {/* Right: Navigation Actions */}\n                    <nav\n                      aria-label=\"Opening Horizon Navigation\"\n                      className=\"flex flex-wrap items-center gap-6 md:gap-10 text-[11px] uppercase tracking-[0.14em]\"\n                    >\n                      <button\n                        type=\"button\"\n                        onClick={() => handleNavigatePage(\'treatments\')}\n                        className=\"cursor-pointer py-1 text-[#FBF9F5]/95 hover:opacity-70 transition-opacity whitespace-nowrap shrink-0\"\n                      >\n                        Treatments\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleNavigatePage(\'home\', \'our-approach\')}\n                        className=\"cursor-pointer py-1 text-[#FBF9F5]/95 hover:opacity-70 transition-opacity whitespace-nowrap shrink-0\"\n                      >\n                        Concerns\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleNavigatePage(\'about\')}\n                        className=\"cursor-pointer py-1 text-[#FBF9F5]/95 hover:opacity-70 transition-opacity whitespace-nowrap shrink-0\"\n                      >\n                        About\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleOpenBooking()}\n                        className=\"hidden sm:inline-block cursor-pointer py-1 text-[#FBF9F5] hover:opacity-70 transition-opacity whitespace-nowrap shrink-0\"\n                      >\n                        Book Consultation\n                      </button>\n                    </nav>\n                  </div>\n                </div>\n              </div>\n\n              {/* STAGE A: Full-Viewport Opening Beauty Film Video (/videos/hero.mp4) */}\n              <div className=\"relative h-screen w-full overflow-hidden\">\n                <div\n                  className={`h-full w-full transition-transform duration-[1400ms] ease-[cubic-bezier(0.16,1,0.3,1)] ${\n                    openingStage === \'curtain\' ? \'scale-110\' : \'scale-100\'\n                  }`}\n                >\n                  <MediaSlot\n                    media={mediaSlots.hero}\n                    priority={true}\n                    subtleMotion={false}\n                    className=\"h-full w-full\"\n                    overlayClassName=\"bg-gradient-to-b from-[#121620]/30 via-[#121620]/15 to-[#121620]/65\"\n                  />\n                </div>\n\n                <div className=\"absolute bottom-8 left-6 right-6 md:left-10 md:right-10 z-30 flex items-center justify-between text-[11px] uppercase tracking-[0.18em] text-[#FBF9F5]/80\">\n                  <button\n                    type=\"button\"\n                    onClick={handleReplayOpening}\n                    className=\"cursor-pointer hover:text-[#FBF9F5] transition-colors whitespace-nowrap shrink-0\"\n                  >\n                    Reel 01 \342\200\224 Opening Ritual Film (Replay)\n                  </button>\n                  <span className=\"hidden sm:inline font-mono-tabular\">\n                    Scroll to enter \342\206\223\n                  </span>\n                </div>\n              </div>\n\n              {/* STAGE B: Second Full-Bleed Close-Up Portrait & Principal Headline Composition */}\n              <div className=\"relative min-h-[92vh] w-full flex flex-col justify-end overflow-hidden\">\n                <div className=\"absolute inset-0 z-0\">\n                  <img\n                    src=\"/images/spread-left-lips.jpg\"\n                    alt=\"Close-up editorial beauty portrait showing luminous natural skin texture\"\n                    className=\"h-full w-full object-cover animate-editorial-film\"\n                    style={{ objectPosition: \'center 32%\' }}\n                  />\n                  <div\n                    className=\"pointer-events-none absolute inset-0 bg-gradient-to-b from-[#121620]/40 via-[#121620]/25 to-[#121620]/80\"\n                    aria-hidden=\"true\"\n                  />\n                </div>\n\n                <div className=\"relative z-30 w-full px-6 md:px-10 pb-16 md:pb-24 pt-32\">\n                  <div className=\"mx-auto max-w-[1440px] grid grid-cols-1 lg:grid-cols-12 gap-8 items-end\">\n                    <div className=\"lg:col-span-8 space-y-5\">\n                      <h1 className=\"font-serif-editorial text-5xl sm:text-7xl lg:text-[5.5rem] font-light leading-[1.02] tracking-tight text-[#FBF9F5] [text-wrap:balance]\">\n                        {brand.heroHeadline}\n                      </h1>\n                      <p className=\"text-base md:text-lg text-[#FBF9F5]/90 max-w-xl font-light leading-relaxed\">\n                        {brand.heroSubhead}\n                      </p>\n                    </div>\n\n                    <div className=\"lg:col-span-4 flex flex-col sm:flex-row lg:flex-col items-stretch sm:items-center lg:items-end justify-end gap-3\">\n                      <button\n                        type=\"button\"\n                        onClick={() => handleOpenBooking()}\n                        className=\"cursor-pointer px-7 py-4 text-xs uppercase tracking-[0.18em] bg-[#FBF9F5] text-[#18224B] hover:bg-[#E8E2D5] transition-colors text-center whitespace-nowrap shrink-0\"\n                      >\n                        {brand.primaryCta}\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleNavigatePage(\'home\', \'our-approach\')}\n                        className=\"cursor-pointer px-7 py-3.5 text-xs uppercase tracking-[0.18em] border border-[#FBF9F5]/50 text-[#FBF9F5] hover:border-[#FBF9F5] hover:bg-[#FBF9F5]/10 transition-colors text-center whitespace-nowrap shrink-0\"\n                      >\n                        {brand.secondaryCta}\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </section>\n\n            {/* 4. ODYSS\303\211E-STYLE ASYMMETRICAL INTRODUCTION (Matching `odyssee-intro.png`)\n                Left col-span-2 portrait + Right col-start-4 indented midnight-navy serif statement */}\n            <section\n              id=\"introduction\"\n              aria-label=\"Sanctuary Introduction\"\n              className=\"pt-14 pb-28 md:pt-20 md:pb-44 px-5 md:px-8 bg-[#FBF9F5] text-[#18224B]\"\n            >\n              <div className=\"mx-auto max-w-[1440px] grid grid-cols-1 md:grid-cols-12 gap-8 items-start\">\n                {/* Left Vertical Portrait (col-span-2) */}\n                <div className=\"md:col-span-3 lg:col-span-2\">\n                  <div className=\"aspect-[2/3] w-full overflow-hidden bg-[#E6E2DA]\">\n                    <MediaSlot\n                      media={mediaSlots.introduction}\n                      subtleMotion={true}\n                      className=\"h-full w-full\"\n                    />\n                  </div>\n                </div>\n\n                {/* Right Indented Serif Headline & Concise Call to Action (col-start-4 col-span-9) */}\n                <div className=\"md:col-span-9 lg:col-start-4 lg:col-span-9 flex flex-col justify-between space-y-12 md:space-y-16\">\n                  <h2 className=\"font-serif-editorial text-3xl sm:text-5xl lg:text-[3.65rem] font-normal leading-[1.08] tracking-[-0.01em] text-[#18224B] md:indent-[7rem] lg:indent-[11rem]\">\n                    {introduction.headline}\n                  </h2>\n\n                  <div className=\"max-w-sm space-y-6\">\n                    <p className=\"text-[14px] leading-[1.6] text-[#18224B]/90\">\n                      {introduction.body}\n                    </p>\n                    <div>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleOpenBooking()}\n                        className=\"cursor-pointer text-[11px] uppercase tracking-[0.14em] text-[#18224B] hover:opacity-60 transition-opacity whitespace-nowrap shrink-0\"\n                      >\n                        {introduction.ctaLabel}\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </section>\n\n            {/* 5. WHY HERSHITA? \342\200\224 FOUR-COLUMN EDGE-TO-EDGE HORIZONTAL VIDEO STRIP (Matching `odyssee-sec1.png`) */}\n            <InteractiveChapters onOpenBooking={() => handleOpenBooking()} />\n\n            {/* 6. FULL-BLEED DUAL DUOTONE PORTALS: CONCERNS & TREATMENTS (Matching `odyssee-concerns.png`) */}\n            <section\n              aria-label=\"Concerns and Treatments Portals\"\n              className=\"px-5 md:px-8 pb-24 md:pb-36 bg-[#FBF9F5]\"\n            >\n              <div className=\"mx-auto max-w-[1440px] grid grid-cols-1 md:grid-cols-2 gap-0\">\n                {/* Left Portal: SKIN CONCERNS */}\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    const el = document.getElementById(\'treatments-section\');\n                    el?.scrollIntoView({ behavior: \'smooth\' });\n                  }}\n                  className=\"group cursor-pointer relative aspect-[4/4.3] w-full overflow-hidden bg-[#737B92] text-center focus-visible:outline-2 focus-visible:outline-[#18224B]\"\n                >\n                  <img\n                    src=\"/images/chapter-2-tailored.jpg\"\n                    alt=\"Skin concerns and bespoke consultations\"\n                    className=\"h-full w-full object-cover grayscale contrast-90 mix-blend-luminosity opacity-55 group-hover:mix-blend-normal group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700\"\n                  />\n                  <div className=\"pointer-events-none absolute inset-0 bg-[#5C6684]/45 group-hover:opacity-15 transition-opacity duration-700\" />\n                  <div className=\"absolute inset-0 flex items-center justify-center\">\n                    <span className=\"text-[11px] uppercase tracking-[0.16em] text-[#FBF9F5] drop-shadow\">\n                      Concerns\n                    </span>\n                  </div>\n                </button>\n\n                {/* Right Portal: TREATMENTS */}\n                <button\n                  type=\"button\"\n                  onClick={() => handleNavigatePage(\'treatments\')}\n                  className=\"group cursor-pointer relative aspect-[4/4.3] w-full overflow-hidden bg-[#515B75] text-center focus-visible:outline-2 focus-visible:outline-[#18224B]\"\n                >\n                  <img\n                    src=\"/images/service-makeup.jpg\"\n                    alt=\"Treatments and aesthetic artistry\"\n                    className=\"h-full w-full object-cover grayscale contrast-105 mix-blend-luminosity opacity-75 group-hover:mix-blend-normal group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700\"\n                  />\n                  <div className=\"pointer-events-none absolute inset-0 bg-[#3B4666]/45 group-hover:opacity-15 transition-opacity duration-700\" />\n                  <div className=\"absolute inset-0 flex items-center justify-center\">\n                    <span className=\"text-[11px] uppercase tracking-[0.16em] text-[#FBF9F5] drop-shadow\">\n                      Treatments\n                    </span>\n                  </div>\n                </button>\n              </div>\n            </section>\n\n            {/* 7. OUR PHILOSOPHY + ASYMMETRICAL DUAL-VIDEO MACRO SECTION (Matching `odyssee-sec2.png`) */}\n            <section\n              aria-label=\"Our Philosophy and Method\"\n              className=\"bg-[#FBF9F5] text-[#18224B] pt-4 pb-24 md:pb-36\"\n            >\n              {/* Part A: Offset Philosophy Statement */}\n              <div className=\"mx-auto max-w-[1440px] px-5 md:px-8 pb-24 md:pb-36 grid grid-cols-1 md:grid-cols-12 gap-8 items-start\">\n                <div className=\"md:col-span-3\">\n                  <span className=\"text-[11px] uppercase tracking-[0.14em] text-[#18224B]\">\n                    Our Philosophy\n                  </span>\n                </div>\n                <div className=\"md:col-span-9 lg:col-start-4 lg:col-span-8 space-y-10\">\n                  <h3 className=\"font-serif-editorial text-2xl sm:text-4xl lg:text-[2.65rem] font-normal leading-[1.18] text-[#18224B]\">\n                    Every treatment at Hershita is grounded in evidence-based skincare and the quiet art of aesthetic refinement. Our specialists combine anatomical precision with restorative techniques to achieve results that are both gentle and enduring.\n                  </h3>\n                  <div>\n                    <button\n                      type=\"button\"\n                      onClick={() => handleNavigatePage(\'treatments\')}\n                      className=\"cursor-pointer text-[11px] uppercase tracking-[0.14em] text-[#18224B] hover:opacity-60 transition-opacity\"\n                    >\n                      Explore treatments\n                    </button>\n                  </div>\n                </div>\n              </div>\n\n              {/* Part B: Odyss\303\251e Asymmetrical Dual-Video & Giant Macro Lips/Skin Composition (`odyssee-sec2.png`) */}\n              <div className=\"mx-auto max-w-[1440px] grid grid-cols-1 lg:grid-cols-12 gap-0 items-center\">\n                {/* Left-Center Small Macro Video + Caption Underneath (col-start-5 col-span-2) */}\n                <div className=\"px-5 md:px-0 lg:col-start-5 lg:col-span-2 py-12 lg:py-0\">\n                  <div className=\"aspect-[4/5] w-full overflow-hidden bg-[#D5D7DB]\">\n                    <MediaSlot\n                      media={mediaSlots.spreadLeft}\n                      priority={true}\n                      subtleMotion={false}\n                      className=\"h-full w-full grayscale contrast-105\"\n                    />\n                  </div>\n                  <p className=\"mt-4 pr-4 text-[13px] leading-[1.55] text-[#18224B]\">\n                    Behind every treatment lies a commitment to science, research and refinement, ensuring results that are safe, precise and enduring.\n                  </p>\n                </div>\n\n                {/* Right Giant Edge-to-Edge Macro Skin & Lips Video/Portrait (col-start-7 col-span-6) */}\n                <div className=\"lg:col-start-7 lg:col-span-6 aspect-[4/5] lg:aspect-auto lg:h-[105vh] w-full overflow-hidden bg-[#E5DDD5]\">\n                  <MediaSlot\n                    media={{\n                      id: \'macro-lips-right\',\n                      videoPath: \'/videos/approach-3.mp4\',\n                      enableVideo: true,\n                      posterPath: \'/images/spread-left-lips.jpg\',\n                      alt: \'Extreme macro close-up of luminous skin texture and lips\',\n                      focalPoint: \'center center\',\n                    }}\n                    priority={true}\n                    subtleMotion={true}\n                    className=\"h-full w-full\"\n                  />\n                </div>\n              </div>\n            </section>\n\n            {/* 8. FULL-VIEWPORT LAYERED SPREAD: \"PERSONAL \302\267 PRECISE \302\267 BEAUTIFUL\" (Matching `odyssee-sec3.png`) */}\n            <section\n              aria-label=\"Editorial Visual Spread\"\n              className=\"relative min-h-[92vh] w-full overflow-hidden bg-[#EAE6DF] flex items-center\"\n            >\n              {/* Soft-focus ghostly macro eye/skin texture on left blending into warm portrait on right */}\n              <div className=\"absolute inset-0 grid grid-cols-1 md:grid-cols-12\">\n                <div className=\"hidden md:block md:col-span-6 relative overflow-hidden\">\n                  <img\n                    src=\"/images/spread-left-lips.jpg\"\n                    alt=\"Soft focus beauty texture\"\n                    className=\"h-full w-full object-cover scale-125 opacity-25 grayscale\"\n                  />\n                  <div className=\"absolute inset-0 bg-gradient-to-r from-[#FBF9F5]/40 via-transparent to-[#C8B9A6]/50\" />\n                </div>\n                <div className=\"col-span-1 md:col-span-6 relative overflow-hidden\">\n                  <img\n                    src=\"/images/intro-profile.jpg\"\n                    alt=\"Serene beauty portrait\"\n                    className=\"h-full w-full object-cover\"\n                  />\n                  <div className=\"absolute inset-0 bg-gradient-to-r from-[#EAE6DF] via-transparent to-transparent md:w-1/3\" />\n                </div>\n              </div>\n\n              {/* Three-Part Horizon Typographic Statement Across the Exact Center (Matching `odyssee-sec3.png`) */}\n              <div className=\"relative z-10 w-full px-6 md:px-10\">\n                <h2 className=\"mx-auto max-w-[1440px] flex items-center justify-between text-[11px] md:text-xs font-normal uppercase tracking-[0.16em] text-[#18224B] md:text-[#FBF9F5] drop-shadow-[0_1px_8px_rgba(0,0,0,0.45)]\">\n                  <span className=\"text-[#18224B]\">Bespoke</span>\n                  <span className=\"text-[#FBF9F5] drop-shadow\">Personal</span>\n                  <span className=\"text-[#FBF9F5] drop-shadow\">Aesthetic</span>\n                </h2>\n              </div>\n            </section>\n\n            {/* 9. EXPANDABLE TREATMENTS & RITUALS DIRECTORY */}\n            <TreatmentsSection\n              isFullPage={false}\n              onOpenBooking={handleOpenBooking}\n              onExploreFullTreatments={() => handleNavigatePage(\'treatments\')}\n            />\n\n            {/* 10. CLOSING \"OUR APPROACH\" SPLIT + DUOTONE DUO CARDS (Matching `odyssee-approach-cards.png`) */}\n            <section\n              aria-label=\"Explore More\"\n              className=\"py-20 md:py-32 px-5 md:px-8 bg-[#FBF9F5] text-[#18224B]\"\n            >\n              <div className=\"mx-auto max-w-[1440px] grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\">\n                {/* Left Column: Our Approach Copy (col-start-2 col-span-3) */}\n                <div className=\"lg:col-start-2 lg:col-span-3 space-y-5\">\n                  <h2 className=\"text-[11px] uppercase tracking-[0.14em] text-[#18224B]\">\n                    Our approach\n                  </h2>\n                  <p className=\"text-[13px] leading-[1.6] text-[#18224B]/90\">\n                    Every treatment at Hershita is carefully tailored to your lifestyle, your goals, your unique skin type and the time you have to restore.\n                  </p>\n                  <p className=\"text-[13px] leading-[1.6] text-[#18224B]/90\">\n                    Learn about the rituals that define our approach and the specialists who bring it to life.\n                  </p>\n                </div>\n\n                {/* Right Column: Two Edge-to-Edge Duotone Cards (`TREATMENTS` | `ABOUT`) */}\n                <div className=\"lg:col-start-7 lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-0\">\n                  <button\n                    type=\"button\"\n                    onClick={() => handleNavigatePage(\'treatments\')}\n                    className=\"group cursor-pointer relative aspect-[4/5] w-full overflow-hidden bg-[#687189] focus-visible:outline-2 focus-visible:outline-[#18224B]\"\n                  >\n                    <img\n                      src=\"/images/chapter-4-rituals.jpg\"\n                      alt=\"Explore Hershita Treatments\"\n                      className=\"h-full w-full object-cover grayscale mix-blend-luminosity opacity-70 group-hover:mix-blend-normal group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700\"\n                    />\n                    <div className=\"pointer-events-none absolute inset-0 bg-[#545E78]/45 group-hover:opacity-10 transition-opacity duration-700\" />\n                    <div className=\"absolute inset-0 flex items-center justify-center\">\n                      <span className=\"text-[11px] uppercase tracking-[0.16em] text-[#FBF9F5] drop-shadow\">\n                        Treatments\n                      </span>\n                    </div>\n                  </button>\n\n                  <button\n                    type=\"button\"\n                    onClick={() => handleNavigatePage(\'about\')}\n                    className=\"group cursor-pointer relative aspect-[4/5] w-full overflow-hidden bg-[#7B8296] focus-visible:outline-2 focus-visible:outline-[#18224B]\"\n                  >\n                    <img\n                      src=\"/images/chapter-2-tailored.jpg\"\n                      alt=\"Discover Hershita and Our Team\"\n                      className=\"h-full w-full object-cover grayscale mix-blend-luminosity opacity-75 group-hover:mix-blend-normal group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700\"\n                    />\n                    <div className=\"pointer-events-none absolute inset-0 bg-[#6A738C]/35 group-hover:opacity-10 transition-opacity duration-700\" />\n                    <div className=\"absolute inset-0 flex items-center justify-center\">\n                      <span className=\"text-[11px] uppercase tracking-[0.16em] text-[#FBF9F5] drop-shadow\">\n                        About\n                      </span>\n                    </div>\n                  </button>\n                </div>\n              </div>\n            </section>\n          </article>\n        )}\n      </main>\n\n      {/* 11. SIGNATURE FOOTER WITH ROLLING MARBLE ENGRAVED WITH \"HERSHITA\" */}\n      <Footer\n        onOpenBooking={() => handleOpenBooking()}\n        onNavigatePage={handleNavigatePage}\n      />\n\n      {/* INTERACTIVE APPOINTMENT BOOKING DRAWER */}\n      <BookingDrawer\n        isOpen={bookingOpen}\n        initialCategoryId={bookingPreset.categoryId}\n        initialRitualId={bookingPreset.ritualId}\n        onClose={() => setBookingOpen(false)}\n        onBookingConfirmed={handleBookingConfirmed}\n        savedBookings={savedBookings}\n      />\n    </div>\n  );\n}\n"
    num_lines: 561
    num_bytes: 28228
    line_range_bytes: 28228
  }
}
