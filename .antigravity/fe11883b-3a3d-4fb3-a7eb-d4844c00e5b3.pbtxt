    replacement_infos {
      original_chunk {
        target_content: "                <div className=\"md:col-span-9 lg:col-start-7 lg:col-span-6 space-y-9 md:space-y-11\">\n                  <h3 className=\"font-serif-editorial text-[1.75rem] sm:text-[2.1rem] lg:text-[2.35rem] xl:text-[2.48rem] font-light leading-[1.1] tracking-[-0.025em] text-[#18224B] md:indent-[4.75rem] lg:indent-[6.25rem]\">\n                    Every treatment at <span className=\"font-brand tracking-[0.04em]\">NOVA</span> is grounded in evidence-based skincare and the quiet art of aesthetic refinement. Our specialists combine anatomical precision with restorative techniques to achieve results that are both gentle and enduring.\n                  </h3>\n                  <div>\n                    <button\n                      type=\"button\"\n                      onClick={() => handleNavigatePage(\'treatments\')}\n                      className=\"font-basel cursor-pointer text-[11px] font-normal uppercase tracking-[0.05em] text-[#18224B] hover:opacity-60 transition-opacity\"\n                    >\n                      Explore treatments\n                    </button>\n                  </div>\n                </div>\n              </div>\n\n              {/* Part B: Odyss\303\251e Asymmetrical Dual-Video & Giant Macro Lips/Skin Composition (`odyssee-sec2.png`) */}\n              <div className=\"mx-auto max-w-[1440px] grid grid-cols-1 lg:grid-cols-12 gap-0 items-center\">\n                {/* Left-Center Small Macro Video + Caption Underneath (col-start-5 col-span-2) */}\n                <div className=\"px-5 md:px-0 lg:col-start-5 lg:col-span-2 py-12 lg:py-0\">\n                  <div className=\"aspect-[4/5] w-full overflow-hidden bg-[#D5D7DB]\">\n                    <MediaSlot\n                      media={mediaSlots.spreadLeft}\n                      priority={true}\n                      subtleMotion={false}\n                      className=\"h-full w-full grayscale contrast-105\"\n                    />\n                  </div>\n                  <p className=\"font-basel mt-4 pr-4 text-[13px] leading-[1.55] text-[#18224B]\">\n                    Behind every treatment lies a commitment to science, research and refinement, ensuring results that are safe, precise and enduring.\n                  </p>\n                </div>\n\n                {/* Right Giant Edge-to-Edge Macro Skin & Lips Video/Portrait (col-start-7 col-span-6) */}\n                <div className=\"lg:col-start-7 lg:col-span-6 aspect-[4/5] lg:aspect-auto lg:h-[105vh] w-full overflow-hidden bg-[#E5DDD5]\">\n                  <MediaSlot\n                    media={{\n                      id: \'macro-lips-right\',\n                      videoPath: \'/videos/approach-3.mp4\',\n                      enableVideo: true,\n                      posterPath: \'/images/spread-left-lips.jpg\',\n                      alt: \'Extreme macro close-up of luminous skin texture and lips\',\n                      focalPoint: \'center center\',\n                    }}\n                    priority={true}\n                    subtleMotion={true}\n                    className=\"h-full w-full\"\n                  />\n                </div>\n              </div>"
        replacement_content: "                <div className=\"md:col-span-9 lg:col-start-7 lg:col-span-6 space-y-9 md:space-y-11\">\n                  <h3 className=\"font-serif-editorial text-[1.65rem] sm:text-[1.95rem] lg:text-[2.12rem] xl:text-[2.22rem] font-light leading-[1.09] tracking-[-0.025em] text-[#18224B] md:indent-[4.5rem] lg:indent-[5.75rem]\">\n                    Every treatment at <span className=\"font-brand tracking-[0.04em]\">NOVA</span> is grounded in evidence-based skincare and the quiet art of aesthetic refinement. Our specialists combine anatomical precision with restorative techniques to achieve results that are both gentle and enduring.\n                  </h3>\n                  <div>\n                    <button\n                      type=\"button\"\n                      onClick={() => handleNavigatePage(\'treatments\')}\n                      className=\"font-basel cursor-pointer text-[11px] font-normal uppercase tracking-[0.05em] text-[#18224B] hover:opacity-60 transition-opacity\"\n                    >\n                      Explore treatments\n                    </button>\n                  </div>\n                </div>\n              </div>\n\n              {/* Part B: Odyss\303\251e Asymmetrical Dual-Video & Giant Macro Lips/Skin Composition (`image_62f75fc9.png`) */}\n              <div className=\"mx-auto max-w-[1440px] px-4 sm:px-6 md:px-7 grid grid-cols-1 lg:grid-cols-12 gap-0 items-start\">\n                {/* Left-Center Small Macro Video + Caption Underneath (col-start-5 col-span-2) */}\n                <div className=\"lg:col-start-5 lg:col-span-2 pb-12 lg:pb-0\">\n                  <div className=\"aspect-[4/5] w-full overflow-hidden bg-[#D5D7DB]\">\n                    <MediaSlot\n                      media={mediaSlots.spreadLeft}\n                      priority={true}\n                      subtleMotion={false}\n                      className=\"h-full w-full grayscale contrast-105\"\n                    />\n                  </div>\n                  <p className=\"font-basel mt-4 pr-4 text-[13px] leading-[1.55] text-[#18224B]\">\n                    Behind every treatment lies a commitment to science, research and refinement, ensuring results that are safe, precise and enduring.\n                  </p>\n                </div>\n\n                {/* Right Giant Macro Skin & Lips Video/Portrait (col-start-7 col-span-5) */}\n                <div className=\"lg:col-start-7 lg:col-span-5 aspect-[4/5] lg:aspect-[4/4.8] w-full overflow-hidden bg-[#E5DDD5]\">\n                  <MediaSlot\n                    media={{\n                      id: \'macro-lips-right\',\n                      videoPath: \'/videos/approach-3.mp4\',\n                      enableVideo: true,\n                      posterPath: \'/images/spread-left-lips.jpg\',\n                      alt: \'Extreme macro close-up of luminous skin texture and lips\',\n                      focalPoint: \'center center\',\n                    }}\n                    priority={true}\n                    subtleMotion={true}\n                    className=\"h-full w-full\"\n                  />\n                </div>\n              </div>"
        start_line: 299
