            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // 5. True 3D Spherical Projection of the Engraved Wordmark, Kintsugi Veins & Filigree"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.save();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      ctx.translate(cx, cy);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const rows = 96;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const lonOffset = -0.06 + Math.sin(timePhase * 0.75) * 0.08 + mouseNormXRef.current * 0.1;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      for (let i = 0; i < rows; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const ny0 = (i / rows) * 2 - 1;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const ny1 = ((i + 1) / rows) * 2 - 1;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const nyMid = (ny0 + ny1) * 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        // Latitude on the sphere (-PI/2 at top pole, +PI/2 at bottom pole)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const lat = Math.asin(Math.max(-1, Math.min(1, nyMid)));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const cosLat = Math.cos(lat);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        if (cosLat <= 0.06) continue;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        // Map latitude (-PI/2 .. +PI/2) to vertical coordinate in stripCanvas"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const vNorm = (lat / Math.PI) + 0.5; // 0..1"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        // Span 88% of the pole-to-pole arc so top & bottom letters curve right to the edges like ODYSS\303\211E"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const vMapped = (vNorm - 0.5) * 1.06 + 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        if (vMapped < 0.01 || vMapped > 0.99) continue;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const srcY = Math.floor(vMapped * (stripH - 4));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const srcH = Math.max(2, Math.ceil(stripH / rows));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const destY = ny0 * R;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const destH = Math.max(1.5, (ny1 - ny0) * R + 0.85);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        // Horizontal 3D wrap: width compresses toward top/bottom poles and shifts with longitude"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const bandW = R * 0.42 * (0.55 + 0.45 * cosLat);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const shiftX = Math.sin(lonOffset) * R * cosLat;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        // Limb darkening near the very top/bottom poles"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        ctx.globalAlpha = Math.pow(cosLat, 0.55) * 0.95;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // Dynamic sculptural axis tilt that responds gently to cursor Y/X"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.rotate(-0.11 + mx * 0.05);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const cols = 104;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Center u=0.25 (\"NOVA\") at the front of the sphere, rolling smoothly with time, scroll & cursor"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const uCenter = 0.25 + rollOsc * 0.068;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      for (let i = 0; i < cols; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const nx0 = (i / cols) * 2 - 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const nx1 = ((i + 1) / cols) * 2 - 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const nxMid = (nx0 + nx1) * 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const lon = Math.asin(Math.max(-1, Math.min(1, nxMid)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const cosLon = Math.cos(lon);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (cosLon <= 0.05) continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const uNorm = (((uCenter + (lon / Math.PI) * 0.35) % 1) + 1) % 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const srcX = Math.floor(uNorm * (texW - 4));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const srcW = Math.max(2, Math.ceil((texW * 0.35) / cols));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const destX = nx0 * R;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const destW = Math.max(1.5, (nx1 - nx0) * R + 0.75);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Vertical height compresses toward left/right horizon of the sphere (cos(lon))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const bandHalfH = R * 0.68 * cosLon;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // 3D latitude pitch curvature (reacts to cursor Y!)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const pitchCurveY = Math.pow(nxMid, 2) * (R * (0.09 - my * 0.05)) + my * (R * 0.08) * cosLon;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ctx.globalAlpha = Math.pow(cosLon, 1.18) * 0.94;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        ctx.drawImage("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          stripCanvas,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
