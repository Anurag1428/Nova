      arguments_json: "{\"Description\":\"Update salonData.ts brand name, founder profile, and contact email from Hershita to Nova\",\"Instruction\":\"Replace HERSHITA/Hershita with NOVA/Nova in salonData.ts\",\"ReplacementChunks\":[{\"AllowMultiple\":false,\"EndLine\":63,\"ReplacementContent\":\"  brand: {\\n    name: \'NOVA\',\\n    subBrand: \'MAISON AURA\',\",\"StartLine\":60,\"TargetContent\":\"  brand: {\\n    name: \'HERSHITA\',\\n    subBrand: \'MAISON AURA\',\"},{\"AllowMultiple\":false,\"EndLine\":450,\"ReplacementContent\":\"      {\\n        id: \'member-1\',\\n        name: \'Nova\',\\n        role: \'Founder & Lead Aesthetician\',\\n        specialty: \'Sculptural Facial Massage & Bespoke Skin Architecture\',\\n        bio: \'Founder of Nova Maison Aura. Specializes in slow manual facial contouring, barrier restoration, and guiding clients toward effortless, enduring skin health.\',\\n        image: \'/images/chapter-2-tailored.jpg\',\\n        alt: \'Portrait of Nova, Founder & Lead Aesthetician\',\\n        isPlaceholder: false,\\n      },\",\"StartLine\":440,\"TargetContent\":\"      {\\n        id: \'member-1\',\\n        name: \'Hershita\',\\n        role: \'Founder & Lead Aesthetician\',\\n        specialty: \'Sculptural Facial Massage & Bespoke Skin Architecture\',\\n        bio: \'Founder of Hershita Maison Aura. Specializes in slow manual facial contouring, barrier restoration, and guiding clients toward effortless, enduring skin health.\',\\n        image: \'/images/chapter-2-tailored.jpg\',\\n        alt: \'Portrait of Hershita, Founder & Lead Aesthetician\',\\n        isPlaceholder: false,\\n      },\"},{\"AllowMultiple\":false,\"EndLine\":480,\"ReplacementContent\":\"    email: \'info@novaclinic.com.au\',\",\"StartLine\":477,\"TargetContent\":\"    email: \'info@hershitaclinic.com.au\',\"}],\"TargetFile\":\"/src/data/salonData.ts\",\"toolAction\":\"Updating salonData.ts to Nova\",\"toolSummary\":\"Update salonData.ts to Nova\"}"
