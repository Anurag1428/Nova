             </div>\n            </section>"
        replacement_content: "              {/* Part B: Odyss\303\251e Asymmetrical Dual-Video & Giant Macro Lips/Skin Composition (`image_77d66d8b.png`)\n                  Left small video + caption stays sticky and travels down alongside the taller right-hand video as the user scrolls */}\n              <div\n                data-testid=\"philosophy-dual-video-grid\"\n                className=\"mx-auto max-w-[1440px] px-4 sm:px-6 md:px-7 grid grid-cols-1 lg:grid-cols-12 gap-0 items-start lg:items-stretch\"\n              >\n                {/* Left-Center Small Macro Video + Caption Underneath (col-start-5 col-span-2) \342\200\224 stretches to match right video height so inner sticky block glides along it */}\n                <div className=\"lg:col-start-5 lg:col-span-2 pb-12 lg:pb-0 relative\">\n                  <div\n                    data-testid=\"philosophy-small-sticky-card\"\n                    className=\"lg:sticky lg:top-24\"\n                  >\n                    <div className=\"aspect-[4/5] w-full overflow-hidden bg-[#D5D7DB]\">\n                      <MediaSlot\n                        media={mediaSlots.spreadLeft}\n                        priority={true}\n                        subtleMotion={false}\n                        className=\"h-full w-full grayscale contrast-105\"\n                      />\n                    </div>\n                    <p className=\"font-basel mt-4 pr-4 pb-1 text-[13px] leading-[1.55] text-[#18224B]\">\n                      Behind every treatment lies a commitment to science, research and refinement, ensuring results that are safe, precise and enduring.\n                    </p>\n                  </div>\n                </div>\n\n                {/* Right Giant Macro Skin & Lips Video/Portrait (col-start-7 col-span-5) \342\200\224 tall container so the small left card scrolls along its length */}\n                <div\n                  data-testid=\"philosophy-large-video-card\"\n                  className=\"lg:col-start-7 lg:col-span-5 aspect-[4/5] lg:aspect-auto lg:h-[132vh] lg:min-h-[920px] w-full overflow-hidden bg-[#E5DDD5]\"\n                >\n                  <MediaSlot\n                    media={{\n                      id: \'macro-lips-right\',\n                      videoPath: \'/videos/approach-3.mp4\',\n                      enableVideo: true,\n                      posterPath: \'/images/spread-left-lips.jpg\',\n                      alt: \'Extreme macro close-up of luminous skin texture and lips\',\n                      focalPoint: \'center center\',\n                    }}\n                    priority={true}\n                    subtleMotion={true}\n                    className=\"h-full w-full\"\n                  />\n                </div>\n              </div>\n            </section>"
