      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Use font-light on editorial serif headings and font-brand on NOVA in TreatmentsSection.tsx\",\"EndLine\":210,\"Instruction\":\"Update headings to font-light and NOVA to font-brand in src/components/TreatmentsSection.tsx\",\"ReplacementContent\":\"          <div className=\\\"lg:col-span-6\\\">\\n            {isFullPage ? (\\n              <h1\\n                id=\\\"treatments-heading\\\"\\n                className=\\\"font-serif-editorial text-4xl md:text-6xl font-light tracking-[-0.024em] text-[#18224B] [text-wrap:balance]\\\"\\n              >\\n                Treatments composed for calm, lasting radiance.\\n              </h1>\\n            ) : (\\n              <h2\\n                id=\\\"treatments-heading\\\"\\n                className=\\\"font-serif-editorial text-3xl md:text-5xl font-light tracking-[-0.024em] text-[#18224B] [text-wrap:balance]\\\"\\n              >\\n                Rituals tailored to your skin, hands, and occasion.\\n              </h2>\\n            )}\\n          </div>\\n          <div className=\\\"lg:col-span-3 flex flex-col items-start lg:items-end justify-end\\\">\\n            {!isFullPage && onExploreFullTreatments && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onExploreFullTreatments}\\n                className=\\\"cursor-pointer text-[11px] uppercase tracking-[0.14em] text-[#18224B] hover:opacity-60 transition-opacity whitespace-nowrap shrink-0\\\"\\n              >\\n                View full treatment menu \342\206\222\\n              </button>\\n            )}\\n          </div>\\n        </div>\\n\\n        {/* Category Filter Tabs */}\\n        <div\\n          role=\\\"tablist\\\"\\n          aria-label=\\\"Treatment Categories\\\"\\n          className=\\\"mt-8 flex flex-wrap items-center gap-3 pb-6 border-b border-[#18224B]/10\\\"\\n        >\\n          {categories.map((cat) => {\\n            const isSelected = cat.id === expandedCategoryId;\\n            return (\\n              <button\\n                key={cat.id}\\n                role=\\\"tab\\\"\\n                type=\\\"button\\\"\\n                aria-selected={isSelected}\\n                onClick={() => setExpandedCategoryId(cat.id)}\\n                className={`cursor-pointer px-4 py-2 text-[11px] uppercase tracking-[0.12em] transition-colors whitespace-nowrap shrink-0 ${\\n                  isSelected\\n                    ? \'bg-[#18224B] text-[#FBF9F5]\'\\n                    : \'bg-[#F2EFE9] text-[#18224B] hover:bg-[#E6E1D8]\'\\n                }`}\\n              >\\n                {cat.index}. {cat.shortLabel}\\n              </button>\\n            );\\n          })}\\n        </div>\\n\\n        {/* Editorial Accordion & Media Split */}\\n        <div className=\\\"mt-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start\\\">\\n          {/* Left Column: Expandable Category Chapters */}\\n          <div className=\\\"lg:col-span-7 divide-y divide-[#18224B]/15 border-b border-[#18224B]/15\\\">\\n            {categories.map((cat) => {\\n              const isOpen = cat.id === expandedCategoryId;\\n              return (\\n                <div key={cat.id} className=\\\"py-7\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setExpandedCategoryId(cat.id)}\\n                    aria-expanded={isOpen}\\n                    className=\\\"cursor-pointer flex w-full items-baseline justify-between gap-4 text-left group\\\"\\n                  >\\n                    <div className=\\\"flex items-baseline gap-5\\\">\\n                      <span className=\\\"font-mono-tabular text-xs text-[#18224B]/60\\\">\\n                        ({cat.index}).\\n                      </span>\\n                      <div>\\n                        <h3 className=\\\"font-serif-editorial text-2xl md:text-4xl font-light tracking-[-0.022em] text-[#18224B] group-hover:italic transition-all\\\">\\n                          {cat.title}\\n                        </h3>\\n                        <p className=\\\"text-xs text-[#18224B]/70 mt-1\\\">\\n                          {cat.subtitle}\\n                        </p>\\n                      </div>\\n                    </div>\\n                    <span className=\\\"font-mono-tabular text-[11px] uppercase tracking-[0.14em] text-[#18224B]/70 whitespace-nowrap shrink-0\\\">\\n                      {isOpen ? \'Selected\' : \'Explore +\'}\\n                    </span>\\n                  </button>\\n\\n                  {isOpen && (\\n                    <div className=\\\"mt-6 pl-0 md:pl-11 space-y-6\\\">\\n                      <p className=\\\"text-[13px] leading-relaxed text-[#18224B]/85 max-w-2xl\\\">\\n                        {cat.description}\\n                      </p>\\n\\n                      {/* Individual Rituals List */}\\n                      <div className=\\\"divide-y divide-[#18224B]/10 border-t border-[#18224B]/15\\\">\\n                        {cat.rituals.map((ritual) => (\\n                          <div\\n                            key={ritual.id}\\n                            className=\\\"py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\"\\n                          >\\n                            <div className=\\\"space-y-1.5 max-w-xl\\\">\\n                              <div className=\\\"flex flex-wrap items-baseline gap-2\\\">\\n                                <h4 className=\\\"font-serif-editorial text-xl font-light tracking-[-0.02em] text-[#18224B]\\\">\\n                                  {ritual.name}\\n                                </h4>\\n                                <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[#18224B]/50\\\">\302\267</span>\\n                                <span className=\\\"font-mono-tabular text-xs text-[#18224B]/70\\\">\\n                                  {ritual.duration}\\n                                </span>\\n                                <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[#18224B]/50\\\">\302\267</span>\\n                                <span className=\\\"font-mono-tabular text-xs font-medium text-[#18224B]\\\">\\n                                  {ritual.examplePrice}\\n                                </span>\\n                              </div>\\n                              <p className=\\\"text-xs leading-relaxed text-[#18224B]/75\\\">\\n                                {ritual.summary}\\n                              </p>\\n                              <p className=\\\"text-[11px] text-[#18224B]/60 pt-0.5\\\">\\n                                {ritual.includes.join(\' \302\267 \')}\\n                              </p>\\n                            </div>\\n\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => onOpenBooking(cat.id, ritual.id)}\\n                              className=\\\"cursor-pointer self-start sm:self-center px-4 py-2 text-[11px] uppercase tracking-[0.14em] bg-[#18224B] text-[#FBF9F5] hover:opacity-85 transition-opacity whitespace-nowrap shrink-0\\\"\\n                            >\\n                              Reserve ritual\\n                            </button>\\n                          </div>\\n                        ))}\\n                      </div>\\n                    </div>\\n                  )}\\n                </div>\\n              );\\n            })}\\n          </div>\\n\\n          {/* Right Column: Sticky Editorial Preview for Active Service Category */}\\n          <div className=\\\"lg:col-span-5 lg:sticky lg:top-24 space-y-6\\\">\\n            <div className=\\\"aspect-[4/5] w-full overflow-hidden bg-[#E6E2DA]\\\">\\n              <MediaSlot\\n                key={activeCategory.media.id}\\n                media={activeCategory.media}\\n                subtleMotion={true}\\n                className=\\\"h-full w-full\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"pt-2 space-y-3\\\">\\n              <div className=\\\"flex items-center justify-between text-[11px] text-[#18224B]/65\\\">\\n                <span className=\\\"uppercase tracking-[0.14em]\\\">Selected Category</span>\\n                <span className=\\\"font-mono-tabular\\\">{activeCategory.index} : 04</span>\\n              </div>\\n              <h3 className=\\\"font-serif-editorial text-3xl font-light tracking-[-0.022em] text-[#18224B]\\\">\\n                {activeCategory.title}\\n              </h3>\\n              <p className=\\\"text-[13px] text-[#18224B]/80 leading-relaxed\\\">\\n                Unsure which ritual best suits your skin or schedule? Book a tailored consultation with <span className=\\\"font-brand tracking-[0.04em]\\\">NOVA</span> and our specialists will adapt your session on the day.\\n              </p>\",\"StartLine\":42,\"TargetContent\":\"          <div className=\\\"lg:col-span-6\\\">\\n            {isFullPage ? (\\n              <h1\\n                id=\\\"treatments-heading\\\"\\n                className=\\\"font-serif-editorial text-4xl md:text-6xl font-normal tracking-tight text-[#18224B] [text-wrap:balance]\\\"\\n              >\\n                Treatments composed for calm, lasting radiance.\\n              </h1>\\n            ) : (\\n              <h2\\n                id=\\\"treatments-heading\\\"\\n                className=\\\"font-serif-editorial text-3xl md:text-5xl font-normal tracking-tight text-[#18224B] [text-wrap:balance]\\\"\\n              >\\n                Rituals tailored to your skin, hands, and occasion.\\n              </h2>\\n            )}\\n          </div>\\n          <div className=\\\"lg:col-span-3 flex flex-col items-start lg:items-end justify-end\\\">\\n            {!isFullPage && onExploreFullTreatments && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onExploreFullTreatments}\\n                className=\\\"cursor-pointer text-[11px] uppercase tracking-[0.14em] text-[#18224B] hover:opacity-60 transition-opacity whitespace-nowrap shrink-0\\\"\\n              >\\n                View full treatment menu \342\206\222\\n              </button>\\n            )}\\n          </div>\\n        </div>\\n\\n        {/* Category Filter Tabs */}\\n        <div\\n          role=\\\"tablist\\\"\\n          aria-label=\\\"Treatment Categories\\\"\\n          className=\\\"mt-8 flex flex-wrap items-center gap-3 pb-6 border-b border-[#18224B]/10\\\"\\n        >\\n          {categories.map((cat) => {\\n            const isSelected = cat.id === expandedCategoryId;\\n            return (\\n              <button\\n                key={cat.id}\\n                role=\\\"tab\\\"\\n                type=\\\"button\\\"\\n                aria-selected={isSelected}\\n                onClick={() => setExpandedCategoryId(cat.id)}\\n                className={`cursor-pointer px-4 py-2 text-[11px] uppercase tracking-[0.12em] transition-colors whitespace-nowrap shrink-0 ${\\n                  isSelected\\n                    ? \'bg-[#18224B] text-[#FBF9F5]\'\\n                    : \'bg-[#F2EFE9] text-[#18224B] hover:bg-[#E6E1D8]\'\\n                }`}\\n              >\\n                {cat.index}. {cat.shortLabel}\\n              </button>\\n            );\\n          })}\\n        </div>\\n\\n        {/* Editorial Accordion & Media Split */}\\n        <div className=\\\"mt-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start\\\">\\n          {/* Left Column: Expandable Category Chapters */}\\n          <div className=\\\"lg:col-span-7 divide-y divide-[#18224B]/15 border-b border-[#18224B]/15\\\">\\n            {categories.map((cat) => {\\n              const isOpen = cat.id === expandedCategoryId;\\n              return (\\n                <div key={cat.id} className=\\\"py-7\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setExpandedCategoryId(cat.id)}\\n                    aria-expanded={isOpen}\\n                    className=\\\"cursor-pointer flex w-full items-baseline justify-between gap-4 text-left group\\\"\\n                  >\\n                    <div className=\\\"flex items-baseline gap-5\\\">\\n                      <span className=\\\"font-mono-tabular text-xs text-[#18224B]/60\\\">\\n                        ({cat.index}).\\n                      </span>\\n                      <div>\\n                        <h3 className=\\\"font-serif-editorial text-2xl md:text-4xl font-normal text-[#18224B] group-hover:italic transition-all\\\">\\n                          {cat.title}\\n                        </h3>\\n                        <p className=\\\"text-xs text-[#18224B]/70 mt-1\\\">\\n                          {cat.subtitle}\\n                        </p>\\n                      </div>\\n                    </div>\\n                    <span className=\\\"font-mono-tabular text-[11px] uppercase tracking-[0.14em] text-[#18224B]/70 whitespace-nowrap shrink-0\\\">\\n                      {isOpen ? \'Selected\' : \'Explore +\'}\\n                    </span>\\n                  </button>\\n\\n                  {isOpen && (\\n                    <div className=\\\"mt-6 pl-0 md:pl-11 space-y-6\\\">\\n                      <p className=\\\"text-[13px] leading-relaxed text-[#18224B]/85 max-w-2xl\\\">\\n                        {cat.description}\\n                      </p>\\n\\n                      {/* Individual Rituals List */}\\n                      <div className=\\\"divide-y divide-[#18224B]/10 border-t border-[#18224B]/15\\\">\\n                        {cat.rituals.map((ritual) => (\\n                          <div\\n                            key={ritual.id}\\n                            className=\\\"py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\"\\n                          >\\n                            <div className=\\\"space-y-1.5 max-w-xl\\\">\\n                              <div className=\\\"flex flex-wrap items-baseline gap-2\\\">\\n                                <h4 className=\\\"font-serif-editorial text-xl font-medium text-[#18224B]\\\">\\n                                  {ritual.name}\\n                                </h4>\\n                                <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[#18224B]/50\\\">\302\267</span>\\n                                <span className=\\\"font-mono-tabular text-xs text-[#18224B]/70\\\">\\n                                  {ritual.duration}\\n                                </span>\\n                                <span aria-hidden=\\\"true\\\" className=\\\"text-xs text-[#18224B]/50\\\">\302\267</span>\\n                                <span className=\\\"font-mono-tabular text-xs font-medium text-[#18224B]\\\">\\n                                  {ritual.examplePrice}\\n                                </span>\\n                              </div>\\n                              <p className=\\\"text-xs leading-relaxed text-[#18224B]/75\\\">\\n                                {ritual.summary}\\n                              </p>\\n                              <p className=\\\"text-[11px] text-[#18224B]/60 pt-0.5\\\">\\n                                {ritual.includes.join(\' \302\267 \')}\\n                              </p>\\n                            </div>\\n\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => onOpenBooking(cat.id, ritual.id)}\\n                              className=\\\"cursor-pointer self-start sm:self-center px-4 py-2 text-[11px] uppercase tracking-[0.14em] bg-[#18224B] text-[#FBF9F5] hover:opacity-85 transition-opacity whitespace-nowrap shrink-0\\\"\\n                            >\\n                              Reserve ritual\\n                            </button>\\n                          </div>\\n                        ))}\\n                      </div>\\n                    </div>\\n                  )}\\n                </div>\\n              );\\n            })}\\n          </div>\\n\\n          {/* Right Column: Sticky Editorial Preview for Active Service Category */}\\n          <div className=\\\"lg:col-span-5 lg:sticky lg:top-24 space-y-6\\\">\\n            <div className=\\\"aspect-[4/5] w-full overflow-hidden bg-[#E6E2DA]\\\">\\n              <MediaSlot\\n                key={activeCategory.media.id}\\n                media={activeCategory.media}\\n                subtleMotion={true}\\n                className=\\\"h-full w-full\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"pt-2 space-y-3\\\">\\n              <div className=\\\"flex items-center justify-between text-[11px] text-[#18224B]/65\\\">\\n                <span className=\\\"uppercase tracking-[0.14em]\\\">Selected Category</span>\\n                <span className=\\\"font-mono-tabular\\\">{activeCategory.index} : 04</span>\\n              </div>\\n              <h3 className=\\\"font-serif-editorial text-3xl font-normal text-[#18224B]\\\">\\n                {activeCategory.title}\\n              </h3>\\n              <p className=\\\"text-[13px] text-[#18224B]/80 leading-relaxed\\\">\\n                Unsure which ritual best suits your skin or schedule? Book a tailored consultation with Nova and our specialists will adapt your session on the day.\\n              </p>\",\"TargetFile\":\"/src/components/TreatmentsSection.tsx\",\"toolAction\":\"Updating NOVA font and serif weights in TreatmentsSection.tsx\",\"toolSummary\":\"Update NOVA font in TreatmentsSection.tsx\"}"
