      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Configure psTimes and Basel Grotesk font families and utility classes in src/index.css\",\"EndLine\":35,\"Instruction\":\"Define font-pstimes and font-basel in src/index.css and set Basel Grotesk as default body font and psTimes for editorial serif\",\"ReplacementContent\":\"  body {\\n    font-family: \'Basel Grotesk\', \'Inter\', -apple-system, BlinkMacSystemFont, \'Helvetica Neue\', sans-serif;\\n    background-color: var(--bg-ivory);\\n    color: var(--ink-navy);\\n    overflow-x: hidden;\\n  }\\n\\n  h1, h2, h3, .font-serif-editorial, .font-pstimes {\\n    font-family: \'psTimes\', \'Newsreader\', \'Times New Roman\', Times, Georgia, serif;\\n  }\\n\\n  .font-basel {\\n    font-family: \'Basel Grotesk\', \'Inter\', -apple-system, BlinkMacSystemFont, \'Helvetica Neue\', sans-serif;\\n  }\\n\\n  .font-brand {\\n    font-family: \'Cabin Sketch\', cursive, sans-serif;\\n  }\\n\\n  .font-mono-tabular {\\n    font-family: \'JetBrains Mono\', monospace;\\n    font-variant-numeric: tabular-nums;\\n  }\",\"StartLine\":14,\"TargetContent\":\"  body {\\n    font-family: \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, sans-serif;\\n    background-color: var(--bg-ivory);\\n    color: var(--ink-navy);\\n    overflow-x: hidden;\\n  }\\n\\n  h1, h2, h3, .font-serif-editorial {\\n    font-family: \'Cormorant Garamond\', Georgia, serif;\\n  }\\n\\n  .font-brand {\\n    font-family: \'Cabin Sketch\', cursive, sans-serif;\\n  }\\n\\n  .font-mono-tabular {\\n    font-family: \'JetBrains Mono\', monospace;\\n    font-variant-numeric: tabular-nums;\\n  }\",\"TargetFile\":\"/src/index.css\",\"toolAction\":\"Configuring psTimes and Basel Grotesk in src/index.css\",\"toolSummary\":\"Configure psTimes and Basel Grotesk in index.css\"}"
      original_name: "replace_file_content"
    }
