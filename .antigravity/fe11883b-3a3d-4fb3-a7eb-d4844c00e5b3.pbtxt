  view_file {
    absolute_path_uri: "file:///src/components/Header.tsx"
    end_line: 238
    content: "import React, { useEffect, useState } from \'react\';\nimport { SALON_CONFIG } from \'../data/salonData\';\n\nexport type ActivePage = \'home\' | \'treatments\' | \'about\';\n\ninterface HeaderProps {\n  activePage: ActivePage;\n  onNavigatePage: (page: ActivePage, sectionId?: string) => void;\n  onOpenBooking: (categoryId?: string, ritualId?: string) => void;\n  bookingCount: number;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  activePage,\n  onNavigatePage,\n  onOpenBooking,\n  bookingCount,\n}) => {\n  const [isScrolled, setIsScrolled] = useState(false);\n  const [menuOpen, setMenuOpen] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      // Transition into compact top header after scrolling past the opening video hero\n      setIsScrolled(window.scrollY > window.innerHeight * 0.85);\n    };\n    handleScroll();\n    window.addEventListener(\'scroll\', handleScroll, { passive: true });\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  useEffect(() => {\n    if (!menuOpen) return;\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === \'Escape\') {\n        setMenuOpen(false);\n      }\n    };\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => window.removeEventListener(\'keydown\', handleKeyDown);\n  }, [menuOpen]);\n\n  const showCompactBar = isScrolled || activePage !== \'home\';\n\n  const handleLinkClick = (page: ActivePage, sectionId?: string) => {\n    setMenuOpen(false);\n    onNavigatePage(page, sectionId);\n  };\n\n  return (\n    <>\n      {/* Odyss\303\251e-Inspired Minimalist Sticky Top Bar (#FBF9F5 background, #18224B midnight navy text)\n          Follows 3-Zone Contract: Brand Wordmark \342\200\224 Clean Text Links \342\200\224 Primary Action */}\n      <header\n        aria-label=\"Primary Sticky Navigation\"\n        className={`fixed top-0 left-0 right-0 z-40 flex items-center justify-between gap-8 px-6 md:px-10 py-4 transition-all duration-500 ${\n          showCompactBar\n            ? \'translate-y-0 opacity-100 bg-[#FBF9F5]/95 backdrop-blur-md text-[#18224B]\'\n            : \'pointer-events-none -translate-y-3 opacity-0 bg-transparent text-[#FBF9F5]\'\n        }`}\n      >\n        {/* Zone 1: HERSHITA Editorial Wordmark */}\n        <a\n          href=\"#top\"\n          onClick={(e) => {\n            e.preventDefault();\n            handleLinkClick(\'home\');\n          }}\n          className=\"font-serif-editorial text-2xl md:text-[1.7rem] tracking-[0.14em] text-current whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4\"\n        >\n          {SALON_CONFIG.brand.name}\n        </a>\n\n        {/* Zone 2: Minimalist uppercase navigation links (MENU \302\267 TREATMENTS \302\267 OUR APPROACH \302\267 ABOUT) */}\n        <nav\n          aria-label=\"Main Navigation\"\n          className=\"hidden md:flex items-center gap-10 text-[11px] tracking-[0.12em] uppercase text-[#18224B]\"\n        >\n          <button\n            type=\"button\"\n            onClick={() => setMenuOpen(true)}\n            aria-expanded={menuOpen}\n            aria-controls=\"maison-aura-menu-panel\"\n            className=\"cursor-pointer py-1 hover:opacity-60 transition-opacity whitespace-nowrap shrink-0\"\n          >\n            Menu\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => handleLinkClick(\'treatments\')}\n            className={`cursor-pointer py-1 transition-opacity whitespace-nowrap shrink-0 ${\n              activePage === \'treatments\'\n                ? \'underline underline-offset-4 font-medium\'\n                : \'hover:opacity-60\'\n            }`}\n          >\n            Treatments\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => handleLinkClick(\'home\', \'our-approach\')}\n            className=\"cursor-pointer py-1 hover:opacity-60 transition-opacity whitespace-nowrap shrink-0\"\n          >\n            Our approach\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => handleLinkClick(\'about\')}\n            className={`cursor-pointer py-1 transition-opacity whitespace-nowrap shrink-0 ${\n              activePage === \'about\'\n                ? \'underline underline-offset-4 font-medium\'\n                : \'hover:opacity-60\'\n            }`}\n          >\n            About\n          </button>\n        </nav>\n\n        {/* Zone 3: Primary Action */}\n        <div className=\"flex items-center gap-4 shrink-0\">\n          <button\n            type=\"button\"\n            onClick={() => setMenuOpen(true)}\n            aria-label=\"Open navigation menu\"\n            aria-expanded={menuOpen}\n            className=\"md:hidden cursor-pointer px-2.5 py-1.5 text-[11px] uppercase tracking-[0.12em] text-[#18224B] whitespace-nowrap shrink-0\"\n          >\n            Menu\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => onOpenBooking()}\n            className=\"cursor-pointer py-1 text-[11px] uppercase tracking-[0.12em] text-[#18224B] hover:opacity-60 transition-opacity whitespace-nowrap shrink-0\"\n          >\n            {bookingCount > 0 ? `Book Consultation (${bookingCount})` : \'Book Consultation\'}\n          </button>\n        </div>\n      </header>\n\n      {/* Animated Editorial Menu Panel */}\n      {menuOpen && (\n        <div\n          id=\"maison-aura-menu-panel\"\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-label=\"Hershita Site Menu\"\n          className=\"fixed inset-0 z-50 flex flex-col justify-between bg-[#18224B] text-[#FBF9F5] p-6 md:p-14 transition-opacity duration-300\"\n        >\n          {/* Top row */}\n          <div className=\"flex items-center justify-between border-b border-[#FBF9F5]/15 pb-6\">\n            <span className=\"font-serif-editorial text-2xl md:text-3xl tracking-[0.16em]\">\n              {SALON_CONFIG.brand.name}\n            </span>\n            <button\n              type=\"button\"\n              onClick={() => setMenuOpen(false)}\n              aria-label=\"Close navigation menu\"\n              className=\"cursor-pointer px-4 py-2 text-xs uppercase tracking-[0.16em] border border-[#FBF9F5]/25 hover:border-[#FBF9F5] transition-colors whitespace-nowrap shrink-0\"\n            >\n              Close\n            </button>\n          </div>\n\n          {/* Center navigation links & editorial preview */}\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 my-auto py-8 items-center\">\n            <nav aria-label=\"Menu Overlay Navigation\" className=\"lg:col-span-7 flex flex-col items-start gap-4 md:gap-6\">\n              <span className=\"text-xs uppercase tracking-[0.2em] text-[#C5B393]\">\n                {SALON_CONFIG.brand.editionNotice}\n              </span>\n              <button\n                type=\"button\"\n                onClick={() => handleLinkClick(\'home\')}\n                className=\"cursor-pointer font-serif-editorial text-4xl md:text-6xl font-light hover:italic hover:text-[#C5B393] transition-all text-left\"\n              >\n                01. Sanctuary Home\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleLinkClick(\'treatments\')}\n                className=\"cursor-pointer font-serif-editorial text-4xl md:text-6xl font-light hover:italic hover:text-[#C5B393] transition-all text-left\"\n              >\n                02. Treatments &amp; Rituals\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleLinkClick(\'home\', \'our-approach\')}\n                className=\"cursor-pointer font-serif-editorial text-4xl md:text-6xl font-light hover:italic hover:text-[#C5B393] transition-all text-left\"\n              >\n                03. Why Hershita\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleLinkClick(\'about\')}\n                className=\"cursor-pointer font-serif-editorial text-4xl md:text-6xl font-light hover:italic hover:text-[#C5B393] transition-all text-left\"\n              >\n                04. About &amp; Artisans\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setMenuOpen(false);\n                  onOpenBooking();\n                }}\n                className=\"cursor-pointer mt-4 px-7 py-3.5 text-xs uppercase tracking-[0.18em] bg-[#FBF9F5] text-[#18224B] hover:bg-[#C5B393] transition-colors whitespace-nowrap shrink-0\"\n              >\n                Book Consultation\n              </button>\n            </nav>\n\n            <div className=\"hidden lg:flex lg:col-span-5 flex-col gap-6 border-l border-[#FBF9F5]/15 pl-12\">\n              <div className=\"aspect-[4/3] w-full overflow-hidden bg-[#1D2854]\">\n                <img\n                  src=\"/images/philosophy-space.jpg\"\n                  alt=\"Hershita private treatment suite\"\n                  className=\"h-full w-full object-cover opacity-90\"\n                />\n              </div>\n              <p className=\"font-serif-editorial text-2xl italic text-[#FBF9F5]/90\">\n                \342\200\234{SALON_CONFIG.brand.shortTagline}\342\200\235\n              </p>\n              <div className=\"text-xs text-[#FBF9F5]/65 space-y-1\">\n                <p>{SALON_CONFIG.contact.addressLine1}</p>\n                <p>{SALON_CONFIG.contact.addressLine2}</p>\n                <p className=\"pt-2 text-[#C5B393]\">{SALON_CONFIG.contact.phoneDisplay}</p>\n              </div>\n            </div>\n          </div>\n\n          {/* Bottom bar */}\n          <div className=\"flex flex-wrap items-center justify-between gap-4 border-t border-[#FBF9F5]/15 pt-6 text-xs text-[#FBF9F5]/60\">\n            <span>{SALON_CONFIG.brand.shortTagline}</span>\n            <span>Facials \302\267 Nails &amp; Manicure \302\267 Bridal &amp; Editorial Makeup \302\267 Consultations</span>\n          </div>\n        </div>\n      )}\n    </>\n  );\n};\n"
    num_lines: 239
    num_bytes: 9794
    line_range_bytes: 9794
  }
}
