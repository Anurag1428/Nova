    content: "import React, { useEffect, useRef } from \'react\';\n\ninterface RollingMarbleProps {\n  brandText?: string;\n  onBookClick: () => void;\n}\n\n/**\n * Photorealistic studio-lit rolling pearl/marble sphere with 3D spherical\n * surface engraving of \"HERSHITA\", matching the final scene of Odyss\303\251e Clinic.\n * Uses high-DPI 2D canvas vertical-column spherical projection + specular/Fresnel shading\n * for crisp, unmistakable 3D typography wrapped around the rolling sphere.\n */\nexport const RollingMarble: React.FC<RollingMarbleProps> = ({\n  brandText = \'NOVA\',\n  onBookClick,\n}) => {\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\n  const scrollBoostRef = useRef<number>(0);\n\n  useEffect(() => {\n    let lastScrollY = window.scrollY;\n    const handleScroll = () => {\n      const dy = window.scrollY - lastScrollY;\n      lastScrollY = window.scrollY;\n      scrollBoostRef.current = Math.max(-0.08, Math.min(0.08, dy * 0.002));\n    };\n    window.addEventListener(\'scroll\', handleScroll, { passive: true });\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    // Create an offscreen equirectangular texture strip with \"HERSHITA\"\n    // repeated around the equator so it is always visible on the front face\n    // as the marble rolls across the studio cyclorama floor.\n    const texW = 1600;\n    const texH = 400;\n    const texCanvas = document.createElement(\'canvas\');\n    texCanvas.width = texW;\n    texCanvas.height = texH;\n    const tctx = texCanvas.getContext(\'2d\');\n\n    const drawTexture = () => {\n      if (!tctx) return;\n      tctx.clearRect(0, 0, texW, texH);\n\n      // Subtle organic marble veins across the pearl surface\n      tctx.strokeStyle = \'rgba(135, 126, 114, 0.14)\';\n      tctx.lineWidth = 1.6;\n      for (let i = 0; i < 5; i++) {\n        tctx.beginPath();\n        for (let x = 0; x <= texW; x += 24) {\n          const y =\n            texH * 0.5 +\n            Math.sin((x / texW) * Math.PI * 2 + i * 1.1) * 75 +\n            Math.cos((x / texW) * Math.PI * 4 - i) * 28;\n          if (x === 0) tctx.moveTo(x, y);\n          else tctx.lineTo(x, y);\n        }\n        tctx.stroke();\n      }\n\n      // Delicate equatorial hairline above and below the engraved name\n      tctx.strokeStyle = \'rgba(42, 36, 32, 0.18)\';\n      tctx.lineWidth = 1;\n      tctx.beginPath();\n      tctx.moveTo(0, texH * 0.31);\n      tctx.lineTo(texW, texH * 0.31);\n      tctx.moveTo(0, texH * 0.69);\n      tctx.lineTo(texW, texH * 0.69);\n      tctx.stroke();\n\n      // Engraved wordmark \"N O V A\" in Cabin Sketch with subtle light/dark deboss\n      const label = brandText.toUpperCase().split(\'\').join(\' \');\n      tctx.font = \'700 66px \"Cabin Sketch\", cursive, sans-serif\';\n      tctx.textAlign = \'center\';\n      tctx.textBaseline = \'middle\';\n\n      const positions = [texW * 0.25, texW * 0.75];\n      for (const px of positions) {\n        // Subtle inner highlight for carved stone/pearl engraving\n        tctx.fillStyle = \'rgba(255, 253, 249, 0.65)\';\n        tctx.fillText(label, px + 1.5, texH * 0.5 + 1.5);\n\n        // Deep charcoal-navy engraving ink\n        tctx.fillStyle = \'#1E243B\';\n        tctx.fillText(label, px, texH * 0.5);\n      }\n\n      // Small diamond separators at 0, 0.5, 1.0\n      for (const sepX of [0, texW * 0.5, texW]) {\n        tctx.fillStyle = \'rgba(30, 36, 59, 0.55)\';\n        tctx.beginPath();\n        tctx.arc(sepX, texH * 0.5, 4.5, 0, Math.PI * 2);\n        tctx.fill();\n      }\n    };\n\n    drawTexture();\n    if (document.fonts && document.fonts.ready) {\n      document.fonts.ready.then(() => {\n        drawTexture();\n      });\n    }\n\n    let animationFrameId = 0;\n    // Start at phase 0 so \"HERSHITA\" is centered on the front face immediately\n    let timePhase = 0;\n\n    const renderFrame = () => {\n      const dpr = Math.min(window.devicePixelRatio || 1, 2);\n      const rect = canvas.getBoundingClientRect();\n      const width = Math.max(320, rect.width);\n      const height = Math.max(320, rect.height);\n\n      if (\n        canvas.width !== Math.floor(width * dpr) ||\n        canvas.height !== Math.floor(height * dpr)\n      ) {\n        canvas.width = Math.floor(width * dpr);\n        canvas.height = Math.floor(height * dpr);\n      }\n\n      ctx.save();\n      ctx.scale(dpr, dpr);\n\n      // 1. Studio Cyclorama Background (#D7D7D7 top to #CFCFCF floor)\n      const bgGrad = ctx.createLinearGradient(0, 0, 0, height);\n      bgGrad.addColorStop(0, \'#D8D8D8\');\n      bgGrad.addColorStop(0.54, \'#CFCFCF\');\n      bgGrad.addColorStop(1, \'#DCDCDC\');\n      ctx.fillStyle = bgGrad;\n      ctx.fillRect(0, 0, width, height);\n\n      // Soft radial studio spotlight on the cyclorama floor\n      const floorGlow = ctx.createRadialGradient(\n        width * 0.52,\n        height * 0.56,\n        20,\n        width * 0.5,\n        height * 0.56,\n        width * 0.55\n      );\n      floorGlow.addColorStop(0, \'rgba(252, 250, 247, 0.45)\');\n      floorGlow.addColorStop(1, \'rgba(195, 195, 195, 0)\');\n      ctx.fillStyle = floorGlow;\n      ctx.fillRect(0, 0, width, height);\n\n      // Gentle rolling motion across the floor\n      const rollOsc = Math.sin(timePhase);\n      const R = Math.min(width, height) * 0.16;\n      const cx = width * 0.5 + rollOsc * (width * 0.045);\n      const cy = height * 0.51;\n\n      // 2. Long Soft Directional Cast Shadow to the Left (matching Odyss\303\251e\'s studio lighting)\n      ctx.save();\n      ctx.translate(cx - R * 1.35, cy + R * 0.52);\n      ctx.rotate(0.15);\n      const longShadowGrad = ctx.createRadialGradient(\n        R * 0.6,\n        0,\n        R * 0.1,\n        0,\n        0,\n        R * 2.4\n      );\n      longShadowGrad.addColorStop(0, \'rgba(82, 76, 68, 0.34)\');\n      longShadowGrad.addColorStop(0.45, \'rgba(108, 102, 94, 0.16)\');\n      longShadowGrad.addColorStop(1, \'rgba(160, 156, 150, 0)\');\n      ctx.scale(2.3, 0.38);\n      ctx.fillStyle = longShadowGrad;\n      ctx.beginPath();\n      ctx.arc(0, 0, R * 1.85, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.restore();\n\n      // 3. Tight Ambient Occlusion Contact Shadow directly beneath the marble\n      ctx.save();\n      ctx.translate(cx - R * 0.1, cy + R * 0.91);\n      ctx.scale(1.15, 0.24);\n      const aoGrad = ctx.createRadialGradient(0, 0, R * 0.05, 0, 0, R * 0.95);\n      aoGrad.addColorStop(0, \'rgba(32, 28, 24, 0.64)\');\n      aoGrad.addColorStop(0.5, \'rgba(65, 58, 52, 0.26)\');\n      aoGrad.addColorStop(1, \'rgba(120, 115, 110, 0)\');\n      ctx.fillStyle = aoGrad;\n      ctx.beginPath();\n      ctx.arc(0, 0, R * 0.95, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.restore();\n\n      // 4. Pearlescent Marble Sphere Body\n      ctx.save();\n      ctx.beginPath();\n      ctx.arc(cx, cy, R, 0, Math.PI * 2);\n      ctx.clip();\n\n      // Base 3D spherical lighting (warm pearl highlight on upper-right, warm stone core shadow on lower-left)\n      const sphereGrad = ctx.createRadialGradient(\n        cx + R * 0.32,\n        cy - R * 0.24,\n        R * 0.05,\n        cx - R * 0.08,\n        cy + R * 0.08,\n        R * 1.18\n      );\n      sphereGrad.addColorStop(0, \'#FFFDF9\');\n      sphereGrad.addColorStop(0.28, \'#F4F0E8\');\n      sphereGrad.addColorStop(0.62, \'#CCC4B6\');\n      sphereGrad.addColorStop(0.88, \'#9E9587\');\n      sphereGrad.addColorStop(1, \'#B9B1A5\');\n      ctx.fillStyle = sphereGrad;\n      ctx.fillRect(cx - R, cy - R, R * 2, R * 2);\n\n      // 5. True Vertical-Column Spherical Projection of \"HERSHITA\"\n      // Each vertical column x in [-R, R] corresponds to longitude lon = asin(x / R)\n      ctx.save();\n      ctx.translate(cx, cy);\n      ctx.rotate(-0.14); // Subtle sculptural axis tilt as the marble rolls\n\n      const cols = 96;\n      // Center u=0.25 (\"HERSHITA\") at the front of the sphere, oscillating gently as it rolls\n      const uCenter = 0.25 + rollOsc * 0.075;\n\n      for (let i = 0; i < cols; i++) {\n        const nx0 = (i / cols) * 2 - 1;\n        const nx1 = ((i + 1) / cols) * 2 - 1;\n        const nxMid = (nx0 + nx1) * 0.5;\n\n        // Longitude angle on the front hemisphere (-PI/2 to +PI/2)\n        const lon = Math.asin(Math.max(-1, Math.min(1, nxMid)));\n        const cosLon = Math.cos(lon);\n        if (cosLon <= 0.05) continue;\n\n        // Map longitude (-PI/2 .. +PI/2) to texture U coordinate around uCenter\n        // Front hemisphere spans 0.36 of the full equirectangular strip so \"HERSHITA\" fills the sphere gracefully\n        const uNorm = (((uCenter + (lon / Math.PI) * 0.36) % 1) + 1) % 1;\n        const srcX = Math.floor(uNorm * (texW - 4));\n        const srcW = Math.max(2, Math.ceil((texW * 0.36) / cols));\n\n        const destX = nx0 * R;\n        const destW = Math.max(1.5, (nx1 - nx0) * R + 0.75);\n\n        // Vertical height compresses toward the left/right edges of the sphere (cos(lon))\n        const bandHalfH = R * 0.56 * cosLon;\n        // Slight vertical curvature for 3D perspective\n        const curveOffsetY = Math.pow(nxMid, 2) * (R * 0.08);\n\n        // Natural limb darkening / Fresnel fade near the edges of the sphere\n        ctx.globalAlpha = Math.pow(cosLon, 1.25) * 0.92;\n\n        ctx.drawImage(\n          texCanvas,\n          srcX,\n          0,\n          srcW,\n          texH,\n          destX,\n          -bandHalfH + curveOffsetY,\n          destW,\n          bandHalfH * 2\n        );\n      }\n      ctx.restore();\n\n      // 6. Studio Softbox Specular Highlight + Rim Light\n      const specGrad = ctx.createRadialGradient(\n        cx + R * 0.34,\n        cy - R * 0.26,\n        R * 0.02,\n        cx + R * 0.28,\n        cy - R * 0.2,\n        R * 0.54\n      );\n      specGrad.addColorStop(0, \'rgba(255, 255, 255, 0.75)\');\n      specGrad.addColorStop(0.45, \'rgba(255, 253, 248, 0.2)\');\n      specGrad.addColorStop(1, \'rgba(255, 255, 255, 0)\');\n      ctx.fillStyle = specGrad;\n      ctx.fillRect(cx - R, cy - R, R * 2, R * 2);\n\n      // Subtle pearl pole aperture at the top of the sphere (matching Odyss\303\251e\'s pearl detail)\n      ctx.fillStyle = \'rgba(52, 46, 40, 0.38)\';\n      ctx.beginPath();\n      ctx.ellipse(\n        cx + rollOsc * (R * 0.08),\n        cy - R * 0.91,\n        R * 0.085,\n        R * 0.028,\n        0,\n        0,\n        Math.PI * 2\n      );\n      ctx.fill();\n\n      // Inner Fresnel rim light around the circumference of the marble\n      const rimGrad = ctx.createRadialGradient(cx, cy, R * 0.78, cx, cy, R);\n      rimGrad.addColorStop(0, \'rgba(255, 255, 255, 0)\');\n      rimGrad.addColorStop(0.85, \'rgba(255, 255, 255, 0.08)\');\n      rimGrad.addColorStop(1, \'rgba(255, 255, 255, 0.42)\');\n      ctx.fillStyle = rimGrad;\n      ctx.fillRect(cx - R, cy - R, R * 2, R * 2);\n\n      ctx.restore(); // end sphere clip\n\n      ctx.restore();\n\n      // Advance roll phase smoothly + react to user scroll velocity\n      timePhase += 0.014 + scrollBoostRef.current;\n      scrollBoostRef.current *= 0.9;\n\n      animationFrameId = window.requestAnimationFrame(renderFrame);\n    };\n\n    renderFrame();\n    return () => window.cancelAnimationFrame(animationFrameId);\n  }, [brandText]);\n\n  return (\n    <div className=\"relative h-[62vh] min-h-[440px] max-h-[680px] w-full overflow-hidden bg-[#D4D4D4] select-none\">\n      <canvas\n        ref={canvasRef}\n        aria-label={`Rolling pearlescent marble engraved with ${brandText}`}\n        className=\"block h-full w-full\"\n      />\n\n      {/* Editorial signature overlay at the base of the studio cyclorama */}\n      <div className=\"absolute inset-x-0 bottom-7 px-6 md:px-10 flex items-end justify-between text-[#18224B]\">\n        <button\n          type=\"button\"\n          onClick={onBookClick}\n          className=\"cursor-pointer font-serif-editorial text-xl md:text-2xl italic text-[#18224B] hover:opacity-70 transition-opacity\"\n        >\n          Begin your tailored journey \342\206\222\n        </button>\n        <div className=\"text-right\">\n          <p className=\"font-brand text-lg md:text-2xl font-normal tracking-[0.12em] uppercase text-[#18224B]\">\n            {brandText}\n          </p>\n          <p className=\"font-mono-tabular text-[10px] uppercase tracking-[0.2em] text-[#18224B]/60\">\n            Maison Aura Sanctuary\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
