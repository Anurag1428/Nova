            }
            lines {
              text: "  about: {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    heroKicker: \'ABOUT MAISON AURA\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    heroTitle: \'A quiet house devoted to unhurried beauty rituals.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    storyParagraphs: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Conceived as an intimate alternative to high-turnover salons, Maison Aura was created for guests who value stillness as much as craft. Our space pairs warm limewashed walls, natural travertine stone, and filtered daylight to soften the transition from the outside world.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'All practitioner profiles below use editable placeholder names and biographies so the salon owner can insert real team members before publishing.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
