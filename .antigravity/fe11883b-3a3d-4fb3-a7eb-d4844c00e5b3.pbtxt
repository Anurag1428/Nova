              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'We believe beauty should feel effortless long after you leave our chair. We pair in-salon treatments with simple, sustainable home rituals that support healthy skin and nails every day.\',"
