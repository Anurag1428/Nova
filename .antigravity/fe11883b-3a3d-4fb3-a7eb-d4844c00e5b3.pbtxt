    end_line: 130
    content: "import React from \'react\';\nimport { SALON_CONFIG } from \'../data/salonData\';\nimport { MediaSlot } from \'./MediaSlot\';\n\ninterface AboutSectionProps {\n  isFullPage?: boolean;\n  onNavigateAbout?: () => void;\n  onOpenBooking: () => void;\n}\n\n/**\n * Dedicated About & Sanctuary View (and team showcase)\n * Uses Odyss\303\251e\'s warm alabaster (#FBF9F5) and midnight navy (#18224B) visual language.\n */\nexport const AboutSection: React.FC<AboutSectionProps> = ({\n  isFullPage = false,\n  onOpenBooking,\n}) => {\n  const { philosophy, about } = SALON_CONFIG;\n\n  return (\n    <section\n      id=\"about-section\"\n      aria-labelledby=\"philosophy-heading\"\n      className={`bg-[#FBF9F5] text-[#18224B] px-5 md:px-8 ${\n        isFullPage ? \'pt-32 pb-28\' : \'py-24 md:py-36 border-t border-[#18224B]/10\'\n      }`}\n    >\n      <div className=\"mx-auto max-w-[1440px]\">\n        {/* Sanctuary Philosophy Header */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-start pb-20 border-b border-[#18224B]/15\">\n          <div className=\"lg:col-span-3\">\n            <span className=\"block text-[11px] uppercase tracking-[0.14em] text-[#18224B]/70\">\n              {about.heroKicker}\n            </span>\n          </div>\n\n          <div className=\"lg:col-span-9 space-y-8\">\n            <h1\n              id=\"philosophy-heading\"\n              className=\"font-serif-editorial text-4xl sm:text-5xl lg:text-[3.6rem] font-normal leading-[1.12] text-[#18224B] [text-wrap:balance]\"\n            >\n              {about.heroTitle}\n            </h1>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 pt-4\">\n              <div className=\"space-y-4 text-[14px] text-[#18224B]/85 leading-relaxed\">\n                <p className=\"font-serif-editorial text-2xl italic text-[#18224B]\">\n                  {philosophy.title} \342\200\224 {philosophy.lead}\n                </p>\n                {about.storyParagraphs.map((para, i) => (\n                  <p key={i}>{para}</p>\n                ))}\n                <div className=\"pt-3\">\n                  <button\n                    type=\"button\"\n                    onClick={onOpenBooking}\n                    className=\"cursor-pointer text-[11px] uppercase tracking-[0.14em] text-[#18224B] border-b border-[#18224B] pb-1 hover:opacity-60 transition-opacity whitespace-nowrap shrink-0\"\n                  >\n                    Book Consultation with Hershita \342\206\222\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"aspect-[16/10] w-full overflow-hidden bg-[#EAE6DF]\">\n                <MediaSlot\n                  media={SALON_CONFIG.mediaSlots.philosophy}\n                  subtleMotion={true}\n                  className=\"h-full w-full\"\n                />\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Team & Artisans (Featuring Founder Hershita) */}\n        <div className=\"pt-16\">\n          <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-4 pb-10\">\n            <span className=\"text-[11px] uppercase tracking-[0.14em] text-[#18224B]/70\">\n              The Specialists\n            </span>\n            <p className=\"text-xs text-[#18224B]/70\">\n              Led by Founder Hershita alongside specialist artisans.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n            {about.team.map((member, index) => (\n              <article\n                key={member.id}\n                className=\"flex flex-col justify-between group\"\n              >\n                <div>\n                  <div className=\"aspect-[3/4] w-full overflow-hidden bg-[#E5E0D8]\">\n                    <MediaSlot\n                      media={{\n                        id: member.id,\n                        posterPath: member.image,\n                        alt: member.alt,\n                        focalPoint: \'center 25%\',\n                      }}\n                      subtleMotion={false}\n                      className=\"h-full w-full\"\n                    />\n                  </div>\n                  <div className=\"pt-5 space-y-2\">\n                    <div className=\"flex items-center gap-2 text-[11px] text-[#18224B]/65\">\n                      <span className=\"font-mono-tabular\">({index + 1}).</span>\n                      <span aria-hidden=\"true\">\302\267</span>\n                      <span>{member.role}</span>\n                    </div>\n                    <h3 className=\"font-serif-editorial text-2xl font-normal text-[#18224B]\">\n                      {member.name}\n                    </h3>\n                    <p className=\"text-xs font-medium text-[#18224B]/90\">\n                      {member.specialty}\n                    </p>\n                    <p className=\"text-xs text-[#18224B]/70 leading-relaxed pt-1\">\n                      {member.bio}\n                    </p>\n                  </div>\n                </div>\n              </article>\n            ))}\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    num_lines: 131
    num_bytes: 5003
    line_range_bytes: 5003
  }
}
