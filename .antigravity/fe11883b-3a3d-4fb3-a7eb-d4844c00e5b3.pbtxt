            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      for (let i = 0; i < cols; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const nx0 = (i / cols) * 2 - 1;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const nx1 = ((i + 1) / cols) * 2 - 1;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const nxMid = (nx0 + nx1) * 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        // Longitude angle on the front hemisphere (-PI/2 to +PI/2)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const lon = Math.asin(Math.max(-1, Math.min(1, nxMid)));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const cosLon = Math.cos(lon);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        if (cosLon <= 0.05) continue;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        // Map longitude (-PI/2 .. +PI/2) to texture U coordinate around uCenter"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        // Front hemisphere spans 0.36 of the full equirectangular strip so \"HERSHITA\" fills the sphere gracefully"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const uNorm = (((uCenter + (lon / Math.PI) * 0.36) % 1) + 1) % 1;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const srcX = Math.floor(uNorm * (texW - 4));"
