      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Use font-light on the footer serif tagline and font-brand on NOVA in Footer.tsx\",\"EndLine\":185,\"Instruction\":\"Update Footer.tsx tagline and copyright NOVA brand font\",\"ReplacementContent\":\"      {/* Upper White/Alabaster Contact & Hours Architecture (Matching odyssee-footer.png) */}\\n      <div className=\\\"mx-auto max-w-[1440px] px-5 md:px-8 pb-8\\\">\\n        <p className=\\\"font-serif-editorial text-xl md:text-2xl font-light tracking-[-0.022em] text-[#18224B] mb-16\\\">\\n          {brand.shortTagline}\\n        </p>\\n\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-12 gap-10 pb-20 text-[13px] leading-[1.6]\\\">\\n          {/* Left Column: Contact Details Table (A. / C. / S.) */}\\n          <div className=\\\"md:col-span-4 lg:col-span-3\\\">\\n            <table className=\\\"w-full text-left border-collapse\\\">\\n              <caption className=\\\"sr-only\\\">Contact details</caption>\\n              <tbody className=\\\"align-top\\\">\\n                <tr>\\n                  <th\\n                    scope=\\\"row\\\"\\n                    aria-label=\\\"Address\\\"\\n                    className=\\\"pb-6 pr-6 font-normal text-[#18224B] w-10\\\"\\n                  >\\n                    A.\\n                  </th>\\n                  <td className=\\\"pb-6 text-[#18224B]\\\">\\n                    <p>{contact.addressLine1}</p>\\n                    <p>{contact.addressLine2}</p>\\n                    <p className=\\\"mt-0.5\\\">\\n                      <a\\n                        href={contact.directionsUrl}\\n                        target=\\\"_blank\\\"\\n                        rel=\\\"noopener noreferrer\\\"\\n                        className=\\\"hover:opacity-65 transition-opacity\\\"\\n                      >\\n                        Get Directions\\n                      </a>\\n                    </p>\\n                  </td>\\n                </tr>\\n\\n                <tr>\\n                  <th\\n                    scope=\\\"row\\\"\\n                    aria-label=\\\"Communication\\\"\\n                    className=\\\"pb-6 pr-6 font-normal text-[#18224B] w-10\\\"\\n                  >\\n                    C.\\n                  </th>\\n                  <td className=\\\"pb-6 text-[#18224B]\\\">\\n                    <p>\\n                      <a\\n                        href={`mailto:${contact.email}`}\\n                        className=\\\"hover:opacity-65 transition-opacity\\\"\\n                      >\\n                        {contact.email}\\n                      </a>\\n                    </p>\\n                    <p>\\n                      <a\\n                        href={contact.phoneHref}\\n                        className=\\\"hover:opacity-65 transition-opacity\\\"\\n                      >\\n                        {contact.phoneDisplay}\\n                      </a>\\n                    </p>\\n                  </td>\\n                </tr>\\n\\n                <tr>\\n                  <th\\n                    scope=\\\"row\\\"\\n                    aria-label=\\\"Social media\\\"\\n                    className=\\\" pr-6 font-normal text-[#18224B] w-10\\\"\\n                  >\\n                    S.\\n                  </th>\\n                  <td className=\\\"text-[#18224B]\\\">\\n                    <div className=\\\"flex flex-wrap items-center gap-1.5\\\">\\n                      {contact.socials.map((soc, idx) => (\\n                        <React.Fragment key={soc.label}>\\n                          {idx > 0 && <span aria-hidden=\\\"true\\\">/</span>}\\n                          <button\\n                            type=\\\"button\\\"\\n                            onClick={onOpenBooking}\\n                            className=\\\"cursor-pointer hover:opacity-65 transition-opacity\\\"\\n                          >\\n                            {soc.label}\\n                          </button>\\n                        </React.Fragment>\\n                      ))}\\n                    </div>\\n                  </td>\\n                </tr>\\n              </tbody>\\n            </table>\\n          </div>\\n\\n          {/* Middle Column: Weekly Opening Hours Table (Mo - Su) */}\\n          <div className=\\\"md:col-span-5 lg:col-span-4\\\">\\n            <table className=\\\"w-full max-w-[260px] text-left border-collapse\\\">\\n              <caption className=\\\"sr-only\\\">Opening hours (New South Wales time)</caption>\\n              <tbody>\\n                {contact.hours.map((row, idx) => {\\n                  const isSunday = idx === contact.hours.length - 1;\\n                  return (\\n                    <tr\\n                      key={row.days}\\n                      className={isSunday ? \'text-[#18224B]\' : \'text-[#18224B]/35\'}\\n                    >\\n                      <th scope=\\\"row\\\" className=\\\"py-0.5 pr-8 font-normal\\\">\\n                        {row.days}\\n                      </th>\\n                      <td className=\\\"py-0.5 font-mono-tabular\\\">\\n                        {row.time}\\n                      </td>\\n                    </tr>\\n                  );\\n                })}\\n              </tbody>\\n            </table>\\n          </div>\\n\\n          {/* Right Column: Quick Directory Links */}\\n          <div className=\\\"md:col-span-3 lg:col-span-5 flex flex-col items-start md:items-end justify-between\\\">\\n            <div className=\\\"flex flex-wrap gap-6 text-xs uppercase tracking-[0.12em] text-[#18224B]/70\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onNavigatePage(\'home\')}\\n                className=\\\"cursor-pointer hover:text-[#18224B]\\\"\\n              >\\n                Home\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onNavigatePage(\'treatments\')}\\n                className=\\\"cursor-pointer hover:text-[#18224B]\\\"\\n              >\\n                Treatments\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onNavigatePage(\'about\')}\\n                className=\\\"cursor-pointer hover:text-[#18224B]\\\"\\n              >\\n                About\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onOpenBooking}\\n                className=\\\"cursor-pointer text-[#18224B] font-medium hover:opacity-65\\\"\\n              >\\n                Book Consultation\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Bottom Metadata Row above the Rolling Marble */}\\n        <div className=\\\"grid grid-cols-1 sm:grid-cols-12 items-center gap-4 text-xs pt-4\\\">\\n          <div className=\\\"sm:col-span-3 text-[#18224B]\\\">\\n            \302\2512026 <span className=\\\"font-brand tracking-[0.06em]\\\">{brand.name}</span> Clinic\\n          </div>\",\"StartLine\":25,\"TargetContent\":\"      {/* Upper White/Alabaster Contact & Hours Architecture (Matching odyssee-footer.png) */}\\n      <div className=\\\"mx-auto max-w-[1440px] px-5 md:px-8 pb-8\\\">\\n        <p className=\\\"font-serif-editorial text-xl md:text-2xl font-normal text-[#18224B] mb-16\\\">\\n          {brand.shortTagline}\\n        </p>\\n\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-12 gap-10 pb-20 text-[13px] leading-[1.6]\\\">\\n          {/* Left Column: Contact Details Table (A. / C. / S.) */}\\n          <div className=\\\"md:col-span-4 lg:col-span-3\\\">\\n            <table className=\\\"w-full text-left border-collapse\\\">\\n              <caption className=\\\"sr-only\\\">Contact details</caption>\\n              <tbody className=\\\"align-top\\\">\\n                <tr>\\n                  <th\\n     