              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          shiftX - bandW * 0.5,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          destY,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          bandW,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          destH"
