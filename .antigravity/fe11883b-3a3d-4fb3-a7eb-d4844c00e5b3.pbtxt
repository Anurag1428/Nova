      thinking_signature: "\022\222\006\n\217\006\001i\024}\0233\311,\024\246@\320Q\374\312\301\355\266\210\351r\222N|\346\225\315t\252J\305\2742e\233cY^B\255\0046\b\205\310\344\t%\376\026\020\022\032N\220\214p+\313K!3\325\005\255\247\"J\302\3154\035\311m4\236k\n2\261\304\366\036\366#s\376\202\3267\377u\031\267\345\245\260\353\246\222\235\v\n\227\023\031?\322\036\0366\361u$v](|S\324\235\312\307\027\224\214i[\326\344\327\240]\335p\n*\v\030\335\225pS{\363\265@@\220\336\274\320\315\026\213\035!\310\304\373\341\332\240\334\277\224\335[\025l\323s\356\233ZZ\350X#\305\205\350\345\254<G~\250\350\221\341@\263|\237z[\001\256z\327\223=>\374\221\345\311\351\334\027\334\376\275v\313G\017\022\230\331\237\330\331\003\266%\251V\321\241\343y~\213\304=N]\265\'\036\325\314\301\247\273\203]u87Q\027R!O\243\352/\355\225\367\353g\375N\221x\241e\325\177\251`\nh,\373\266E\257\240\200\0362zw)I\224K\220)%&\300\353:\303F\326\216\233g\023\306\237\n2\257\3477\377o\367\0211\342\030\263\351\304\234\324m\351[\017\2260\242\204\340\205\213R\021\374\3655\310!\330\025\333.\317J\312\\\356Y\351|\331\263\004\233\260vY\320\003\030\320\304\327B\334\035\235Y\247*\024\223\377h\376M2bZRR\330\230\001i\360E\226\341\277\261\027\271\3416\300@\325F\346\204\3334\241d\332\373)\303\325\2125bU=\211]\350q\211\220\330\3470\333X\201\326\303@\"\377\301\210\253\364\370\316\031\005_A\0334\006o\000\272~\221,\332\324\373\323\226\000\2460\337\212\264J\333\020c\3201\207\324B\323\027s\321\037\357\022\227\b\356Z9+^\371\".\240\021R\031\321\205:\2322B$I\207\364[\"\364\230\267\017\324\352]\242\370\ty\254v\271\370\020M\354\236\020\316\264a\347\2431\316Rb\312\342T9\340\177\v,\372\250\264\200V\177t\206\356\350\312\316\224\002\006\317\232\232Pj\224;\001\357t\'\365\334\270bz\353\223\366`1\'\336\0328\207\356AS\251\377;\200\003\265\246\201\257<\374\322g\2061\242\223qJ#\b\335\f\021>\333\031\250<;u1J;\342\373\313\255\023\323\250\027\312\233Q\023\000\214\026\241\r\206\302%\022\222<\001\241\331\364\215\f\006\251\276r\241\346eg\343.\002\206\036\025^g\372#\367\257H\2648\270=8\337\t\275\210V\302v\222\332C\370\206\022\217\026\213\321\025v\333\213\300\263\206\r\202bu\216\243\244d#\260\276\016T\357\363o(\030\351\214\f\245\3510\265\352\237\360\355\234(:\314R\377\354\016?\223\312]\376V\226\233\220\233[\034(\320\243\314e\261w?\242\205\371\244\361\235\030\025\004\350(E5\036V\336\037|\364\033%I\372"
