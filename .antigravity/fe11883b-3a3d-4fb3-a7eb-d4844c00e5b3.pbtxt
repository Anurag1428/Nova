      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Update .font-brand in src/index.css to use Cabin Sketch\",\"EndLine\":32,\"Instruction\":\"Set font-family of .font-brand to Cabin Sketch in src/index.css\",\"ReplacementContent\":\"  .font-brand {\\n    font-family: \'Cabin Sketch\', cursive, sans-serif;\\n  }\",\"StartLine\":26,\"TargetContent\":\"  .font-brand {\\n    font-family: \'Bodoni Moda\', \'Cinzel\', Georgia, serif;\\n    font-optical-sizing: auto;\\n    font-feature-settings: \\\"kern\\\" 1, \\\"liga\\\" 1;\\n  }\",\"TargetFile\":\"/src/index.css\",\"toolAction\":\"Updating .font-brand to Cabin Sketch in index.css\",\"toolSummary\":\"Update .font-brand to Cabin Sketch in index.css\"}"
      original_name: "replace_file_content"
