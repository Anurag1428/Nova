    content: "import React, { useState } from \'react\';\nimport { SALON_CONFIG } from \'../data/salonData\';\nimport { formatChapterCounter, getNextChapterIndex } from \'../utils/bookingLogic\';\nimport { MediaSlot } from \'./MediaSlot\';\n\ninterface InteractiveChaptersProps {\n  onOpenBooking: () => void;\n}\n\n/**\n * Section 6: WHY HERSHITA? \342\200\224 FOUR-COLUMN EDGE-TO-EDGE VIDEO STRIP\n * Faithfully recreates Odyss\303\251e\'s signature 4-column horizontal video strip:\n * - Top line with `1 : 4` counter on left, `WHY HERSHITA?` at column 2, and sliding active underline\n * - 4 side-by-side 4:3 videos touching edge-to-edge\n * - Active column is crisp and full-opacity; inactive columns have a soft warm-ivory veil (`bg-[#FBF9F5]/80`)\n */\nexport const InteractiveChapters: React.FC<InteractiveChaptersProps> = () => {\n  const chapters = SALON_CONFIG.chapters;\n  const [activeIndex, setActiveIndex] = useState<number>(1);\n\n  const counter = formatChapterCounter(activeIndex, chapters.length);\n\n  const handleStep = (direction: \'prev\' | \'next\') => {\n    setActiveIndex((prev) => getNextChapterIndex(prev, chapters.length, direction));\n  };\n\n  return (\n    <section\n      id=\"our-approach\"\n      aria-labelledby=\"why-nova-heading\"\n      className=\"relative py-24 md:py-36 px-5 md:px-8 bg-[#FBF9F5] text-[#18224B]\"\n    >\n      <div className=\"mx-auto max-w-[1440px]\">\n        {/* Odyss\303\251e-Style Horizon Header Bar with Sliding Progress Indicator */}\n        <div className=\"relative pb-3.5 border-b border-[#18224B]/15\">\n          <div className=\"grid grid-cols-2 md:grid-cols-12 items-center text-[11px] uppercase tracking-[0.12em] text-[#18224B]\">\n            <div\n              aria-live=\"polite\"\n              aria-atomic=\"true\"\n              data-testid=\"chapter-counter\"\n              className=\"md:col-span-2 font-mono-tabular\"\n            >\n              <span>{counter.current}</span>\n              <span className=\"mx-1.5\">:</span>\n              <span>{counter.total}</span>\n            </div>\n\n            <h2\n              id=\"why-nova-heading\"\n              className=\"md:col-span-8 font-sans text-[11px] font-normal uppercase tracking-[0.12em] text-[#18224B]\"\n            >\n              Why Nova?\n            </h2>\n\n            <div className=\"hidden md:flex md:col-span-2 justify-end items-center gap-3\">\n              <button\n                type=\"button\"\n                onClick={() => handleStep(\'prev\')}\n                aria-label=\"Previous chapter\"\n                className=\"cursor-pointer px-1.5 py-0.5 text-xs text-[#18224B]/60 hover:text-[#18224B] transition-colors\"\n              >\n                \342\206\220\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleStep(\'next\')}\n                aria-label=\"Next chapter\"\n                className=\"cursor-pointer px-1.5 py-0.5 text-xs text-[#18224B]/60 hover:text-[#18224B] transition-colors\"\n              >\n                \342\206\222\n              </button>\n            </div>\n          </div>\n\n          {/* Active 1/4 Navy Horizon Bar */}\n          <div\n            aria-hidden=\"true\"\n            style={{\n              width: \'25%\',\n              transform: `translateX(${(activeIndex - 1) * 100}%)`,\n            }}\n            className=\"hidden md:block absolute bottom-0 left-0 h-[1.5px] bg-[#18224B] transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]\"\n          />\n        </div>\n\n        {/* 4-Column Edge-to-Edge Horizontal Video & Editorial Strip */}\n        <div className=\"mt-7 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-y-10 sm:gap-x-0\">\n          {chapters.map((chapter) => {\n            const isActive = chapter.index === activeIndex;\n            return (\n              <article\n                key={chapter.id}\n                onMouseEnter={() => setActiveIndex(chapter.index)}\n                className=\"relative group\"\n              >\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveIndex(chapter.index)}\n                  aria-pressed={isActive}\n                  className=\"cursor-pointer block w-full text-left focus-visible:outline-2 focus-visible:outline-[#18224B]\"\n                >\n                  {/* 4:3 Video Slot (touching edge-to-edge on desktop) */}\n                  <div className=\"relative aspect-[4/3] w-full overflow-hidden bg-[#EAE6DF]\">\n                    <MediaSlot\n                      media={chapter.media}\n                      priority={true}\n                      subtleMotion={false}\n                      className=\"h-full w-full\"\n                    />\n\n                    {/* Soft warm-alabaster veil when inactive, matching odyssee-sec1.png */}\n                    <div\n                      aria-hidden=\"true\"\n                      className={`pointer-events-none absolute inset-0 bg-[#FBF9F5] transition-opacity duration-500 ease-out ${\n                        isActive ? \'opacity-0\' : \'opacity-[0.82] group-hover:opacity-40\'\n                      }`}\n                    />\n                  </div>\n\n                  {/* Below-Video Editorial Index & Copy: (1). on left, Heading + Paragraph on right */}\n                  <div\n                    className={`mt-5 grid grid-cols-[44px_1fr] pr-6 lg:pr-10 transition-opacity duration-500 ${\n                      isActive ? \'opacity-100\' : \'opacity-20 group-hover:opacity-60\'\n                    }`}\n                  >\n                    <div className=\"font-serif-editorial text-lg text-[#18224B]\">\n                      <span>{chapter.number}</span>\n                      {isActive && <span className=\"sr-only\"> Active Chapter</span>}\n                    </div>\n\n                    <div className=\"space-y-3\">\n                      <h3 className=\"font-serif-editorial text-xl md:text-[1.35rem] font-normal leading-snug text-[#18224B]\">\n                        {chapter.title}\n                      </h3>\n                      <p className=\"text-[13px] leading-[1.55] text-[#18224B]/90\">\n                        {chapter.description}\n                      </p>\n                    </div>\n                  </div>\n                </button>\n              </article>\n            );\n          })}\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    num_lines: 149
    num_bytes: 6212
    line_range_bytes: 6212
  }
}
