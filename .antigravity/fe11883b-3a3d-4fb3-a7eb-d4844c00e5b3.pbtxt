      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Apply psTimes to the horizon tagline and Basel Grotesk to TREATMENTS, CONCERNS, ABOUT, BOOK CONSULTATION in App.tsx\",\"EndLine\":196,\"Instruction\":\"Update the middle tagline to use font-pstimes and the navigation actions (TREATMENTS, CONCERNS, ABOUT, BOOK CONSULTATION) to use font-basel with crisp neo-grotesk tracking in App.tsx\",\"ReplacementContent\":\"                    {/* Middle: Serif Tagline along the continuous horizon in psTimes */}\\n                    <p className=\\\"hidden lg:block font-pstimes text-[18px] md:text-[19px] font-normal tracking-[-0.01em] text-[#FBF9F5] whitespace-nowrap\\\">\\n                      {brand.shortTagline}\\n                    </p>\\n\\n                    {/* Right: Navigation Actions in Basel Grotesk */}\\n                    <nav\\n                      aria-label=\\\"Opening Horizon Navigation\\\"\\n                      className=\\\"font-basel flex flex-wrap items-center gap-6 md:gap-10 text-[11px] font-normal uppercase tracking-[0.04em]\\\"\\n                    >\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => handleNavigatePage(\'treatments\')}\\n                        className=\\\"font-basel cursor-pointer py-1 text-[#FBF9F5] hover:opacity-70 transition-opacity uppercase whitespace-nowrap shrink-0\\\"\\n                      >\\n                        Treatments\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => handleNavigatePage(\'home\', \'our-approach\')}\\n                        className=\\\"font-basel cursor-pointer py-1 text-[#FBF9F5] hover:opacity-70 transition-opacity uppercase whitespace-nowrap shrink-0\\\"\\n                      >\\n                        Concerns\\n                      </button>\\n                      <button\\n                        ty