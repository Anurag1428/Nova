      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Update bookingLogic.test.ts to remove ArtOfSkincareSection test\",\"EndLine\":114,\"Instruction\":\"Keep the 6 core unit tests in bookingLogic.test.ts\",\"ReplacementContent\":\"test(\'SALON_CONFIG uses NOVA brand and Founder Nova\', async () => {\\n  const { SALON_CONFIG } = await import(\'../data/salonData\');\\n  assert.equal(SALON_CONFIG.brand.name, \'NOVA\');\\n  assert.equal(SALON_CONFIG.about.team[0].name, \'Nova\');\\n});\\n\",\"StartLine\":90,\"TargetContent\":\"test(\'SALON_CONFIG uses NOVA brand and Founder Nova\', async () => {\\n  const { SALON_CONFIG } = await import(\'../data/salonData\');\\n  assert.equal(SALON_CONFIG.brand.name, \'NOVA\');\\n  assert.equal(SALON_CONFIG.about.team[0].name, \'Nova\');\\n});\\n\\ntest(\'ART_OF_SKINCARE_CONTENT matches editorial copy and macro skin image path\', async () => {\\n  const { ART_OF_SKINCARE_CONTENT } = await import(\'../components/ArtOfSkincareSection\');\\n  assert.equal(ART_OF_SKINCARE_CONTENT.eyebrow, \'THE ART OF SKINCARE\');\\n  assert.equal(ART_OF_SKINCARE_CONTENT.heading, \'Beauty begins with care.\');\\n  assert.equal(\\n    ART_OF_SKINCARE_CONTENT.description,\\n    \'Discover personalised skincare experiences designed to bring out your natural beauty.\'\\n  );\\n  assert.equal(ART_OF_SKINCARE_CONTENT.cta, \'EXPLORE TREATMENTS \342\206\227\');\\n  assert.equal(\\n    ART_OF_SKINCARE_CONTENT.imagePath,\\n    \'/assets/aistudio/Generated_Image_November_17__2026_-_4_59PM_6977a387.jpg\'\\n  );\\n});\\n\",\"TargetFile\":\"/src/utils/bookingLogic.test.ts\",\"toolAction\":\"Updating unit tests in bookingLogic.test.ts\",\"toolSummary\":\"Update unit tests in bookingLogic.test.ts\"}"
      original_name: "replace_file_content"
    }
