        target_content: "      gsap.fromTo(\n        smallEl,\n        { y: 0 },\n        {\n          y: () => getMaxTravel(),\n          ease: \'none\',\n          scrollTrigger: {\n            trigger: largeEl,\n            start: \'top 22%\',\n            end: \'bottom 86%\',\n            scrub: 0.25,\n            invalidateOnRefresh: true,\n          },\n        }\n      );\n    });\n\n    mm.add(\'(max-width: 1023px)\', () => {\n      gsap.set(smallEl, { clearProps: \'all\' });\n    });\n\n    const refreshTimer = window.setTimeout(() => {\n      ScrollTrigger.refresh();\n    }, 250);"
        replacement_content: "      gsap.fromTo(\n        smallEl,\n        { y: 0 },\n        {\n          y: () => getMaxTravel(),\n          ease: \'none\',\n          scrollTrigger: {\n            trigger: largeEl,\n            start: \'top 20%\',\n            end: \'bottom 88%\',\n            scrub: 0.2,\n            refreshPriority: -1,\n            invalidateOnRefresh: true,\n          },\n        }\n      );\n\n      ScrollTrigger.sort();\n    });\n\n    mm.add(\'(max-width: 1023px)\', () => {\n      gsap.set(smallEl, { clearProps: \'all\' });\n    });\n\n    const refreshTimer = window.setTimeout(() => {\n      ScrollTrigger.sort();\n      ScrollTrigger.refresh();\n    }, 280);"
        start_line: 59
        end_line: 95
      }
      num_matches: 1
    }
    description: "Add refreshPriority: -1 and ScrollTrigger.sort() for deterministic trigger calculation below the pinned section, and increase vertical height of the right-hand Philosophy video"
