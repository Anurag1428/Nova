            lines {
              text: "  introduction: {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    kicker: \'THE SANCTUARY\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    headline:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'At Nova, we believe beauty is a personal expression of who you are. Step into our sanctuary for unhurried rituals shaped around your natural rhythm.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    body:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'True radiance rarely comes from haste. Every appointment begins with attentive listening\342\200\224observing how you live, how your skin responds to the season, and what brings you a sense of calm restoration.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
