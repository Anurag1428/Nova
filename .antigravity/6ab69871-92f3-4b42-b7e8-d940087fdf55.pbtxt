      name: "run_command"
      arguments_json: "{\"CommandLine\":\"trap \'playwright-cli close\' EXIT\\nplaywright-cli open --browser=chromium \\\"http://localhost:3000?autostart=1\\\" && \\\\\\n  playwright-cli resize 1440 900 && \\\\\\n  playwright-cli run-code \'async (page) => {\\n    const navBtn = page.locator(\\\"nav[aria-label=\\\\\\\"Opening Horizon Navigation\\\\\\\"] button\\\", { hasText: \\\"Treatments\\\" });\\n    await navBtn.click();\\n    await page.waitForFunction(\\n      () => document.querySelector(\\\"#top\\\")?.getAttribute(\\\"data-view\\\") === \\\"treatments\\\" &&\\n            document.querySelector(\\\"[data-testid=\\\\\\\"page-transition-curtain\\\\\\\"]\\\")?.getAttribute(\\\"data-transition-phase\\\") === \\\"idle\\\",\\n      null,\\n      { timeout: 12000 }\\n    );\\n\\n    // 1. Check Modalities + crisp navy NOVA header\\n    await page.evaluate(() => {\\n      const el = document.querySelector(\\\"[data-testid=\\\\\\\"treatments-modalities\\\\\\\"]\\\");\\n      if (el) window.scrollTo(0, el.offsetTop + 190);\\n    });\\n    await page.waitForTimeout(550);\\n    const novaColor = await page.getByTestId(\\\"header-nova-wordmark\\\").evaluate((el) => getComputedStyle(el).color);\\n    await page.screenshot({ path: \\\".playwright-cli/t2-modalities.png\\\" });\\n\\n    // 2. Check Your Journey + Macro Diptych\\n    await page.evaluate(() => {\\n      const el = document.querySelector(\\\"[data-testid=\\\\\\\"treatments-journey\\\\\\\"]\\\");\\n      if (el) window.scrollTo(0, el.offsetTop + 260);\\n    });\\n    await page.waitForTimeout(450);\\n    await page.screenshot({ path: \\\".playwright-cli/t2-journey.png\\\" });\\n\\n    // 3. Mobile responsive check (390x844)\\n    await page.setViewportSize({ width: 390, height: 844 });\\n    await page.evaluate(() => {\\n      const el = document.querySelector(\\\"[data-testid=\\\\\\\"treatments-modalities\\\\\\\"]\\\");\\n      if (el) window.scrollTo(0, el.offsetTop + 80);\\n    });\\n    await page.waitForTimeout(450);\\n    const hasHorizontalOverflow = await page.evaluate(\\n      () => document.documentElement.scrollWidth > window.innerWidth\\n    );\\n    await page.screenshot({ path: \\\".playwright-cli/t2-mobile.png\\\" });\\n\\n    return JSON.stringify({ novaColor, hasHorizontalOverflow });\\n  }\' && \\\\\\n  playwright-cli console\", \"Cwd\":\".\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Verifying Treatments polish and mobile layout\", \"toolSummary\":\"Verify final Treatments captures\"}"
