    combined_output {
      full: "v4 complete!"
    }
    command_line: "python3 -c \'\nimport subprocess\n\n# Step 1: Extract raw UNMODIFIED face region from original photo (zero clone stamping!)\nsubprocess.check_call([\n    \"convert\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\",\n    \"-crop\", \"200x220+268+288\", \"+repage\",\n    \"-blur\", \"0x0.25\",\n    \"-filter\", \"Lanczos\", \"-resize\", \"320x352!\",\n    \"-channel\", \"R\", \"-gamma\", \"0.78\", \"-evaluate\", \"multiply\", \"0.855\",\n    \"-channel\", \"G\", \"-gamma\", \"1.00\", \"-evaluate\", \"multiply\", \"1.005\",\n    \"-channel\", \"B\", \"-gamma\", \"1.30\", \"-evaluate\", \"multiply\", \"0.985\",\n    \"+channel\",\n    \"-modulate\", \"100,88,100\",\n    \"-attenuate\", \"0.09\", \"+noise\", \"Gaussian\",\n    \".playwright-cli/face_color4.png\"\n])\n\n# Step 2: Build soft feathered elliptical face mask AND knock out ONLY the tiny red tilak oval on the forehead\n# Tilak center in raw crop (200x220) was (94, 95) -> after 1.60x scale: (150, 152)!\n# Eyebrows are at y ~ 166..172, so knocking out a soft 11x13 oval centered at (150, 148) cleanly lets\n# the spotless studio forehead skin from the base portrait show through WITHOUT touching eyebrows or eyes!\nsubprocess.check_call([\n    \"convert\", \"-size\", \"320x352\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"translate 163,195 rotate -8 ellipse 0,0 56,71 0,360\",\n    \"-blur\", \"0x11\",\n    \"(\", \"-size\", \"320x352\", \"xc:white\",\n         \"-fill\", \"black\",\n         \"-draw\", \"ellipse 150,148 11,13 0,360\",\n         \"-blur\", \"0x5.5\",\n    \")\",\n    \"-compose\", \"Multiply\", \"-composite\",\n    \".playwright-cli/face_mask4.png\"\n])\n\n# Step 3: Composite cleanly onto studio editorial portrait\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_faithful_1795347756012.jpg\",\n    \"(\", \".playwright-cli/face_color4.png\", \".playwright-cli/face_mask4.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+271+134\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_real_face.jpg\"\n])\n\n# Step 4: Side-by-side close-up comparison\nsubprocess.check_call([\n    \"convert\",\n    \"(\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\", \"-crop\", \"180x210+280+310\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"(\", \"src/assets/images/owner_portrait_real_face.jpg\", \"-crop\", \"288x336+292+176\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"+append\", \".playwright-cli/face_compare_v4.jpg\"\n])\nprint(\"v4 complete!\")\n\'"
    proposed_command_line: "python3 -c \'\nimport subprocess\n\n# Step 1: Extract raw UNMODIFIED face region from original photo (zero clone stamping!)\nsubprocess.check_call([\n    \"convert\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\",\n    \"-crop\", \"200x220+268+288\", \"+repage\",\n    \"-blur\", \"0x0.25\",\n    \"-filter\", \"Lanczos\", \"-resize\", \"320x352!\",\n    \"-channel\", \"R\", \"-gamma\", \"0.78\", \"-evaluate\", \"multiply\", \"0.855\",\n    \"-channel\", \"G\", \"-gamma\", \"1.00\", \"-evaluate\", \"multiply\", \"1.005\",\n    \"-channel\", \"B\", \"-gamma\", \"1.30\", \"-evaluate\", \"multiply\", \"0.985\",\n    \"+channel\",\n    \"-modulate\", \"100,88,100\",\n    \"-attenuate\", \"0.09\", \"+noise\", \"Gaussian\",\n    \".playwright-cli/face_color4.png\"\n])\n\n# Step 2: Build soft feathered elliptical face mask AND knock out ONLY the tiny red tilak oval on the forehead\n# Tilak center in raw crop (200x220) was (94, 95) -> after 1.60x scale: (150, 152)!\n# Eyebrows are at y ~ 166..172, so knocking out a soft 11x13 oval centered at (150, 148) cleanly lets\n# the spotless studio forehead skin from the base portrait show through WITHOUT touching eyebrows or eyes!\nsubprocess.check_call([\n    \"convert\", \"-size\", \"320x352\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"translate 163,195 rotate -8 ellipse 0,0 56,71 0,360\",\n    \"-blur\", \"0x11\",\n    \"(\", \"-size\", \"320x352\", \"xc:white\",\n         \"-fill\", \"black\",\n         \"-draw\", \"ellipse 150,148 11,13 0,360\",\n         \"-blur\", \"0x5.5\",\n    \")\",\n    \"-compose\", \"Multiply\", \"-composite\",\n    \".playwright-cli/face_mask4.png\"\n])\n\n# Step 3: Composite cleanly onto studio editorial portrait\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_faithful_1795347756012.jpg\",\n    \"(\", \".playwright-cli/face_color4.png\", \".playwright-cli/face_mask4.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+271+134\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_real_face.jpg\"\n])\n\n# Step 4: Side-by-side close-up comparison\nsubprocess.check_call([\n    \"convert\",\n    \"(\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\", \"-crop\", \"180x210+280+310\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"(\", \"src/assets/images/owner_portrait_real_face.jpg\", \"-crop\", \"288x336+292+176\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"+append\", \".playwright-cli/face_compare_v4.jpg\"\n])\nprint(\"v4 complete!\")\n\'"
