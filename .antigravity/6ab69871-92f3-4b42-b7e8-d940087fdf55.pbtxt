    tool_calls {
      id: "call_13977094703704002651"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add pure step validation, upcoming date generator, and ritual preference note toggle helpers to bookingLogic.ts\", \"EndLine\":202, \"Instruction\":\"Append BookingStep, UpcomingDateOption, validateBookingStep, getUpcomingConsultationDates, and toggleRitualPreferenceNote to src/utils/bookingLogic.ts\", \"ReplacementContent\":\"  return {\\n    ...input,\\n    clientName: input.clientName.trim(),\\n    clientEmail: input.clientEmail.trim(),\\n    clientPhone: input.clientPhone.trim(),\\n    notes: input.notes.trim(),\\n    referenceCode,\\n    categoryTitle,\\n    ritualName,\\n    duration,\\n    examplePrice,\\n    createdAtIso: now.toISOString(),\\n  };\\n}\\n\\nexport type BookingStep = 1 | 2 | 3;\\n\\nexport interface UpcomingDateOption {\\n  iso: string;\\n  weekday: string;\\n  dayNum: string;\\n  monthShort: string;\\n  displayLabel: string;\\n}\\n\\nexport const RITUAL_PREFERENCE_TAGS = [\\n  \'Quiet silent ritual\',\\n  \'Sensitive skin\',\\n  \'Bridal timeline\',\\n  \'Fragrance-free\',\\n] as const;\\n\\n/**\\n * Validates fields belonging to the active step of the guided consultation flow.\\n */\\nexport function validateBookingStep(\\n  step: BookingStep,\\n  input: BookingFormInput\\n): {\\n  isValid: boolean;\\n  errors: BookingValidationErrors;\\n} {\\n  const full = validateBookingForm(input);\\n  if (step === 1) {\\n    const errors: BookingValidationErrors = {};\\n    if (full.errors.categoryId) errors.categoryId = full.errors.categoryId;\\n    if (full.errors.ritualId) errors.ritualId = full.errors.ritualId;\\n    return { isValid: Object.keys(errors).length === 0, errors };\\n  }\\n  if (step === 2) {\\n    const errors: BookingValidationErrors = {};\\n    if (full.errors.preferredDate) errors.preferredDate = full.errors.preferredDate;\\n    if (full.errors.preferredTime) errors.preferredTime = full.errors.preferredTime;\\n    return { isValid: Object.keys(errors).length === 0, errors };\\n  }\\n  return full;\\n}\\n\\n/**\\n * Generates deterministic upcoming consultation date tiles starting from tomorrow.\\n */\\nexport function getUpcomingConsultationDates(\\n  count = 6,\\n  anchorDate: Date = new Date()\\n): UpcomingDateOption[] {\\n  const weekdays = [\'Sun\', \'Mon\', \'Tue\', \'Wed\', \'Thu\', \'Fri\', \'Sat\'];\\n  const months = [\'Jan\', \'Feb\', \'Mar\', \'Apr\', \'May\', \'Jun\', \'Jul\', \'Aug\', \'Sep\', \'Oct\', \'Nov\', \'Dec\'];\\n  const results: UpcomingDateOption[] = [];\\n\\n  const baseYear = anchorDate.getFullYear();\\n  const baseMonth = anchorDate.getMonth();\\n  const baseDay = anchorDate.getDate();\\n\\n  for (let offset = 1; offset <= count; offset++) {\\n    const d = new Date(baseYear, baseMonth, baseDay + offset);\\n    const yyyy = d.getFullYear();\\n    const mm = String(d.getMonth() + 1).padStart(2, \'0\');\\n    const dd = String(d.getDate()).padStart(2, \'0\');\\n    const weekday = weekdays[d.getDay()];\\n    const monthShort = months[d.getMonth()];\\n    const dayNum = String(d.getDate());\\n    results.push({\\n      iso: `${yyyy}-${mm}-${dd}`,\\n      weekday,\\n      dayNum,\\n      monthShort,\\n      displayLabel: offset === 1 ? \'Tomorrow\' : `${weekday}, ${dayNum} ${monthShort}`,\\n    });\\n  }\\n\\n  return results;\\n}\\n\\n/**\\n * Cleanly toggles a quick ritual preference phrase inside the guest notes field.\\n */\\nexport function toggleRitualPreferenceNote(currentNotes: string, preference: string): string {\\n  const parts = currentNotes\\n    .split(\'\302\267\')\\n    .map((part) => part.trim())\\n    .filter(Boolean);\\n\\n  const exists = parts.some((p) => p.toLowerCase() === preference.toLowerCase());\\n  const nextParts = exists\\n    ? parts.filter((p) => p.toLowerCase() !== preference.toLowerCase())\\n    : [...parts, preference];\\n\\n  return nextParts.join(\' \302\267 \');\\n}\\n\", \"StartLine\":188, \"TargetContent\":\"  return {\\n    ...input,\\n    clientName: input.clientName.trim(),\\n    clientEmail: input.clientEmail.trim(),\\n    clientPhone: input.clientPhone.trim(),\\n    notes: input.notes.trim(),\\n    referenceCode,\\n    categoryTitle,\\n    ritualName,\\n    duration,\\n    examplePrice,\\n    createdAtIso: now.toISOString(),\\n  };\\n}\", \"TargetFile\":\"/src/utils/bookingLogic.ts\", \"toolAction\":\"Adding guided consultation helpers to bookingLogic.ts\", \"toolSummary\":\"Add consultation step helpers\"}"
      thinking_signature: "\022\271[\n\266[\001i\024}\023\272\376e\305\330\240\256\245\272w*\304\266\251J\277\211\016R-z\352\260\3234\275\004M\265Y\344\2746\375k\017\320\027\374\204n>Q0\031\023\t\363\256\037\304YV\224\245UZ\332\306\353\304\331\347]\312\027%\v\241\241,\177\231,u\217)\326\267\272\027\373DR$\221/6\227\326\352\314]\271\302\031\255/\341\3534\276\243=\021^}}\325\343\367\350VNX\264\341\b\222\260\217@L\203y\332(\216\246Z9\033\372\337\372\251\344\364\311\202\275vr\263\326;S\274\307\364@:4\325\245\370e\b\025\376\207\206\375\250=o\0366\tN\342\337>\256\317\033\312\0173\032!\372\334\026\251p\305e\362\037!\300\nD\306\247\tv\326\255\251\267\313\347\037\034\016\310p\254\004\303\235\020\364\316\201\375k<x\316D-f\202\245\337\t\356O\271\323VrHK=\232\227\245Z\362\341\251\207\3014\257\251\262\205\277\026B\024\250\177\245\374\240@\307\252 \312\211F\212Tni\267\352\021d\342\255[\371\025\335\273\201\363j\211\317r\332\t\345?y\325=R\327\3222\206\210i\346s\352\256\306\213\0275\363/r\314\352M\001\221m\347\220\250m\277\026\201\250\367\270^\313E\006\253\365\337\344\374A\032\307\362XNw\306\371\205];\261\002\374\202\324\003\374/y6\002l\265=\305\245s\247p\230Z\327\303\354\313\227Q\301\b\341\243\361\320u`D\0160k\371\265~\265s\036T\177\a\301\247\300\200\330\241Y\036\261\267\333\336\257\356,pB\253c1\350:\027\024\347\300\002\267C\326\217\337\016\360qQ\022\f\237\377\373M\326#C\317p\253\302U\025\315\236\330\362!5Q\322\255\a1\251\366\0223\222Yj\345\034\376\260\003\212QbI\300z\205\336\037\327\342\214\353;\037c\200\305\263\037q\242d\022\307}\032\255\t\200(t\304\021\324o\272$~\204\240\357\214\024\361\330\367\212\250Cc.\372\241`\255\027\320(\313\234\372\347(zH\005\210\021E|\230i\2532\031?R\354Da\373p_I>\356\242tPP%z\211\371\342\367\213\022\373g\016\306\027yu7*ln(\342:\004\323\317+\353?\275P\034\351\267\277\366\370\021~%\327|%h\034\227\035\251S\003\377\263{\304\\\251!T-l\376y\366ZA_\303\323\025.\323\261\026\255\224\256\275\242\204h%\354\237\274\354\034\311\260\035a\224\346\245\260\240\371\212\2