          target_content: "  about: {\n    heroKicker: \'ABOUT NOVA\',\n    heroTitle: \'A quiet house devoted to unhurried beauty rituals.\',\n    storyParagraphs: [\n      \'Conceived as an intimate alternative to high-turnover salons, NOVA was created for guests who value stillness as much as craft. Our space pairs warm limewashed walls, natural travertine stone, and filtered daylight to soften the transition from the outside world.\',\n      \'All practitioner profiles below use editable placeholder names and biographies so the salon owner can insert real team members before publishing.\',\n    ],\n    atmosphereHighlights: [\n      {\n        label: \'Private Suites\',\n        detail: \'Quiet, individually climate-tuned rooms designed for uninterrupted rest.\',\n      },\n      {\n        label: \'Considered Formulations\',\n        detail: \'Curated botanical oils, barrier-supportive creams, and breathable nail systems.\',\n      },\n      {\n        label: \'Unhurried Scheduling\',\n        detail: \'Generous buffer time between appointments so you never feel rushed at reception.\',\n      },\n    ],\n    team: [\n      {\n        id: \'member-1\',\n        name: \'Nova\',\n        role: \'Founder & Lead Aesthetician\',\n        specialty: \'Sculptural Facial Massage & Bespoke Skin Architecture\',\n        bio: \'Founder of NOVA Unisex Salon. Specializes in slow manual facial contouring, barrier restoration, and guiding clients toward effortless, enduring skin health.\',\n        image: \'/images/chapter-2-tailored.jpg\',\n        alt: \'Portrait of Nova, Founder & Lead Aesthetician\',\n        isPlaceholder: false,\n      },\n      {\n        id: \'member-2\',\n        name: \'Sora Takahashi (Placeholder)\',\n        role: \'Senior Nail Artist & Ritual Specialist\',\n        specialty: \'Natural Nail Health & Minimalist Editorial Art\',\n        bio: \'Editable biography placeholder: Focused on meticulous cuticle care, custom-blended sheer tones, and restorative hand and foot treatments.\',\n        image: \'/images/team-2.jpg\',\n        alt: \'Portrait placeholder for Senior Nail Artist\',\n        isPlaceholder: true,\n      },\n      {\n        id: \'member-3\',\n        name: \'Elena Vance (Placeholder)\',\n        role: \'Principal Bridal & Editorial Makeup Artist\',\n        specialty: \'Luminous Skin-First Complexion Artistry\',\n        bio: \'Editable biography placeholder: Dedicated to breathable, natural-looking makeup for brides, private clients, and editorial commissions.\',\n        image: \'/images/team-3.jpg\',\n        alt: \'Portrait placeholder for Principal Makeup Artist\',\n        isPlaceholder: true,\n      },\n    ] satisfies TeamMember[],\n  },"
          replacement_content: "  about: {\n    heroKicker: \'ABOUT\',\n    heroTitleLeft: \'Evolving\',\n    heroTitleRight: \'with you.\',\n    heroInsetCaption:\n      \'A restorative space delivering timeless beauty through a long term partnership\',\n    heroTitle: \'A quiet house devoted to unhurried beauty rituals.\',\n    manifesto:\n      \'is founded upon a philosophy of integrity and quiet artistry in hair, skin, and bridal beauty. This manifests in bespoke treatments, a timeless approach rather than following trends, and maintaining a long-lasting relationship with our guests throughout their beauty journey. We understand that what makes you feel radiant evolves with every season of life, and we are here to support and guide you through these natural stages.\',\n    founder: {\n      label: \'Founder & Owner\',\n      title: \'Founder of NOVA Unisex Salon\',\n      specialty: \'Bespoke Skin Architecture, Hair Artistry & Bridal Direction\',\n      bio: \'Founded with a devotion to calm precision and personal care, she leads NOVA\342\200\231s signature consultations and bespoke rituals\342\200\224blending refined technique with unhurried hospitality at our Kingship by Kahlon sanctuary in Lucknow.\',\n      consultationCaption: \'Personal ritual planning & tailored beauty consultations\',\n    },\n    storyParagraphs: [\n      \'Conceived as an intimate alternative to high-turnover salons, NOVA was created for guests who value stillness as much as craft. Our space pairs warm limewashed walls, natural travertine stone, and filtered daylight to soften the transition from the outside world.\',\n      \'Every visit begins with attentive listening\342\200\224tailoring skin rituals, hair artistry, nail care, and bridal looks around your natural features and lifestyle.\',\n    ],\n    atmosphereHighlights: [\n      {\n        label: \'Private Suites\',\n        detail: \'Quiet, individually climate-tuned rooms designed for uninterrupted rest.\',\n      },\n      {\n        label: \'Considered Formulations\',\n        detail: \'Curated botanical oils, barrier-supportive creams, and breathable nail systems.\',\n      },\n      {\n        label: \'Unhurried Scheduling\',\n        detail: \'Generous buffer time between appointments so you never feel rushed at reception.\',\n      },\n    ],\n    team: [\n      {\n        id: \'member-1\',\n        name: \'Founder of NOVA\',\n        role: \'Founder & Owner\',\n        specialty: \'Bespoke Skin Architecture & Bridal Artistry\',\n        bio: \'Founder & Owner of NOVA Unisex Salon. Leads private consultations, barrier-first skincare rituals, and bespoke bridal direction with calm, unhurried precision.\',\n        image: \'/images/chapter-2-tailored.jpg\',\n        alt: \'Editorial portrait of the Founder and Owner of NOVA Unisex Salon\',\n        isPlaceholder: false,\n      },\n    ] satisfies TeamMember[],\n  },"
