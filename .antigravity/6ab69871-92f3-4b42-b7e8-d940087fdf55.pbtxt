              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    data-testid={`modality-media-${cat.id}`}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    data-slide-role={slide?.role ?? \'upcoming\'}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    data-slide-opacity={slide?.opacity ?? 0}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    data-slide-clip={topEdge}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    aria-hidden={!slide?.isVisible}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    className=\"absolute inset-0 h-full w-full overflow-hidden\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    style={{"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      zIndex: slide?.zIndex ?? idx + 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      opacity: slide?.opacity ?? 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      transform: slide"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        ? `translate3d(0, ${slide.translateYPercent}%, 0) scale(${slide.scale})`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        : \'translate3d(0, 14%, 0) scale(1.09)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      filter: filterValue,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      maskImage: maskGradient,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      WebkitMaskImage: maskGradient,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      visibility: slide?.isVisible ? \'visible\' : \'hidden\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      pointerEvents: slide?.role === \'active\' ? \'auto\' : \'none\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    }}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
