              text: "            >"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              {categories.map((cat, idx) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                const editorialMedia = CATEGORY_EDITORIAL_MEDIA[cat.id] || cat.media;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                const slide = modalityDeck.slides[idx];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                const topEdge = slide?.clipTopPercent ?? 100;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                const featherBand = (slide?.featherProgress ?? 0) * 24;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                // Soft feathered leading edge so incoming media melts smoothly into the vanishing visual beneath"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                const maskGradient ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  featherBand > 0.4"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    ? `linear-gradient(to bottom, transparent ${Math.max("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        topEdge - 1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      )}%, rgba(0,0,0,0.52) ${Math.min("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        100,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        topEdge + featherBand * 0.45"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      )}%, black ${Math.min(100, topEdge + featherBand)}%, black 100%)`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    : topEdge > 0.5"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      ? `linear-gradient(to bottom, transparent ${topEdge}%, black ${topEdge}%)`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      : undefined;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                const filterValue ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  slide && slide.blurPx > 0.08 ? `blur(${slide.blurPx}px)` : undefined;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                return ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  <div"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
