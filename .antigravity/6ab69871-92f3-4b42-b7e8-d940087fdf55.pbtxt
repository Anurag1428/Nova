or x, y in pts_240)\\ntilak_x = round(102 * scale)\\ntilak_y = round(73 * scale)\\n\\nsubprocess.check_call([\\n    \\\"convert\\\", \\\"-size\\\", f\\\"{S}x{S}\\\", \\\"xc:black\\\",\\n    \\\"-fill\\\", \\\"white\\\",\\n    \\\"-draw\\\", f\\\"polygon {poly_str}\\\",\\n    \\\"-blur\\\", \\\"0x5.5\\\",\\n    \\\"(\\\", \\\"-size\\\", f\\\"{S}x{S}\\\", \\\"xc:white\\\",\\n         \\\"-fill\\\", \\\"black\\\",\\n         \\\"-draw\\\", f\\\"ellipse {tilak_x},{tilak_y} 13,15 0,360\\\",\\n         \\\"-blur\\\", \\\"0x6\\\",\\n    \\\")\\\",\\n    \\\"-compose\\\", \\\"Multiply\\\", \\\"-composite\\\",\\n    \\\".playwright-cli/cheek_fixed_mask.png\\\"\\n])\\n\\n# Step 3: Composite cleanly onto base_clean_neck2.png at exact same +254+166 offset\\nsubprocess.check_call([\\n    \\\"convert\\\", \\\".playwright-cli/base_clean_neck2.png\\\",\\n    \\\"(\\\", \\\".playwright-cli/exact3_shaded.png\\\", \\\".playwright-cli/cheek_fixed_mask.png\\\",\\n         \\\"-alpha\\\", \\\"off\\\", \\\"-compose\\\", \\\"CopyOpacity\\\", \\\"-composite\\\", \\\")\\\",\\n    \\\"-geometry\\\", \\\"+254+166\\\", \\\"-compose\\\", \\\"Over\\\", \\\"-composite\\\",\\n    \\\"-quality\\\", \\\"95\\\",\\n    \\\"src/assets/images/owner_portrait_clean_cheeks.jpg\\\"\\n])\\n\\n# Step 4: Save tight zoomed crop to inspect BOTH outer cheek edges at full HD zoom!\\nsubprocess.check_call([\\n    \\\"convert\\\", \\\"src/assets/images/owner_portrait_clean_cheeks.jpg\\\",\\n    \\\"-crop\\\", \\\"420x260+230+205\\\", \\\"+repage\\\",\\n    \\\".playwright-cli/cheek_zoom_check.png\\\"\\n])\\nprint(\\\"Cheek edge fix complete!\\\")\\n\'\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Smoothing outer cheek edges and studio side shading\", \"toolSummary\":\"Fix outer cheek edges\"}"
