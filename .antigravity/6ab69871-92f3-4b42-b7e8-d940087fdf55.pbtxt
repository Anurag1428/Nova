    command_line: "python3 -c \'\nimport subprocess\n\nscale = 1.64\nS = int(round(240 * scale)) # 394\n\n# Keep hair strands 100% crisp on the left! Only gently smooth the center-chin shadow on base_warm2 (NO dark blob touching hair/neck!)\nneck_rgb = \"rgb(176,122,88)\"\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/base_warm2.png\",\n    \"(\", \"-size\", \"848x1264\", \"xc:none\",\n         \"-fill\", neck_rgb,\n         \"-draw\", \"ellipse 442,418 32,12 0,360\",\n         \"-blur\", \"0x7\",\n    \")\", \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/base_clean_neck2.png\"\n])\n\n# Refined polygon: extends smoothly across her real chin & real upper neck, while hugging her real jawline tightly on the viewer-left\n# so crisp natural hair strands from the base portrait frame her left jaw cleanly with ZERO smudge!\npts_240 = [\n    (81, 56), (105, 48), (128, 51), (144, 62), (151, 80),\n    (152, 102), (149, 122), (144, 137), (145, 152), (144, 164),\n    (124, 166), (106, 164), (101, 150), (93, 144),\n    (84, 134), (79, 118), (77, 94), (79, 72)\n]\npoly_str = \" \".join(f\"{round(x*scale)},{round(y*scale)}\" for x, y in pts_240)\ntilak_x = round(102 * scale)\ntilak_y = round(73 * scale)\n\nsubprocess.check_call([\n    \"convert\", \"-size\", f\"{S}x{S}\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", f\"polygon {poly_str}\",\n    \"-blur\", \"0x6.5\",\n    \"(\", \"-size\", f\"{S}x{S}\", \"xc:white\",\n         \"-fill\", \"black\",\n         \"-draw\", f\"ellipse {tilak_x},{tilak_y} 13,15 0,360\",\n         \"-blur\", \"0x6\",\n    \")\",\n    \"-compose\", \"Multiply\", \"-composite\",\n    \".playwright-cli/neck_fixed_mask2.png\"\n])\n\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/base_clean_neck2.png\",\n    \"(\", \".playwright-cli/exact2_scaled.png\", \".playwright-cli/neck_fixed_mask2.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+254+166\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_clean_neck_v2.jpg\"\n])\n\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_clean_neck_v2.jpg\",\n    \"-crop\", \"420x260+230+205\", \"+repage\",\n    \".playwright-cli/neck_zoom_check2.png\"\n])\nprint(\"Clean neck v2 complete!\")\n\'"
    proposed_command_line: "python3 -c \'\nimport subprocess\n\nscale = 1.64\nS = int(round(240 * scale)) # 394\n\n# Keep hair strands 100% crisp on the left! Only gently smooth the center-chin shadow on base_warm2 (NO dark blob touching hair/neck!)\nneck_rgb = \"rgb(176,122,88)\"\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/base_warm2.png\",\n    \"(\", \"-size\", \"848x1264\", \"xc:none\",\n         \"-fill\", neck_rgb,\n         \"-draw\", \"ellipse 442,418 32,12 0,360\",\n         \"-blur\", \"0x7\",\n    \")\", \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/base_clean_neck2.png\"\n])\n\n# Refined polygon: extends smoothly across her real chin & real upper neck, while hugging her real jawline tightly on the viewer-left\n# so crisp natural hair strands from the base portrait frame her left jaw cleanly with ZERO smudge!\npts_240 = [\n    (81, 56), (105, 48), (128, 51), (144, 62), (151, 80),\n    (152, 102), (149, 122), (144, 137), (145, 152), (144, 164),\n    (124, 166), (106, 164), (101, 150), (93, 144),\n    (84, 134), (79, 118), (77, 94), (79, 72)\n]\npoly_str = \" \".join(f\"{round(x*scale)},{round(y*scale)}\" for x, y in pts_240)\ntilak_x = round(102 * scale)\ntilak_y = round(73 * scale)\n\nsubprocess.check_call([\n    \"convert\", \"-size\", f\"{S}x{S}\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", f\"polygon {poly_str}\",\n    \"-blur\", \"0x6.5\",\n    \"(\", \"-size\", f\"{S}x{S}\", \"xc:white\",\n         \"-fill\", \"black\",\n         \"-draw\", f\"ellipse {tilak_x},{tilak_y} 13,15 0,360\",\n         \"-blur\", \"0x6\",\n    \")\",\n    \"-compose\", \"Multiply\", \"-composite\",\n    \".playwright-cli/neck_fixed_mask2.png\"\n])\n\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/base_clean_neck2.png\",\n    \"(\", \".playwright-cli/exact2_scaled.png\", \".playwright-cli/neck_fixed_mask2.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+254+166\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_clean_neck_v2.jpg\"\n])\n\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_clean_neck_v2.jpg\",\n    \"-crop\", \"420x260+230+205\", \"+repage\",\n    \".playwright-cli/neck_zoom_check2.png\"\n])\nprint(\"Clean neck v2 complete!\")\n\'"
