    wait_ms_before_async: 10000
    combined_output {
      full: "v6 calibrated cheek RGB: 221,155,110 (target gen cheek: 203,151,125)v6 complete!"
    }
    command_line: "python3 -c \'\nimport subprocess\n\n# Step 1: Extract raw unmodified face crop from original photo (200x220+268+288)\n# Apply gentle photographic white-balance (NO harsh blue gamma that creates purple eye/nostril tints!)\n# Shift hue slightly warmer-golden (+2.2 in ImageMagick 0..200 scale where 100 is neutral), reduce orange saturation to 82%,\n# gently tame R highlight and lift B only slightly (1.06) so whites of eyes stay pure white and blacks stay pure black!\nsubprocess.check_call([\n    \"convert\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\",\n    \"-crop\", \"200x220+268+288\", \"+repage\",\n    \"-filter\", \"Lanczos\", \"-resize\", \"320x352!\",\n    \"-modulate\", \"96,80,102.4\",\n    \"-channel\", \"R\", \"-gamma\", \"0.86\", \"-evaluate\", \"multiply\", \"0.94\",\n    \"-channel\", \"G\", \"-gamma\", \"0.98\", \"-evaluate\", \"multiply\", \"1.00\",\n    \"-channel\", \"B\", \"-gamma\", \"1.08\", \"-evaluate\", \"multiply\", \"1.04\",\n    \"+channel\",\n    \"-sigmoidal-contrast\", \"2.2,52%\",\n    \"-attenuate\", \"0.08\", \"+noise\", \"Gaussian\",\n    \".playwright-cli/face_color6.png\"\n])\n\nrgb_check = subprocess.check_output([\n    \"convert\", \".playwright-cli/face_color6.png\", \"-crop\", \"24x24+182+190\", \"+repage\",\n    \"-resize\", \"1x1!\", \"-format\", \"%[fx:int(255*r)],%[fx:int(255*g)],%[fx:int(255*b)]\", \"info:\"\n]).decode().strip()\nprint(\"v6 calibrated cheek RGB:\", rgb_check, \"(target gen cheek: 203,151,125)\")\n\n# Step 2: Build precision feathered face mask that keeps 100% of her real eyes, brows, nose, cheeks, lips, and chin\n# while smoothly feathering into the studio hairline & jaw shadow AND cleanly letting studio forehead skin cover the tiny tilak\nsubprocess.check_call([\n    \"convert\", \"-size\", \"320x352\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"translate 162,197 rotate -8 ellipse 0,0 53,68 0,360\",\n    \"-blur\", \"0x10\",\n    \"(\", \"-size\", \"320x352\", \"xc:white\",\n         \"-fill\", \"black\",\n         \"-draw\", \"ellipse 150,146 13,15 0,360\",\n         \"-blur\", \"0x6\",\n    \")\",\n    \"-compose\", \"Multiply\", \"-composite\",\n    \".playwright-cli/face_mask6.png\"\n])\n\n# Step 3: Composite cleanly onto studio editorial portrait\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_faithful_1795347756012.jpg\",\n    \"(\", \".playwright-cli/face_color6.png\", \".playwright-cli/face_mask6.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+271+134\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_studio_real.jpg\"\n])\n\n# Step 4: Side-by-side close-up comparison\nsubprocess.check_call([\n    \"convert\",\n    \"(\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\", \"-crop\", \"180x210+280+310\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"(\", \"src/assets/images/owner_portrait_studio_real.jpg\", \"-crop\", \"288x336+292+176\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"+append\", \".playwright-cli/face_compare_v6.jpg\"\n])\nprint(\"v6 complete!\")\n\'"
    proposed_command_line: "python3 -c \'\nimport subprocess\n\n# Step 1: Extract raw unmodified face crop from original photo (200x220+268+288)\n# Apply gentle photographic white-balance (NO harsh blue gamma that creates purple eye/nostril tints!)\n# Shift hue slightly warmer-golden (+2.2 in ImageMagick 0..200 scale where 100 is neutral), reduce orange saturation to 82%,\n# gently tame R highlight and lift B only slightly (1.06) so whites of eyes stay pure white and blacks stay pure black!\nsubprocess.check_call([\n    \"convert\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\",\n    \"-crop\", \"200x220+268+288\", \"+repage\",\n    \"-filter\", \"Lanczos\", \"-resize\", \"320x352!\",\n    \"-modulate\", \"96,80,102.4\",\n    \"-channel\", \"R\", \"-gamma\", \"0.86\", \"-evaluate\", \"multiply\", \"0.94\",\n    \"-channel\", \"G\", \"-gamma\", \"0.98\", \"-evaluate\", \"multiply\", \"1.00\",\n    \"-channel\", \"B\", \"-gamma\", \"1.08\", \"-evaluate\", \"multiply\", \"1.04\",\n    \"+channel\",\n    \"-sigmoidal-contrast\", \"2.2,52%\",\n    \"-attenuate\", \"0.08\", \"+noise\", \"Gaussian\",\n    \".playwright-cli/face_color6.png\"\n])\n\nrgb_check = subprocess.check_output([\n    \"convert\", \".playwright-cli/face_color6.png\", \"-crop\", \"24x24+182+190\", \"+repage\",\n    \"-resize\", \"1x1!\", \"-format\", \"%[fx:int(255*r)],%[fx:int(255*g)],%[fx:int(255*b)]\", \"info:\"\n]).decode().strip()\nprint(\"v6 calibrated cheek RGB:\", rgb_check, \"(target gen cheek: 203,151,125)\")\n\n# Step 2: Build precision feathered face mask that keeps 100% of her real eyes, brows, nose, cheeks, lips, and chin\n# while smoothly feathering into the studio hairline & jaw shadow AND cleanly letting studio forehead skin cover the tiny tilak\nsubprocess.check_call([\n    \"convert\", \"-size\", \"320x352\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"translate 162,197 rotate -8 ellipse 0,0 53,68 0,360\",\n    \"-blur\", \"0x10\",\n    \"(\", \"-size\", \"320x352\", \"xc:white\",\n         \"-fill\", \"black\",\n         \"-draw\", \"ellipse 150,146 13,15 0,360\",\n         \"-blur\", \"0x6\",\n    \")\",\n    \"-compose\", \"Multiply\", \"-composite\",\n    \".playwright-cli/face_mask6.png\"\n])\n\n# Step 3: Composite cleanly onto studio editorial portrait\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_faithful_1795347756012.jpg\",\n    \"(\", \".playwright-cli/face_color6.png\", \".playwright-cli/face_mask6.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+271+134\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_studio_real.jpg\"\n])\n\n# Step 4: Side-by-side close-up comparison\nsubprocess.check_call([\n    \"convert\",\n    \"(\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\", \"-crop\", \"180x210+280+310\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"(\", \"src/assets/images/owner_portrait_studio_real.jpg\", \"-crop\", \"288x336+292+176\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"+append\", \".playwright-cli/face_compare_v6.jpg\"\n])\nprint(\"v6 complete!\")\n\'"
