    action_spec {
      command {
        instruction: "Update scroll listener in Header.tsx to support light-over-hero state on both Treatments and About pages"
        is_edit: true
        file {
          absolute_uri: "file:///src/components/Header.tsx"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "  const [isOverTreatmentsVideo, setIsOverTreatmentsVideo] = useState(false);\n  const [menuOpen, setMenuOpen] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      // Home: transition into compact white top header after both full-screen hero stages\n      setIsScrolled(window.scrollY > window.innerHeight * 1.88);\n      // Treatments: stay transparent ivory while over the 190vh dark opening video hero\n      setIsOverTreatmentsVideo(\n        activePage === \'treatments\' && window.scrollY < window.innerHeight * 1.78\n      );\n    };\n    handleScroll();\n    window.addEventListener(\'scroll\', handleScroll, { passive: true });\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, [activePage]);\n\n  const showCompactBar = isScrolled || activePage !== \'home\';\n  const useLightOverVideo = activePage === \'treatments\' && isOverTreatmentsVideo;"
          replacement_content: "  const [isOverHeroMedia, setIsOverHeroMedia] = useState(false);\n  const [menuOpen, setMenuOpen] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      // Home: transition into compact white top header after both full-screen hero stages\n      setIsScrolled(window.scrollY > window.innerHeight * 1.88);\n      // Treatments & About: stay transparent ivory while over their full-bleed opening hero media\n      const overTreatmentsHero =\n        activePage === \'treatments\' && window.scrollY < window.innerHeight * 1.78;\n      const overAboutHero =\n        activePage === \'about\' && window.scrollY < window.innerHeight * 0.86;\n      setIsOverHeroMedia(overTreatmentsHero || overAboutHero);\n    };\n    handleScroll();\n    window.addEventListener(\'scroll\', handleScroll, { passive: true });\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, [activePage]);\n\n  const showCompactBar = isScrolled || activePage !== \'home\';\n  const useLightOverVideo =\n    (activePage === \'treatments\' || activePage === \'about\') && isOverHeroMedia;"
          start_line: 21
          end_line: 42
        }
      }
    }
