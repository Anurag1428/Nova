th,\n    };\n  });\n  await page.screenshot({ path: \".playwright-cli/menu-desktop.png\" });\n\n  // Verify clicking 5. Book Consultation opens Booking Drawer & closes Menu\n  await page.locator(\"[data-testid=nova-menu-drawer] nav button\", { hasText: \"Book Consultation\" }).click();\n  await page.waitForTimeout(500);\n  const bookingOpened = await page.getByRole(\"dialog\", { name: /Book/i }).isVisible().catch(async () => {\n    return await page.getByRole(\"dialog\").isVisible();\n  });\n  // Close booking drawer via Escape\n  await page.keyboard.press(\"Escape\");\n  await page.waitForTimeout(300);\n\n  // Re-open Menu and verify Close button closes it cleanly\n  await page.getByRole(\"navigation\", { name: \"Main Navigation\" }).getByRole(\"button\", { name: \"Menu\" }).click();\n  await page.waitForSelector(\"[data-testid=nova-menu-drawer][data-state=open]\", { timeout: 5000 });\n  await page.waitForTimeout(450);\n  await page.getByRole(\"button\", { name: \"Close navigation menu\" }).click();\n  await page.waitForTimeout(500);\n  const menuClosedCount = await page.locator(\"[data-testid=nova-menu-drawer]\").count();\n\n  // Re-open Menu and test navigation to About\n  await page.getByRole(\"navigation\", { name: \"Main Navigation\" }).getByRole(\"button\", { name: \"Menu\" }).click();\n  await page.waitForSelector(\"[data-testid=nova-menu-drawer][data-state=open]\", { timeout: 5000 });\n  await page.waitForTimeout(350);\n  await page.locator(\"[data-testid=nova-menu-drawer] nav button\", { hasText: \"About\" }).click();\n  await page.waitForFunction(() => document.getElementById(\"top\")?.getAttribute(\"data-view\") === \"about\", { timeout: 12000 });\n  await page.waitForFunction(() => {\n    const c = document.querySelector(\"[data-testid=page-transition-curtain]\");\n    return !c || c.getAttribute(\"data-transition-phase\") === \"idle\";\n  }, { timeout: 12000 });\n  const navigatedToAbout = await page.evaluate(() => document.getElementById(\"top\")?.getAttribute(\"data-view\"));\n\n  // Mobile 390x844 check\n  await page.setViewportSize({ width: 390, height: 844 });\n  await page.waitForTimeout(250);\n  await page.getByRole(\"button\", { name: \"Open navigation menu\" }).click();\n  await page.waitForSelector(\"[data-testid=nova-menu-drawer][data-state=open]\", { timeout: 5000 });\n  await page.waitForTimeout(600);\n  const mobileOverflow = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\n  await page.screenshot({ path: \".playwright-cli/menu-mobile.png\" });\n\n  console.log(\"MENU_VERIFY:\", JSON.stringify({\n    desktopCheck,\n    bookingOpened,\n    menuClosedCount,\n    navigatedToAbout,\n    mobileOverflow,\n  }));\n}\' && \\\nplaywright-cli console"
