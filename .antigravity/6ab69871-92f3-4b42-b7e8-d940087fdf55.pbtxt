      command {
        instruction: "Adjust word, o-nudge, and v-lift letter offsets for crisp clearance and zero overlap between O, V, and A"
        is_edit: true
        file {
          absolute_uri: "file:///src/utils/wordmarkMotion.ts"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "  switch (mode) {\n    case \'word\':\n      // Hovering NOVA as a whole: O rolls clockwise into the open cradle of V,\n      // V tilts warmly to catch O, and N/A step slightly outward for balance.\n      return {\n        N: { x: -2.5, y: 0, rotate: -2, scaleX: 1, scaleY: 1, accented: false },\n        O: { x: 6.5, y: -5.5, rotate: 210, scaleX: 0.96, scaleY: 0.96, accented: true },\n        V: { x: -2.5, y: 2.5, rotate: 9, scaleX: 1.05, scaleY: 0.94, accented: true },\n        A: { x: 2.5, y: 0, rotate: 2, scaleX: 1, scaleY: 1, accented: false },\n        sparkle: { opacity: 1, scale: 1.05, rotate: 25, y: -7 },\n      };\n\n    case \'o-nudge\':\n      // Hovering directly on O: O rolls forward and playfully bumps V like Newton\'s cradle,\n      // causing V to lean right and cushion the impact.\n      return {\n        N: { x: -3, y: 0, rotate: -3, scaleX: 1, scaleY: 1, accented: false },\n        O: { x: 9.5, y: -3, rotate: 360, scaleX: 1.06, scaleY: 0.94, accented: true },\n        V: { x: 2.5, y: 3, rotate: 16, scaleX: 0.96, scaleY: 1.04, accented: true },\n        A: { x: 4, y: 0, rotate: 4, scaleX: 1, scaleY: 1, accented: false },\n        sparkle: { opacity: 1, scale: 1.2, rotate: 45, y: -9 },\n      };\n\n    case \'v-lift\':\n      // Hovering directly on V: V tilts inward and springs upward to toss O\n      // into a graceful buoyant arc right above its notch.\n      return {\n        N: { x: -2.5, y: 0, rotate: -2, scaleX: 1, scaleY: 1, accented: false },\n        O: { x: 5.5, y: -11, rotate: -195, scaleX: 1.02, scaleY: 1.04, accented: true },\n        V: { x: -3.5, y: -2, rotate: -14, scaleX: 1.08, scaleY: 0.95, accented: true },\n        A: { x: 3, y: 0, rotate: 3, scaleX: 1, scaleY: 1, accented: false },\n        sparkle: { opacity: 1, scale: 1.15, rotate: -30, y: -12 },\n      };\n  }\n}"
          replacement_content: "  switch (mode) {\n    case \'word\':\n      // Hovering NOVA as a whole: O rolls clockwise toward V\'s cradle,\n      // V tilts warmly to catch O, and N/A step outward for clean clearance.\n      return {\n        N: { x: -3, y: 0, rotate: -2, scaleX: 1, scaleY: 1, accented: false },\n        O: { x: 3.5, y: -5, rotate: 180, scaleX: 0.98, scaleY: 0.98, accented: true },\n        V: { x: -1, y: 2, rotate: 7, scaleX: 1.04, scaleY: 0.96, accented: true },\n        A: { x: 4, y: 0, rotate: 2, scaleX: 1, scaleY: 1, accented: false },\n        sparkle: { opacity: 1, scale: 1.05, rotate: 25, y: -8 },\n      };\n\n    case \'o-nudge\':\n      // Hovering directly on O: O rolls forward and kisses V\'s edge like Newton\'s cradle,\n      // V leans smoothly right while A steps clear so no strokes collide.\n      return {\n        N: { x: -4, y: 0, rotate: -3, scaleX: 1, scaleY: 1, accented: false },\n        O: { x: 4.5, y: -3, rotate: 360, scaleX: 1.05, scaleY: 0.95, accented: true },\n        V: { x: 2, y: 2, rotate: 10, scaleX: 0.97, scaleY: 1.03, accented: true },\n        A: { x: 6, y: 0, rotate: 3, scaleX: 1, scaleY: 1, accented: false },\n        sparkle: { opacity: 1, scale: 1.15, rotate: 45, y: -8 },\n      };\n\n    case \'v-lift\':\n      // Hovering directly on V: V tilts warmly inward and springs up to float O\n      // into a crisp, non-overlapping arc above the baseline.\n      return {\n        N: { x: -4, y: 0, rotate: -2, scaleX: 1, scaleY: 1, accented: false },\n        O: { x: 1.5, y: -12, rotate: -180, scaleX: 1.02, scaleY: 1.04, accented: true },\n        V: { x: 0, y: -2, rotate: -10, scaleX: 1.06, scaleY: 0.96, accented: true },\n        A: { x: 4, y: 0, rotate: 2, scaleX: 1, scaleY: 1, accented: false },\n        sparkle: { opacity: 1, scale: 1.15, rotate: -30, y: -14 },\n      };\n  }\n}"
