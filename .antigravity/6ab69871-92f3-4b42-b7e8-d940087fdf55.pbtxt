              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Conceived as an intimate alternative to high-turnover salons, NOVA was created for guests who value stillness as much as craft. Our space pairs warm limewashed walls, natural travertine stone, and filtered daylight to soften the transition from the outside world.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
