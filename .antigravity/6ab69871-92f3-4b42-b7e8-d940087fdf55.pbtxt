      arguments_json: "{\"CommandLine\":\"python3 -c \'\\nimport subprocess\\n\\n# Draw a 50px grid over the full 848x1264 portrait (neck/chest/hand crop: 500x760+170+380)\\n# Magenta every 100px, cyan every 50px\\ndraw = []\\nfor x in range(0, 500, 25):\\n    col = \\\"rgba(255,0,255,0.65)\\\" if (x+170) % 100 == 0 else (\\\"rgba(0,255,255,0.45)\\\" if (x+170) % 50 == 0 else \\\"rgba(255,255,0,0.18)\\\")\\n    draw += [\\\"-stroke\\\", col, \\\"-draw\\\", f\\\"line {x},0 {x},760\\\"]\\nfor y in range(0, 760, 25):\\n    col = \\\"rgba(255,0,255,0.65)\\\" if (y+380) % 100 == 0 else (\\\"rgba(0,255,255,0.45)\\\" if (y+380) % 50 == 0 else \\\"rgba(255,255,0,0.18)\\\")\\n    draw += [\\\"-stroke\\\", col, \\\"-draw\\\", f\\\"line 0,{y} 500,{y}\\\"]\\n\\nsubprocess.run([\\n    \\\"convert\\\", \\\"src/assets/images/owner_portrait_matched_tone.jpg\\\",\\n    \\\"-crop\\\", \\\"500x760+170+380\\\", \\\"+repage\\\"\\n] + draw + [\\\".playwright-cli/body_skin_grid.png\\\"], check=True)\\nprint(\\\"Grid saved (origin x=170, y=380; magenta at 200,300,400,500,600 and 400,500,600,700,800,900,1000,1100)\\\")\\n\'\", \"Cwd\":\".\", \"WaitMsBeforeAsync\":5000, \"toolAction\":\"Mapping body skin coordinates for neck, chest, and hand\", \"toolSummary\":\"Map body skin coordinates\"}"
