    command_line: "python3 -c \'\nimport subprocess\n# Create side-by-side labeled grid of current composite vs exact2_scaled at +254+166 (394x394)\nsubprocess.run([\n  \"convert\", \"src/assets/images/owner_portrait_clean_cheeks_v2.jpg\",\n  \"-crop\", \"394x394+254+166\", \"+repage\",\n  \".playwright-cli/cur_crop.png\"\n], check=True)\n# Draw grid every 20px with labels every 40px\ndraw = []\nfor i in range(0, 394, 20):\n    col = \"rgba(0,255,255,0.45)\" if i % 40 == 0 else \"rgba(255,255,0,0.22)\"\n    draw += [\"-stroke\", col, \"-draw\", f\"line {i},0 {i},394\", \"-draw\", f\"line 0,{i} 394,{i}\"]\nfor i in range(40, 380, 40):\n    draw += [\"-stroke\", \"none\", \"-fill\", \"yellow\", \"-pointsize\", \"11\", \"-draw\", f\"text {i+2},12 \\\"{i}\\\"\", \"-draw\", f\"text 2,{i+10} \\\"{i}\\\"\"]\nsubprocess.run([\"convert\", \".playwright-cli/cur_crop.png\"] + draw + [\".playwright-cli/cur_grid.png\"], check=True)\nsubprocess.run([\"convert\", \".playwright-cli/exact2_scaled.png\"] + draw + [\".playwright-cli/src_grid.png\"], check=True)\nsubprocess.run([\"convert\", \"+append\", \".playwright-cli/cur_grid.png\", \".playwright-cli/src_grid.png\", \".playwright-cli/jaw_side_by_side.png\"], check=True)\n\'"
