      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Use NOVA prefix instead of MA for consultation reference codes\", \"EndLine\":189, \"Instruction\":\"Change booking referenceCode prefix from MA- to NOVA- in src/utils/bookingLogic.ts\", \"ReplacementContent\":\"  // Deterministic, human-readable demo reference code\\n  const nameSeed = (input.clientName || \'NV\').replace(/[^a-zA-Z]/g, \'\').toUpperCase().slice(0, 2).padEnd(2, \'N\');\\n  const dateSeed = (input.preferredDate || \'20261024\').replace(/\\\\D/g, \'\').slice(-4).padStart(4, \'0\');\\n  const referenceCode = `NOVA-${nameSeed}${dateSeed}`;\", \"StartLine\":182, \"TargetContent\":\"  // Deterministic, human-readable demo reference code\\n  const nameSeed = (input.clientName || \'MA\').replace(/[^a-zA-Z]/g, \'\').toUpperCase().slice(0, 2).padEnd(2, \'A\');\\n  const dateSeed = (input.preferredDate || \'20261024\').replace(/\\\\D/g, \'\').slice(-4).padStart(4, \'0\');\\n  const referenceCode = `MA-${nameSeed}${dateSeed}`;\", \"TargetFile\":\"/src/utils/bookingLogic.ts\", \"toolAction\":\"Updating booking reference code prefix to NOVA\", \"toolSummary\":\"Update reference code to NOVA\"}"
