    command_line: "python3 -c \'\nimport subprocess\n\nscale = 1.64\nS = int(round(240 * scale)) # 394\n\n# Step 1: On exact2_scaled.png (394x394), apply ONLY a gentle natural 3D studio edge-shading falloff on the outermost right cheek rim\n# (local x around 230..258, y around 140..225 -> reduces only the bright pink edge-blush highlight so the cheek wraps naturally into studio side shadow!)\n# Does NOT touch eyes, eyebrows, nose, lips, chin, or front cheeks!\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/exact2_scaled.png\",\n    \"(\", \".playwright-cli/exact2_scaled.png\",\n         \"-modulate\", \"93,76,101.5\",\n         \"(\", \"-size\", f\"{S}x{S}\", \"xc:black\", \"-fill\", \"white\",\n              \"-draw\", \"translate 244,185 rotate -8 ellipse 0,0 16,44 0,360\",\n              \"-blur\", \"0x12\",\n         \")\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\",\n    \")\",\n    \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/exact3_shaded.png\"\n])\n\n# Step 2: Updated polygon mask:\n# - Left side extended 7px into her REAL dark hair (x=71..76 in 240-space) so her REAL cheek-to-hair boundary completely covers\n#   the wider base portrait cheek (ZERO pale outer-cheek ridge or double edge on viewer-left!).\n# - Right side smoothly wraps to her real cheek/jawline (x=153..154) with soft feathering into the shadowed hair/ear edge!\n# - Bottom still extends cleanly down her smooth upper neck (y=164) so chin-to-neck stays 100% spotless!\npts_240 = [\n    (76, 56), (105, 48), (128, 51), (145, 62), (153, 80),\n    (155, 102), (152, 122), (146, 138), (145, 152), (144, 164),\n    (124, 166), (106, 164), (100, 150), (88, 142),\n    (77, 132), (72, 116), (71, 94), (73, 72)\n]\npoly_str = \" \".join(f\"{round(x*scale)},{round(y*scale)}\" for x, y in pts_240)\ntilak_x = round(102 * scale)\ntilak_y = round(73 * scale)\n\nsubprocess.check_call([\n    \"convert\", \"-size\", f\"{S}x{S}\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", f\"polygon {poly_str}\",\n    \"-blur\", \"0x5.5\",\n    \"(\", \"-size\", f\"{S}x{S}\", \"xc:white\",\n         \"-fill\", \"black\",\n         \"-draw\", f\"ellipse {tilak_x},{tilak_y} 13,15 0,360\",\n         \"-blur\", \"0x6\",\n    \")\",\n    \"-compose\", \"Multiply\", \"-composite\",\n    \".playwright-cli/cheek_fixed_mask.png\"\n])\n\n# Step 3: Composite cleanly onto base_clean_neck2.png at exact same +254+166 offset\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/base_clean_neck2.png\",\n    \"(\", \".playwright-cli/exact3_shaded.png\", \".playwright-cli/cheek_fixed_mask.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+254+166\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_clean_cheeks.jpg\"\n])\n\n# Step 4: Save tight zoomed crop to inspect BOTH outer cheek edges at full HD zoom!\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_clean_cheeks.jpg\",\n    \"-crop\", \"420x260+230+205\", \"+repage\",\n    \".playwright-cli/cheek_zoom_check.png\"\n])\nprint(\"Cheek edge fix complete!\")\n\'"
    proposed_command_line: "python3 -c \'\nimport subprocess\n\nscale = 1.64\nS = int(round(240 * scale)) # 394\n\n# Step 1: On exact2_scaled.png (394x394), apply ONLY a gentle natural 3D studio edge-shading falloff on the outermost right cheek rim\n# (local x around 230..258, y around 140..225 -> reduces only the bright pink edge-blush highlight so the cheek wraps naturally into studio side shadow!)\n# Does NOT touch eyes, eyebrows, nose, lips, chin, or front cheeks!\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/exact2_scaled.png\",\n    \"(\", \".playwright-cli/exact2_scaled.png\",\n         \"-modulate\", \"93,76,101.5\",\n         \"(\", \"-size\", f\"{S}x{S}\", \"xc:black\", \"-fill\", \"white\",\n              \"-draw\", \"translate 244,185 rotate -8 ellipse 0,0 16,44 0,360\",\n              \"-blur\", \"0x12\",\n         \")\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\",\n    \")\",\n    \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/exact3_shaded.png\"\n])\n\n# Step 2: Updated polygon mask:\n# - Left side extended 7px into her REAL dark hair (x=71..76 in 240-space) so her REAL cheek-to-hair boundary completely covers\n#   the wider base portrait cheek (ZERO pale outer-cheek ridge or double edge on viewer-left!).\n# - Right side smoothly wraps to her real cheek/jawline (x=153..154) with soft feathering into the shadowed hair/ear edge!\n# - Bottom still extends cleanly down her smooth upper neck (y=164) so chin-to-neck stays 100% spotless!\npts_240 = [\n    (76, 56), (105, 48), (128, 51), (145, 62), (153, 80),\n    (155, 102), (152, 122), (146, 138), (145, 152), (144, 164),\n    (124, 166), (106, 164), (100, 150), (88, 142),\n    (77, 132), (72, 116), (71, 94), (73, 72)\n]\npoly_str = \" \".join(f\"{round(x*scale)},{round(y*scale)}\" for x, y in pts_240)\ntilak_x = round(102 * scale)\ntilak_y = round(73 * scale)\n\nsubprocess.check_call([\n    \"convert\", \"-size\", f\"{S}x{S}\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", f\"polygon {poly_str}\",\n    \"-blur\", \"0x5.5\",\n    \"(\", \"-size\", f\"{S}x{S}\", \"xc:white\",\n         \"-fill\", \"black\",\n         \"-draw\", f\"ellipse {tilak_x},{tilak_y} 13,15 0,360\",\n         \"-blur\", \"0x6\",\n    \")\",\n    \"-compose\", \"Multiply\", \"-composite\",\n    \".playwright-cli/cheek_fixed_mask.png\"\n])\n\n# Step 3: Composite cleanly onto base_clean_neck2.png at exact same +254+166 offset\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/base_clean_neck2.png\",\n    \"(\", \".playwright-cli/exact3_shaded.png\", \".playwright-cli/cheek_fixed_mask.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+254+166\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_clean_cheeks.jpg\"\n])\n\n# Step 4: Save tight zoomed crop to inspect BOTH outer cheek edges at full HD zoom!\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_clean_cheeks.jpg\",\n    \"-crop\", \"420x260+230+205\", \"+repage\",\n    \".playwright-cli/cheek_zoom_check.png\"\n])\nprint(\"Cheek edge fix complete!\")\n\'"
