    combined_output {
      full: "Forehead       : 207,167,143 (lum=176)Mid-left chk   : 208,155,125 (lum=167)Mid-right chk  : 199,153,121 (lum=163)Upper neck     : 194,158,137 (lum=166)Lower neck     : 211,175,156 (lum=183)Chest/decoll   : 204,172,151 (lum=179)Wrist          : 148,111,88 (lum=119)Hand/back      : 167,132,113 (lum=140)Fingers        : 108,82,72 (lum=88)"
