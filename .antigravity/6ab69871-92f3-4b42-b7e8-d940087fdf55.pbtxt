  run_command {
    cwd: "/app/applet"
    exit_code: 0
    blocking: true
    wait_ms_before_async: 10000
    combined_output {
      full: "Detected exact tilak center in face_raw3: (90, 95)v3 calibrated cheek RGB: 209,152,126 (target: 203,151,125)v3 complete!"
    }
    command_line: "python3 -c \'\nimport subprocess\n\n# Step 1: Extract raw face region from original photo (200x220+268+288)\nsubprocess.check_call([\n    \"convert\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\",\n    \"-crop\", \"200x220+268+288\", \"+repage\",\n    \".playwright-cli/face_raw3.png\"\n])\n\n# Let us find the exact pixel with highest red-green difference (the orange tilak) inside forehead box x=84..106, y=82..104\n# Then patch it with clean forehead skin 14px to its right (same y, smooth bright skin!)\nout = subprocess.check_output([\n    \"convert\", \".playwright-cli/face_raw3.png\", \"-crop\", \"24x24+82+82\", \"+repage\",\n    \"-format\", \"%[fx:w]x%[fx:h]\", \"txt:-\"\n]).decode()\nmax_score = -1\ntx, ty = 94, 94\nfor line in out.splitlines()[1:]:\n    # format: x,y: (r,g,b) ...\n    try:\n        xy, rest = line.split(\":\", 1)\n        x, y = map(int, xy.split(\",\"))\n        rgb_str = rest.split(\"(\")[1].split(\")\")[0]\n        r, g, b = [float(v) for v in rgb_str.split(\",\")[:3]]\n        # orange/red tilak has high R - G and relatively low G compared to forehead skin\n        score = (r - g) - 0.5 * g\n        if score > max_score:\n            max_score = score\n            tx, ty = 82 + x, 82 + y\n    except Exception:\n        pass\nprint(f\"Detected exact tilak center in face_raw3: ({tx}, {ty})\")\n\n# Patch tilak center (tx, ty) with clean forehead skin 13px to the left and 13px to the right blended 50/50\n# First create 18x20 clean patch from (tx+12, ty-2) (smooth forehead above right brow)\npx, py = tx - 9, ty - 10\nsrc_x, src_y = tx + 6, ty - 11\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/face_raw3.png\",\n    \"(\", \".playwright-cli/face_raw3.png\", \"-crop\", f\"18x20+{src_x}+{src_y}\", \"+repage\",\n         \"-blur\", \"0x0.6\",\n         \"(\", \"-size\", \"18x20\", \"xc:black\", \"-fill\", \"white\", \"-draw\", \"ellipse 9,10 6.5,7.5 0,360\", \"-blur\", \"0x2.6\", \")\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\",\n    \")\",\n    \"-geometry\", f\"+{px}+{py}\", \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/face_clean3.png\"\n])\n\n# Step 2: Scale 1.60x Lanczos + exact daylight skin calibration targeting neck/gen RGB (203, 151, 125)\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/face_clean3.png\",\n    \"-blur\", \"0x0.25\",\n    \"-filter\", \"Lanczos\", \"-resize\", \"320x352!\",\n    \"-channel\", \"R\", \"-gamma\", \"0.78\", \"-evaluate\", \"multiply\", \"0.855\",\n    \"-channel\", \"G\", \"-gamma\", \"1.00\", \"-evaluate\", \"multiply\", \"1.005\",\n    \"-channel\", \"B\", \"-gamma\", \"1.30\", \"-evaluate\", \"multiply\", \"0.985\",\n    \"+channel\",\n    \"-modulate\", \"100,88,100\",\n    \"-attenuate\", \"0.09\", \"+noise\", \"Gaussian\",\n    \".playwright-cli/face_color3.png\"\n])\n\nrgb_check = subprocess.check_output([\n    \"convert\", \".playwright-cli/face_color3.png\", \"-crop\", \"24x24+182+190\", \"+repage\",\n    \"-resize\", \"1x1!\", \"-format\", \"%[fx:int(255*r)],%[fx:int(255*g)],%[fx:int(255*b)]\", \"info:\"\n]).decode().strip()\nprint(\"v3 calibrated cheek RGB:\", rgb_check, \"(target: 203,151,125)\")\n\n# Step 3: Soft feathered mask\nsubprocess.check_call([\n    \"convert\", \"-size\", \"320x352\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"translate 163,195 rotate -8 ellipse 0,0 56,71 0,360\",\n    \"-blur\", \"0x11\",\n    \".playwright-cli/face_mask3.png\"\n])\n\n# Step 4: Composite cleanly onto studio editorial portrait -> save directly to src/assets/images/owner_portrait_real_face.jpg\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_faithful_1795347756012.jpg\",\n    \"(\", \".playwright-cli/face_color3.png\", \".playwright-cli/face_mask3.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+271+134\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_real_face.jpg\"\n])\n\n# Step 5: Side-by-side close-up comparison\nsubprocess.check_call([\n    \"convert\",\n    \"(\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\", \"-crop\", \"180x210+280+310\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"(\", \"src/assets/images/owner_portrait_real_face.jpg\", \"-crop\", \"288x336+292+176\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"+append\", \".playwright-cli/face_compare_v3.jpg\"\n])\nprint(\"v3 complete!\")\n\'"
    proposed_command_line: "python3 -c \'\nimport subprocess\n\n# Step 1: Extract raw face region from original photo (200x220+268+288)\nsubprocess.check_call([\n    \"convert\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\",\n    \"-crop\", \"200x220+268+288\", \"+repage\",\n    \".playwright-cli/face_raw3.png\"\n])\n\n# Let us find the exact pixel with highest red-green difference (the orange tilak) inside forehead box x=84..106, y=82..104\n# Then patch it with clean forehead skin 14px to its right (same y, smooth bright skin!)\nout = subprocess.check_output([\n    \"convert\", \".playwright-cli/face_raw3.png\", \"-crop\", \"24x24+82+82\", \"+repage\",\n    \"-format\", \"%[fx:w]x%[fx:h]\", \"txt:-\"\n]).decode()\nmax_score = -1\ntx, ty = 94, 94\nfor line in out.splitlines()[1:]:\n    # format: x,y: (r,g,b) ...\n    try:\n        xy, rest = line.split(\":\", 1)\n        x, y = map(int, xy.split(\",\"))\n        rgb_str = rest.split(\"(\")[1].split(\")\")[0]\n        r, g, b = [float(v) for v in rgb_str.split(\",\")[:3]]\n        # orange/red tilak has high R - G and relatively low G compared to forehead skin\n        score = (r - g) - 0.5 * g\n        if score > max_score:\n            max_score = score\n            tx, ty = 82 + x, 82 + y\n    except Exception:\n        pass\nprint(f\"Detected exact tilak center in face_raw3: ({tx}, {ty})\")\n\n# Patch tilak center (tx, ty) with clean forehead skin 13px to the left and 13px to the right blended 50/50\n# First create 18x20 clean patch from (tx+12, ty-2) (smooth forehead above right brow)\npx, py = tx - 9, ty - 10\nsrc_x, src_y = tx + 6, ty - 11\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/face_raw3.png\",\n    \"(\", \".playwright-cli/face_raw3.png\", \"-crop\", f\"18x20+{src_x}+{src_y}\", \"+repage\",\n         \"-blur\", \"0x0.6\",\n         \"(\", \"-size\", \"18x20\", \"xc:black\", \"-fill\", \"white\", \"-draw\", \"ellipse 9,10 6.5,7.5 0,360\", \"-blur\", \"0x2.6\", \")\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\",\n    \")\",\n    \"-geometry\", f\"+{px}+{py}\", \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/face_clean3.png\"\n])\n\n# Step 2: Scale 1.60x Lanczos + exact daylight skin calibration targeting neck/gen RGB (203, 151, 125)\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/face_clean3.png\",\n    \"-blur\", \"0x0.25\",\n    \"-filter\", \"Lanczos\", \"-resize\", \"320x352!\",\n    \"-channel\", \"R\", \"-gamma\", \"0.78\", \"-evaluate\", \"multiply\", \"0.855\",\n    \"-channel\", \"G\", \"-gamma\", \"1.00\", \"-evaluate\", \"multiply\", \"1.005\",\n    \"-channel\", \"B\", \"-gamma\", \"1.30\", \"-evaluate\", \"multiply\", \"0.985\",\n    \"+channel\",\n    \"-modulate\", \"100,88,100\",\n    \"-attenuate\", \"0.09\", \"+noise\", \"Gaussian\",\n    \".playwright-cli/face_color3.png\"\n])\n\nrgb_check = subprocess.check_output([\n    \"convert\", \".playwright-cli/face_color3.png\", \"-crop\", \"24x24+182+190\", \"+repage\",\n    \"-resize\", \"1x1!\", \"-format\", \"%[fx:int(255*r)],%[fx:int(255*g)],%[fx:int(255*b)]\", \"info:\"\n]).decode().strip()\nprint(\"v3 calibrated cheek RGB:\", rgb_check, \"(target: 203,151,125)\")\n\n# Step 3: Soft feathered mask\nsubprocess.check_call([\n    \"convert\", \"-size\", \"320x352\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"translate 163,195 rotate -8 ellipse 0,0 56,71 0,360\",\n    \"-blur\", \"0x11\",\n    \".playwright-cli/face_mask3.png\"\n])\n\n# Step 4: Composite cleanly onto studio editorial portrait -> save directly to src/assets/images/owner_portrait_real_face.jpg\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_faithful_1795347756012.jpg\",\n    \"(\", \".playwright-cli/face_color3.png\", \".playwright-cli/face_mask3.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+271+134\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_real_face.jpg\"\n])\n\n# Step 5: Side-by-side close-up comparison\nsubprocess.check_call([\n    \"convert\",\n    \"(\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\", \"-crop\", \"180x210+280+310\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"(\", \"src/assets/images/owner_portrait_real_face.jpg\", \"-crop\", \"288x336+292+176\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"+append\", \".playwright-cli/face_compare_v3.jpg\"\n])\nprint(\"v3 complete!\")\n\'"
