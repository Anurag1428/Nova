      full: "=== AFTER TONE MATCH ===Forehead       : 207,170,149 (lum=179)Mid-left chk   : 207,157,130 (lum=169)Mid-right chk  : 199,153,128 (lum=164)Chin           : 176,135,113 (lum=145)Upper neck     : 184,142,118 (lum=152)Lower neck     : 204,157,133 (lum=169)Chest/decoll   : 197,155,129 (lum=165)Hand/knuckles  : 126,86,73 (lum=96)"
    }
    command_line: "python3 -c \'\nimport subprocess\n\nsrc = \"src/assets/images/owner_portrait_clean_jaw.jpg\"\n\n# 1. Build spatial mask covering the face + upper neck (the warmer tungsten-cast region)\n#    Coordinates in full 848x1264 image (offset +254+166):\n#    Face center ~(438, 345), upper neck ~(445, 435), tapering smoothly down to lower neck ~(445, 480)\n#    where skin already matches the chest!\nsubprocess.run([\n    \"convert\", \"-size\", \"848x1264\", \"xc:black\",\n    \"-fill\", \"white\",\n    # Face + upper neck polygon (generous around face because luminance mask protects hair/brows/eyes!)\n    \"-draw\", \"polygon 365,245 440,225 515,260 525,355 505,435 495,485 385,485 375,420 355,340\",\n    \"-blur\", \"0x24\",\n    # Lightly attenuate right over the lips (around 438,376) so lips retain natural rosy warmth\n    \"-fill\", \"gray45\",\n    \"-draw\", \"ellipse 438,376 26,11 0,360\",\n    \"-blur\", \"0x5\",\n    \".playwright-cli/tone_spatial_mask.png\"\n], check=True)\n\n# 2. Build luminance gate from the source image so dark eyes, eyebrows, lashes, nostrils, and dark hair\n#    are 100% protected from Blue/Green midtone lift!\nsubprocess.run([\n    \"convert\", src,\n    \"-colorspace\", \"Gray\",\n    \"-level\", \"24%,54%\",\n    \"-blur\", \"0x2\",\n    \".playwright-cli/tone_lum_gate.png\"\n], check=True)\n\n# Combine spatial mask * luminance gate -> precision skin-only mask!\nsubprocess.run([\n    \"convert\", \".playwright-cli/tone_spatial_mask.png\", \".playwright-cli/tone_lum_gate.png\",\n    \"-compose\", \"Multiply\", \"-composite\",\n    \".playwright-cli/tone_skin_mask.png\"\n], check=True)\n\n# 3. Create the studio-daylight skin-matched version of the image:\n#    Current cheek: (206, 142, 101) -> Target (lower neck / chest): (204, 156, 129)\n#    R gamma=0.96, G gamma=1.15, B gamma=1.32 brings (206,142,101) -> ~(204,155,127)\n#    Also slightly calm forehead excess brightness if needed? Forehead is 208,165,137 (already close to 205,156,129!)\n#    Wait: forehead (y=250..295) is ALREADY 208,165,137 \342\200\224 let us keep forehead at ~35% strength so forehead\n#    does not get over-cooled while cheeks, chin, and upper neck (y=305..475) get 100% match!\nsubprocess.run([\n    \"convert\", \"-size\", \"848x1264\", \"xc:black\",\n    \"-fill\", \"white\",\n    # Full strength on cheeks, nose, chin, upper neck (y=302..472)\n    \"-draw\", \"polygon 365,302 520,300 518,415 500,478 385,478 375,415 358,350\",\n    # Gentle 40% blend on forehead (already close to body tone!)\n    \"-fill\", \"gray40\",\n    \"-draw\", \"polygon 378,242 440,228 508,258 518,302 365,302\",\n    \"-blur\", \"0x18\",\n    # Protect natural rosy lips (keep 60% original lip rose)\n    \"-fill\", \"gray40\",\n    \"-draw\", \"ellipse 438,376 26,11 0,360\",\n    \"-blur\", \"0x5\",\n    \".playwright-cli/tone_spatial_mask2.png\"\n], check=True)\n\nsubprocess.run([\n    \"convert\", \".playwright-cli/tone_spatial_mask2.png\", \".playwright-cli/tone_lum_gate.png\",\n    \"-compose\", \"Multiply\", \"-composite\",\n    \".playwright-cli/tone_skin_mask2.png\"\n], check=True)\n\nsubprocess.run([\n    \"convert\", src,\n    \"(\", src,\n         \"-channel\", \"R\", \"-gamma\", \"0.96\",\n         \"-channel\", \"G\", \"-gamma\", \"1.14\",\n         \"-channel\", \"B\", \"-gamma\", \"1.30\",\n         \"+channel\",\n         \"-modulate\", \"101,94,100\",\n    \")\",\n    \".playwright-cli/tone_skin_mask2.png\",\n    \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_matched_tone.jpg\"\n], check=True)\n\n# 4. Verify resulting RGB skin tones across the entire body!\ndef avg_rgb(img, geom):\n    return subprocess.check_output([\n        \"convert\", img, \"-crop\", geom, \"+repage\", \"-resize\", \"1x1!\",\n        \"-format\", \"%[fx:int(255*r)],%[fx:int(255*g)],%[fx:int(255*b)] (lum=%[fx:int(255*(0.299*r+0.587*g+0.114*b))])\", \"info:\"\n    ]).decode().strip()\n\nout = \"src/assets/images/owner_portrait_matched_tone.jpg\"\nzones = [\n    (\"Forehead\",      \"30x20+415+275\"),\n    (\"Mid-left chk\",  \"24x24+395+338\"),\n    (\"Mid-right chk\", \"24x24+468+332\"),\n    (\"Chin\",          \"24x16+428+395\"),\n    (\"Upper neck\",    \"34x22+430+430\"),\n    (\"Lower neck\",    \"40x30+425+485\"),\n    (\"Chest/decoll\",  \"44x34+415+535\"),\n    (\"Hand/knuckles\", \"36x28+372+868\"),\n]\nprint(\"=== AFTER TONE MATCH ===\")\nfor name, geom in zones:\n    print(f\"{name:15s}: {avg_rgb(out, geom)}\")\n\n# Create side-by-side comparison (face + torso + hand)\nsubprocess.run([\n    \"convert\", out, \"-crop\", \"480x760+185+170\", \"+repage\", \"-resize\", \"480x760\",\n    \".playwright-cli/tone_check_after.png\"\n], check=True)\nsubprocess.run([\n    \"convert\", \"+append\", \".playwright-cli/tone_check_before.png\", \".playwright-cli/tone_check_after.png\",\n    \".playwright-cli/tone_before_after.png\"\n], check=True)\n\'"
