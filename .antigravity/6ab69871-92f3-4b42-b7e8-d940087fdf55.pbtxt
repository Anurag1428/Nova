  code_action {
    action_spec {
      command {
        instruction: "Track whether the header is over the dark Treatments opening video hero and switch text/background cleanly between ivory-over-video and navy-on-alabaster"
        is_edit: true
        file {
          absolute_uri: "file:///src/components/Header.tsx"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "  const [isScrolled, setIsScrolled] = useState(false);\n  const [menuOpen, setMenuOpen] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      // Transition into compact white top header only after scrolling past both full-screen hero stages\n      setIsScrolled(window.scrollY > window.innerHeight * 1.88);\n    };\n    handleScroll();\n    window.addEventListener(\'scroll\', handleScroll, { passive: true });\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  useEffect(() => {\n    if (!menuOpen) return;\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === \'Escape\') {\n        setMenuOpen(false);\n      }\n    };\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => window.removeEventListener(\'keydown\', handleKeyDown);\n  }, [menuOpen]);\n\n  const showCompactBar = isScrolled || activePage !== \'home\';\n\n  const handleLinkClick = (page: ActivePage, sectionId?: string) => {\n    setMenuOpen(false);\n    onNavigatePage(page, sectionId);\n  };\n\n  return (\n    <>\n      {/* Odyss\303\251e-Inspired Minimalist Sticky Top Bar (#FBF9F5 background, #18224B midnight navy text)\n          Follows 3-Zone Contract: Brand Wordmark \342\200\224 Clean Text Links \342\200\224 Primary Action */}\n      <header\n        aria-label=\"Primary Sticky Navigation\"\n        className={`fixed top-0 left-0 right-0 z-40 flex items-center justify-between gap-8 px-6 md:px-10 py-4 transition-all duration-500 ${\n          showCompactBar\n            ? \'translate-y-0 opacity-100 bg-[#FBF9F5]/95 backdrop-blur-md text-[#18224B]\'\n            : \'pointer-events-none -translate-y-3 opacity-0 bg-transparent text-[#FBF9F5]\'\n        }`}\n      >\n        {/* Zone 1: NOVA Editorial Wordmark */}\n        <InteractiveNovaWordmark\n          testId=\"header-nova-wordmark\"\n          accentColor=\"#9E7F4F\"\n          onClick={(e) => {\n            e.preventDefault();\n            handleLinkClick(\'home\');\n          }}\n          className=\"font-brand text-2xl md:text-[1.75rem] font-normal text-[#18224B] focus-visible:outline-2 focus-visible:outline-offset-4\"\n        />\n\n        {/* Zone 2: Minimalist uppercase navigation links in Basel Grotesk */}\n        <nav\n          aria-label=\"Main Navigation\"\n          className=\"font-basel hidden md:flex items-center gap-10 text-[11px] font-normal tracking-[0.04em] uppercase text-[#18224B]\"\n        >\n          <button\n            type=\"button\"\n            onClick={() => setMenuOpen(true)}\n            aria-expanded={menuOpen}\n            aria-controls=\"maison-aura-menu-panel\"\n            className=\"font-basel cursor-pointer py-1 uppercase hover:opacity-60 transition-opacity whitespace-nowrap shrink-0\"\n          >\n            Menu\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => handleLinkClick(\'treatments\')}\n            className={`font-basel cursor-pointer py-1 uppercase transition-opacity whitespace-nowrap shrink-0 ${\n              activePage === \'treatments\'\n                ? \'underline underline-offset-4 font-medium\'\n                : \'hover:opacity-60\'\n            }`}\n          >\n            Treatments\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => handleLinkClick(\'home\', \'our-approach\')}\n            className=\"font-basel cursor-pointer py-1 uppercase hover:opacity-60 transition-opacity whitespace-nowrap shrink-0\"\n          >\n            Concerns\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => handleLinkClick(\'about\')}\n            className={`font-basel cursor-pointer py-1 uppercase transition-opacity whitespace-nowrap shrink-0 ${\n              activePage === \'about\'\n                ? \'underline underline-offset-4 font-medium\'\n                : \'hover:opacity-60\'\n            }`}\n          >\n            About\n          </button>\n        </nav>\n\n        {/* Zone 3: Primary Action in Basel Grotesk */}\n        <div className=\"font-basel flex items-center gap-4 shrink-0\">\n          <button\n            type=\"button\"\n            onClick={() => setMenuOpen(true)}\n            aria-label=\"Open navigation menu\"\n            aria-expanded={menuOpen}\n            className=\"font-basel md:hidden cursor-pointer px-2.5 py-1.5 text-[11px] uppercase tracking-[0.04em] text-[#18224B] whitespace-nowrap shrink-0\"\n          >\n            Menu\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => onOpenBooking()}\n            className=\"font-basel cursor-pointer py-1 text-[11px] uppercase tracking-[0.04em] text-[#18224B] hover:opacity-60 transition-opacity whitespace-nowrap shrink-0\"\n          >\n            {bookingCount > 0 ? `Book Consultation (${bookingCount})` : \'Book Consultation\'}\n          </button>\n        </div>\n      </header>"
          replacement_content: "  const [isScrolled, setIsScrolled] = useState(false);\n  const [isOverTreatmentsVideo, setIsOverTreatmentsVideo] = useState(false);\n  const [menuOpen, setMenuOpen] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      // Home: transition into compact white top header after both full-screen hero stages\n      setIsScrolled(window.scrollY > window.innerHeight * 1.88);\n      // Treatments: stay transparent ivory while over the 190vh dark opening video hero\n      setIsOverTreatmentsVideo(\n        activePage === \'treatments\' && window.scrollY < window.innerHeight * 1.78\n      );\n    };\n    handleScroll();\n    window.addEventListener(\'scroll\', handleScroll, { passive: true });\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, [activePage]);\n\n  useEffect(() => {\n    if (!menuOpen) return;\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === \'Escape\') {\n        setMenuOpen(false);\n      }\n    };\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => window.removeEventListener(\'keydown\', handleKeyDown);\n  }, [menuOpen]);\n\n  const showCompactBar = isScrolled || activePage !== \'home\';\n  const useLightOverVideo = activePage === \'treatments\' && isOverTreatmentsVideo;\n\n  const handleLinkClick = (page: ActivePage, sectionId?: string) => {\n    setMenuOpen(false);\n    onNavigatePage(page, sectionId);\n  };\n\n  return (\n    <>\n      {/* Odyss\303\251e-Inspired Minimalist Sticky Top Bar\n          Follows 3-Zone Contract: Brand Wordmark \342\200\224 Clean Text Links \342\200\224 Primary Action */}\n      <header\n        aria-label=\"Primary Sticky Navigation\"\n        className={`fixed top-0 left-0 right-0 z-40 flex items-center justify-between gap-8 px-6 md:px-10 py-4 transition-all duration-500 ${\n          showCompactBar\n            ? useLightOverVideo\n              ? \'translate-y-0 opacity-100 bg-gradient-to-b from-[#121620]/45 via-[#121620]/15 to-transparent text-[#FBF9F5]\'\n              : \'translate-y-0 opacity-100 bg-[#FBF9F5]/95 backdrop-blur-md text-[#18224B]\'\n            : \'pointer-events-none -translate-y-3 opacity-0 bg-transparent text-[#FBF9F5]\'\n        }`}\n      >\n        {/* Zone 1: NOVA Editorial Wordmark */}\n        <InteractiveNovaWordmark\n          testId=\"header-nova-wordmark\"\n          accentColor={useLightOverVideo ? \'#E8D5B5\' : \'#9E7F4F\'}\n          onClick={(e) => {\n            e.preventDefault();\n            handleLinkClick(\'home\');\n          }}\n          className={`font-brand text-2xl md:text-[1.75rem] font-normal focus-visible:outline-2 focus-visible:outline-offset-4 transition-colors duration-300 ${\n            useLightOverVideo ? \'text-[#FBF9F5]\' : \'text-[#18224B]\'\n          }`}\n        />\n\n        {/* Zone 2: Minimalist uppercase navigation links in Basel Grotesk */}\n        <nav\n          aria-label=\"Main Navigation\"\n          className={`font-basel hidden md:flex items-center gap-10 text-[11px] font-normal tracking-[0.04em] uppercase transition-colors duration-300 ${\n            useLightOverVideo ? \'text-[#FBF9F5]\' : \'text-[#18224B]\'\n          }`}\n        >\n          <button\n            type=\"button\"\n            onClick={() => setMenuOpen(true)}\n            aria-expanded={menuOpen}\n            aria-controls=\"maison-aura-menu-panel\"\n            className=\"font-basel cursor-pointer py-1 uppercase hover:opacity-60 transition-opacity whitespace-nowrap shrink-0\"\n          >\n            Menu\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => handleLinkClick(\'treatments\')}\n            className={`font-basel cursor-pointer py-1 uppercase transition-opacity whitespace-nowrap shrink-0 ${\n              activePage === \'treatments\'\n                ? \'underline underline-offset-4 font-medium\'\n                : \'hover:opacity-60\'\n            }`}\n          >\n            Treatments\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => handleLinkClick(\'home\', \'our-approach\')}\n            className=\"font-basel cursor-pointer py-1 uppercase hover:opacity-60 transition-opacity whitespace-nowrap shrink-0\"\n          >\n            Concerns\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => handleLinkClick(\'about\')}\n            className={`font-basel cursor-pointer py-1 uppercase transition-opacity whitespace-nowrap shrink-0 ${\n              activePage === \'about\'\n                ? \'underline underline-offset-4 font-medium\'\n                : \'hover:opacity-60\'\n            }`}\n          >\n            About\n          </button>\n        </nav>\n\n        {/* Zone 3: Primary Action in Basel Grotesk */}\n        <div className=\"font-basel flex items-center gap-4 shrink-0\">\n          <button\n            type=\"button\"\n            onClick={() => setMenuOpen(true)}\n            aria-label=\"Open navigation menu\"\n            aria-expanded={menuOpen}\n            className={`font-basel md:hidden cursor-pointer px-2.5 py-1.5 text-[11px] uppercase tracking-[0.04em] whitespace-nowrap shrink-0 transition-colors duration-300 ${\n              useLightOverVideo ? \'text-[#FBF9F5]\' : \'text-[#18224B]\'\n            }`}\n          >\n            Menu\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => onOpenBooking()}\n            className={`font-basel cursor-pointer py-1 text-[11px] uppercase tracking-[0.04em] hover:opacity-60 transition-all duration-300 whitespace-nowrap shrink-0 ${\n              useLightOverVideo ? \'text-[#FBF9F5]\' : \'text-[#18224B]\'\n            }`}\n          >\n            {bookingCount > 0 ? `Book Consultation (${bookingCount})` : \'Book Consultation\'}\n          </button>\n        </div>\n      </header>"
