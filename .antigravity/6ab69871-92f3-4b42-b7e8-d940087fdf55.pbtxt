    command_line: "trap \'playwright-cli close\' EXIT\nmkdir -p .playwright-cli\nplaywright-cli open --browser=chromium http://localhost:3000 && \\\nplaywright-cli resize 1440 900 && \\\nplaywright-cli run-code \'async (page) => {\n  // Open Book Consultation from Opening Horizon Navigation\n  await page.getByRole(\"navigation\", { name: \"Opening Horizon Navigation\" }).getByRole(\"button\", { name: \"Book Consultation\" }).click();\n  await page.waitForSelector(\"[data-testid=booking-sanctuary-modal][data-state=open]\", { timeout: 6000 });\n  await page.waitForTimeout(550);\n\n  // Switch category to Makeup & Bridal so we verify live dossier + video film switch\n  await page.getByRole(\"tab\", { name: /Makeup & Bridal/i }).click();\n  await page.waitForTimeout(400);\n  await page.screenshot({ path: \".playwright-cli/booking-step1-desktop.png\" });\n\n  // Advance to Step 2: Schedule\n  await page.getByRole(\"button\", { name: /Continue to Schedule/i }).click();\n  await page.waitForSelector(\"[data-testid=booking-sanctuary-modal][data-step=\\\"2\\\"]\", { timeout: 4000 });\n  await page.waitForTimeout(250);\n\n  // Try advancing without choosing a date -> verify honest validation alert\n  await page.getByRole(\"button\", { name: /Continue to Guest Details/i }).click();\n  const dateAlertCount = await page.getByRole(\"alert\").count();\n\n  // Pick second upcoming date tile + 02:30 PM slot\n  await page.locator(\"[data-testid=booking-sanctuary-modal] form button[aria-pressed]\").nth(1).click();\n  await page.getByRole(\"button\", { name: \"02:30 PM\" }).click();\n  await page.waitForTimeout(250);\n  await page.screenshot({ path: \".playwright-cli/booking-step2-desktop.png\" });\n\n  // Advance to Step 3: Guest Details\n  await page.getByRole(\"button\", { name: /Continue to Guest Details/i }).click();\n  await page.waitForSelector(\"[data-testid=booking-sanctuary-modal][data-step=\\\"3\\\"]\", { timeout: 4000 });\n  await page.waitForTimeout(250);\n\n  // Submit empty -> verify required field validation alerts appear\n  await page.getByRole(\"button\", { name: /Confirm Private Consultation/i }).click();\n  const step3AlertCount = await page.getByRole(\"alert\").count();\n\n  // Fill valid guest details + toggle Quiet silent ritual preference\n  await page.getByLabel(\"Full Name\").fill(\"Ananya Sharma\");\n  await page.getByLabel(\"Email Address\").fill(\"ananya@novasalon.in\");\n  await page.getByLabel(\"Phone Number\").fill(\"+91 98765 43210\");\n  await page.getByRole(\"button\", { name: /Quiet silent ritual/i }).click();\n  await page.getByRole(\"button\", { name: /Confirm Private Consultation/i }).click();\n\n  await page.waitForSelector(\"[data-testid=booking-success-state]\", { timeout: 4000 });\n  await page.waitForTimeout(350);\n  const confirmText = await page.locator(\"[data-testid=booking-success-state]\").textContent();\n  await page.screenshot({ path: \".playwright-cli/booking-confirmed-desktop.png\" });\n\n  // Mobile 390x844 check (start another ritual so we inspect Step 1 on mobile)\n  await page.getByRole(\"button\", { name: /Reserve Another Ritual/i }).click();\n  await page.setViewportSize({ width: 390, height: 844 });\n  await page.waitForTimeout(350);\n  const mobileOverflow = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\n  await page.screenshot({ path: \".playwright-cli/booking-mobile.png\" });\n\n  console.log(\"BOOKING_VERIFY:\", JSON.stringify({\n    dateAlertCount,\n    step3AlertCount,\n    hasRefCode: Boolean(confirmText && confirmText.includes(\"REF \302\267 MA-\")),\n    hasGuestName: Boolean(confirmText && confirmText.includes(\"Ananya Sharma\")),\n    mobileOverflow,\n  }));\n}\' && \\\nplaywright-cli console"
    proposed_command_line: "trap \'playwright-cli close\' EXIT\nmkdir -p .playwright-cli\nplaywright-cli open --browser=chromium http://localhost:3000 && \\\nplaywright-cli resize 1440 900 && \\\nplaywright-cli run-code \'async (page) => {\n  // Open Book Consultation from Opening Horizon Navigation\n  await page.getByRole(\"navigation\", { name: \"Opening Horizon Navigation\" }).getByRole(\"button\", { name: \"Book Consultation\" }).click();\n  await page.waitForSelector(\"[data-testid=booking-sanctuary-modal][data-state=open]\", { timeout: 6000 });\n  await page.waitForTimeout(550);\n\n  // Switch category to Makeup & Bridal so we verify live dossier + video film switch\n  await page.getByRole(\"tab\", { name: /Makeup & Bridal/i }).click();\n  await page.waitForTimeout(400);\n  await page.screenshot({ path: \".playwright-cli/booking-step1-desktop.png\" });\n\n  // Advance to Step 2: Schedule\n  await page.getByRole(\"button\", { name: /Continue to Schedule/i }).click();\n  await page.waitForSelector(\"[data-testid=booking-sanctuary-modal][data-step=\\\"2\\\"]\", { timeout: 4000 });\n  await page.waitForTimeout(250);\n\n  // Try advancing without choosing a date -> verify honest validation alert\n  await page.getByRole(\"button\", { name: /Continue to Guest Details/i }).click();\n  const dateAlertCount = await page.getByRole(\"alert\").count();\n\n  // Pick second upcoming date tile + 02:30 PM slot\n  await page.locator(\"[data-testid=booking-sanctuary-modal] form button[aria-pressed]\").nth(1).click();\n  await page.getByRole(\"button\", { name: \"02:30 PM\" }).click();\n  await page.waitForTimeout(250);\n  await page.screenshot({ path: \".playwright-cli/booking-step2-desktop.png\" });\n\n  // Advance to Step 3: Guest Details\n  await page.getByRole(\"button\", { name: /Continue to Guest Details/i }).click();\n  await page.waitForSelector(\"[data-testid=booking-sanctuary-modal][data-step=\\\"3\\\"]\", { timeout: 4000 });\n  await page.waitForTimeout(250);\n\n  // Submit empty -> verify required field validation alerts appear\n  await page.getByRole(\"button\", { name: /Confirm Private Consultation/i }).click();\n  const step3AlertCount = await page.getByRole(\"alert\").count();\n\n  // Fill valid guest details + toggle Quiet silent ritual preference\n  await page.getByLabel(\"Full Name\").fill(\"Ananya Sharma\");\n  await page.getByLabel(\"Email Address\").fill(\"ananya@novasalon.in\");\n  await page.getByLabel(\"Phone Number\").fill(\"+91 98765 43210\");\n  await page.getByRole(\"button\", { name: /Quiet silent ritual/i }).click();\n  await page.getByRole(\"button\", { name: /Confirm Private Consultation/i }).click();\n\n  await page.waitForSelector(\"[data-testid=booking-success-state]\", { timeout: 4000 });\n  await page.waitForTimeout(350);\n  const confirmText = await page.locator(\"[data-testid=booking-success-state]\").textContent();\n  await page.screenshot({ path: \".playwright-cli/booking-confirmed-desktop.png\" });\n\n  // Mobile 390x844 check (start another ritual so we inspect Step 1 on mobile)\n  await page.getByRole(\"button\", { name: /Reserve Another Ritual/i }).click();\n  await page.setViewportSize({ width: 390, height: 844 });\n  await page.waitForTimeout(350);\n  const mobileOverflow = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\n  await page.screenshot({ path: \".playwright-cli/booking-mobile.png\" });\n\n  console.log(\"BOOKING_VERIFY:\", JSON.stringify({\n    dateAlertCount,\n    step3AlertCount,\n    hasRefCode: Boolean(confirmText && confirmText.includes(\"REF \302\267 MA-\")),\n    hasGuestName: Boolean(confirmText && confirmText.includes(\"Ananya Sharma\")),\n    mobileOverflow,\n  }));\n}\' && \\\nplaywright-cli console"
