    proposed_command_line: "trap \'playwright-cli close\' EXIT\nmkdir -p .playwright-cli && \\\n  playwright-cli open --browser=chromium \"http://localhost:3000?autostart=1\" && \\\n  playwright-cli resize 1440 900 && \\\n  playwright-cli run-code \'async (page) => {\n    await page.getByRole(\"navigation\", { name: \"Opening Horizon Navigation\" }).getByRole(\"button\", { name: \"About\" }).click();\n    await page.waitForSelector(\"[data-testid=\\\"about-hero-section\\\"]\", { timeout: 10000 });\n    await page.waitForTimeout(1500);\n    await page.screenshot({ path: \".playwright-cli/about-r2-hero.png\" });\n\n    await page.evaluate(() => {\n      const el = document.querySelector(\"[data-testid=\\\"about-founder-spread\\\"]\");\n      if (el) window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY + 500, behavior: \"instant\" });\n    });\n    await page.waitForTimeout(450);\n    await page.screenshot({ path: \".playwright-cli/about-r2-founder.png\" });\n\n    await page.locator(\"[data-testid=\\\"about-founder-spread\\\"]\").getByRole(\"button\", { name: \"Book Consultation\" }).click();\n    await page.waitForSelector(\"[role=\\\"dialog\\\"]\", { timeout: 5000 });\n    await page.keyboard.press(\"Escape\");\n    await page.waitForTimeout(250);\n\n    await page.setViewportSize({ width: 390, height: 844 });\n    await page.evaluate(() => window.scrollTo({ top: 0, behavior: \"instant\" }));\n    await page.waitForTimeout(350);\n    await page.screenshot({ path: \".playwright-cli/about-r2-mobile.png\" });\n  }\' && \\\n  playwright-cli console"
