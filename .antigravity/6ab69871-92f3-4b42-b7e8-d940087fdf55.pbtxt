  run_command {
    cwd: "/app/applet"
    exit_code: 0
    blocking: true
    wait_ms_before_async: 10000
    combined_output {
      full: "Cheeks v2 complete!"
    }
    command_line: "python3 -c \'\nimport subprocess\n\nscale = 1.64\nS = int(round(240 * scale)) # 394\n\n# Extend lower-left polygon 10px further into her REAL dark glossy hair from orig_head\n# so her REAL dark hair completely covers the 4px pale lower-left base cheek sliver!\npts_240 = [\n    (76, 56), (105, 48), (128, 51), (145, 62), (153, 80),\n    (155, 102), (152, 122), (146, 138), (145, 152), (144, 164),\n    (124, 166), (106, 164), (96, 156), (78, 149),\n    (68, 136), (68, 116), (70, 94), (73, 72)\n]\npoly_str = \" \".join(f\"{round(x*scale)},{round(y*scale)}\" for x, y in pts_240)\ntilak_x = round(102 * scale)\ntilak_y = round(73 * scale)\n\nsubprocess.check_call([\n    \"convert\", \"-size\", f\"{S}x{S}\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", f\"polygon {poly_str}\",\n    \"-blur\", \"0x5.5\",\n    \"(\", \"-size\", f\"{S}x{S}\", \"xc:white\",\n         \"-fill\", \"black\",\n         \"-draw\", f\"ellipse {tilak_x},{tilak_y} 13,15 0,360\",\n         \"-blur\", \"0x6\",\n    \")\",\n    \"-compose\", \"Multiply\", \"-composite\",\n    \".playwright-cli/cheek_fixed_mask2.png\"\n])\n\n# Also softly tone down the outermost 12px pink rim on the right cheek slightly more smoothly\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/exact2_scaled.png\",\n    \"(\", \".playwright-cli/exact2_scaled.png\",\n         \"-modulate\", \"91,72,102.0\",\n         \"(\", \"-size\", f\"{S}x{S}\", \"xc:black\", \"-fill\", \"white\",\n              \"-draw\", \"translate 243,182 rotate -8 ellipse 0,0 18,48 0,360\",\n              \"-blur\", \"0x14\",\n         \")\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\",\n    \")\",\n    \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/exact4_shaded.png\"\n])\n\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/base_clean_neck2.png\",\n    \"(\", \".playwright-cli/exact4_shaded.png\", \".playwright-cli/cheek_fixed_mask2.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+254+166\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_clean_cheeks_v2.jpg\"\n])\n\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_clean_cheeks_v2.jpg\",\n    \"-crop\", \"420x260+230+205\", \"+repage\",\n    \".playwright-cli/cheek_zoom_check2.png\"\n])\nprint(\"Cheeks v2 complete!\")\n\'"
    proposed_command_line: "python3 -c \'\nimport subprocess\n\nscale = 1.64\nS = int(round(240 * scale)) # 394\n\n# Extend lower-left polygon 10px further into her REAL dark glossy hair from orig_head\n# so her REAL dark hair completely covers the 4px pale lower-left base cheek sliver!\npts_240 = [\n    (76, 56), (105, 48), (128, 51), (145, 62), (153, 80),\n    (155, 102), (152, 122), (146, 138), (145, 152), (144, 164),\n    (124, 166), (106, 164), (96, 156), (78, 149),\n    (68, 136), (68, 116), (70, 94), (73, 72)\n]\npoly_str = \" \".join(f\"{round(x*scale)},{round(y*scale)}\" for x, y in pts_240)\ntilak_x = round(102 * scale)\ntilak_y = round(73 * scale)\n\nsubprocess.check_call([\n    \"convert\", \"-size\", f\"{S}x{S}\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", f\"polygon {poly_str}\",\n    \"-blur\", \"0x5.5\",\n    \"(\", \"-size\", f\"{S}x{S}\", \"xc:white\",\n         \"-fill\", \"black\",\n         \"-draw\", f\"ellipse {tilak_x},{tilak_y} 13,15 0,360\",\n         \"-blur\", \"0x6\",\n    \")\",\n    \"-compose\", \"Multiply\", \"-composite\",\n    \".playwright-cli/cheek_fixed_mask2.png\"\n])\n\n# Also softly tone down the outermost 12px pink rim on the right cheek slightly more smoothly\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/exact2_scaled.png\",\n    \"(\", \".playwright-cli/exact2_scaled.png\",\n         \"-modulate\", \"91,72,102.0\",\n         \"(\", \"-size\", f\"{S}x{S}\", \"xc:black\", \"-fill\", \"white\",\n              \"-draw\", \"translate 243,182 rotate -8 ellipse 0,0 18,48 0,360\",\n              \"-blur\", \"0x14\",\n         \")\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\",\n    \")\",\n    \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/exact4_shaded.png\"\n])\n\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/base_clean_neck2.png\",\n    \"(\", \".playwright-cli/exact4_shaded.png\", \".playwright-cli/cheek_fixed_mask2.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+254+166\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_clean_cheeks_v2.jpg\"\n])\n\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_clean_cheeks_v2.jpg\",\n    \"-crop\", \"420x260+230+205\", \"+repage\",\n    \".playwright-cli/cheek_zoom_check2.png\"\n])\nprint(\"Cheeks v2 complete!\")\n\'"
