      thinking_signature: "\022\227\n\n\224\n\001i\024}\023Bj\345.\202\300\260IM\300\370\235\374\313\234+b\352\354F\247a0\\(\315R1\v:B\224\223\314\020\272\352\326\247\t\361\035\000i\267+\262Z\205:+\340\004\272T\035\225\300\334\232#\035\210\353\031\220\225\034\376%\260\3750ge\204\376\024\374\360\226\335\227\312S\017/M\034:\250\022\211vr\343\023\347\027q\177\272\314\271\270Z\221\216gB\341\361i\375\325\327q`\3131z.\335\002\266X\210\002\256\251\347\274\327H_\246\237\023\301x\364\177\2074\'\265\204!g\213\200\331\336\315\256\033\336\332\332!\323=\214\363?\254\323\252\037g\254\335\256d\332\360k\031\311l\327\365\3776\367\247T6`\337\362\271AN@\364Ge\311BIJ\016\321\321\035\251q\214\374V\367j=l\351\314\273|\351M4\272?<\301\332\27709Y\207\317z&\200l\214\357\300\274Ac\306\036\"(\033\224\025\032\244.i\241\210\267\340qv:\277\204\307\036\237N[\023GR.cQ\356\365C\207\251\000\226\250\360\277*\223\303\321Z\a\302\3155\207\317\344h\206\253L\tr\027\244\231\314\023\v\224VC\316\252\034\033\335\251?`0\203mK:\236\304\303\216\306(\031b7\024\'Ut\336+7H\203!\033\212B\200\320\235.\212\227\227D\250\026\000\323<Z\a]G\'u\363\022\3674\026\344\237@x\324\327}\331.a{=\037\020D\357T\"\350w\310jd`Z\217K;e\324=\355\261\231Tojl\244in\321Hi^\223e\nEX\213o\357\223(\261mg\035\\\375\a4y\276\316P\2532\236\264\272\032\'\3557\214\223W\216@\307H\325\032rMn\367\355\376\353\034uy\374\217D>^M\355+\030\207\264-\252\215\016L\264\330\352\023\345\f\362\371F\344\017\341\360\242\2338L\277\210\223\020\035#\343\320-\031\265$Z\331\254-\a\310Eo2\201\324.\023-V\251.\"\334\376h\343U\225\267\357\323\3116\337\0034\2517\314\355P\325\257x\034\356:\361\276\263Nx\233\322\365\362\235\366\017\255^\317fo\367\310<\343\312\236\332R\320\272 O\034\v\336\307y!\016\242i^F4\334\260\343\2448U0\034X(\272\003\a\302\0278Y\337\006\350sx\222\367\036u\023\376-5\345\227\f\320\352\236\216\321\354\001\365\250Z14g\206\006vS| \226!\204\354<\337O\242\303\205=\027\356\016eO\346;?\2739\355\343\214\264\202I\301\337\027\347\344\004@\275\275s\335\324\177$F\212:/m!G\'\004\305\237\033\302\n\001\333\263H\243\345G\375aCO@!iO$\362\357\bQO0t\'T&}7\233v\326v?\020\363\371\207\311l\245\243\360\224\362\323r\025wM\262\315\344\313@\316\230\315[\250\366y\233\375\354\024\336j\036\240\'\362\363(\033\267\002\253\355o\2545\335\356\361\241*\017\363%6\234\310\216p\364\264u2C!\0370\321\352\001y\016\225\3277\327\f\335s_\364\223O\204\276\326\234\"%\0332\266P\366\n&+>\262\243\022\247z>#\331Bh\354\001\'\202\016\200\341\027L\244l\343\313\274\214\243I\356\205%\261\310\353\006\336\217\2575\305k(\300\341\240\204\362\n\000EZ\342\250\217K\a+\023\256z\324\331F5\236u\270\231eo\240\002v\352\023\246\343\315\207\305nj\263\336$1K\005\321\356\203v\367\2731\266\2636g\231\317\225\275\303\213\035\020\031\336C6\f\254\345\232\303\036\021m.\203\177&\300\225\003\273\a:0\312@\222\305==l4\344q\205\330\350\3420\fx\232\220h\371\234\272\2771Y#6\277\000fZ\223FF\177T\024\312b\005S\374T\366\001j\256b\327Mz\325\rjA$\245\033\345a\345\354%\206A\333\230\315\237\245F\000\244\235!\262\302D\333}\\\210\366\217\202@\266\nh1\246\215\037]_C$\001`\223\326\311\342\340^\334\223-\227OS[\266ceO\253\226\\\b\353\306&\344\237\251\"H\216#b\253\272.z\225\301\237\2476\246\354\0241fH\"0K\351(\262e\264\261-\317Q.z-\354\364\336z\264\2652\320\235\214\366\363\302\371l.\275h\236FDF\220}M\036\335\311`a\004\005\a\337\235k\341Wg\247aAC\357B\334\346K*\001\343)KJ\264;\005\217\177\264g\347\302<\215\302!\3368\241u/l\032\266\241_V\227\2110R\366\027s\201\210\302\022\370N#\023\252A\036\251\256\274E\344\322\214\224s]\036n\'\200\371\366\364O\231aK\375\001-\302\304\253B\204}\302|qt\245\210\034\302\315\vj\f\247\024\245-\346\023tu\003a\367\346\275\322\017\222\"\005z,\235\336\225<\210\277s\224\365b=\262"
