      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Keep outgoing hero anchored during curtain rise so Stage B never peeks at the bottom edge\", \"EndLine\":196, \"Instruction\":\"Remove outgoing mainEl upward shift during curtain rise so the rising #FBF9F5 sheet cuts cleanly over the hero matching the reference\", \"ReplacementContent\":\"    // 1. Warm alabaster (#FBF9F5) sheet rises smoothly from bottom edge over current page\\n    tl.to(\\n      curtain,\\n      {\\n        yPercent: 0,\\n        duration: timings.riseDuration,\\n        ease: \'power4.inOut\',\\n      },\\n      0\\n    );\\n\\n    // 2. At peak full-viewport coverage, swap page cleanly at scroll top\\n    tl.add(() => {\\n      setTransitionPhase(\'swapping\');\\n      setActivePage(page);\\n      if (sectionId) {\\n        window.requestAnimationFrame(() => {\\n          const el = document.getElementById(sectionId);\\n          if (el) el.scrollIntoView({ behavior: \'auto\' });\\n          else window.scrollTo({ top: 0, behavior: \'auto\' });\\n        });\\n      } else {\\n        window.scrollTo({ top: 0, behavior: \'auto\' });\\n      }\\n      if (mainEl) {\\n        gsap.set(mainEl, { y: 28, opacity: 0 });\\n      }\\n    });\", \"StartLine\":152, \"TargetContent\":\"    // 1. Warm alabaster (#FBF9F5) sheet rises smoothly from bottom edge over current page\\n    tl.to(\\n      curtain,\\n      {\\n        yPercent: 0,\\n        duration: timings.riseDuration,\\n        ease: \'power4.inOut\',\\n      },\\n      0\\n    );\\n\\n    if (mainEl) {\\n      tl.to(\\n        mainEl,\\n        {\\n          y: -44,\\n          duration: timings.riseDuration,\\n          ease: \'power3.inOut\',\\n        },\\n        0\\n      );\\n    }\\n\\n    // 2. At peak full-viewport coverage, swap page cleanly at scroll top\\n    tl.add(() => {\\n      setTransitionPhase(\'swapping\');\\n      setActivePage(page);\\n      if (sectionId) {\\n        window.requestAnimationFrame(() => {\\n          const el = document.getElementById(sectionId);\\n          if (el) el.scrollIntoView({ behavior: \'auto\' });\\n          else window.scrollTo({ top: 0, behavior: \'auto\' });\\n        });\\n      } else {\\n        window.scrollTo({ top: 0, behavior: \'auto\' });\\n      }\\n      if (mainEl) {\\n        gsap.set(mainEl, { y: 34, opacity: 0 });\\n      }\\n    });\", \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Keeping hero anchored during curtain rise\", \"toolSummary\":\"Refine curtain timeline in App.tsx\"}"
      original_name: "replace_file_content"
    }
