    command_line: "python3 -c \'\nimport subprocess\n\n# Work directly from grid_orig region: 240x240+260+310\n# In this 240x240 crop:\n#   Left eye:  (89, 89)\n#   Right eye: (124, 84)\n#   Eye midpoint: (106.5, 86.5), eye dist = 35.36px\n# Target in base portrait (about_owner_portrait_1795344836608.jpg or owner_portrait_faithful_1795347756012.jpg, 848x1264):\n#   Let us use owner_portrait_faithful_1795347756012.jpg (848x1264) where:\n#   Eye midpoint: (429, 308), eye dist = 56.57px\n# Scale factor = 1.56x -> 240 * 1.56 = 374px (exact natural head proportion!)\n# Scaled eye midpoint = (106.5 * 1.56, 86.5 * 1.56) = (166.1, 134.9)\n# Placement offset on 848x1264 base: x = 429 - 166 = 263, y = 308 - 135 = 173\n\nscale = 1.56\nS = int(round(240 * scale)) # 374\n\n# 1. Extract 240x240 around her real face\nsubprocess.check_call([\n    \"convert\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\",\n    \"-crop\", \"240x240+260+310\", \"+repage\",\n    \".playwright-cli/orig_head.png\"\n])\n\n# 2. Clean ONLY the tiny orange forehead tilak at (102, 73) in orig_head.png using smooth bright skin from her own forehead at (114, 58)\n# (y=58 is well above eyebrow y=74 and below hairline y=47!)\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/orig_head.png\",\n    \"(\", \".playwright-cli/orig_head.png\", \"-crop\", \"16x16+108+54\", \"+repage\",\n         \"-modulate\", \"99,97,100\",\n         \"(\", \"-size\", \"16x16\", \"xc:black\", \"-fill\", \"white\", \"-draw\", \"ellipse 8,8 5.5,6.5 0,360\", \"-blur\", \"0x2.2\", \")\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\",\n    \")\",\n    \"-geometry\", \"+94+65\", \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/orig_head_clean.png\"\n])\n\n# 3. Upscale cleanly to 374x374 with Lanczos + gentle natural daylight color balance (preserving her rosy glow & pure white eyes!)\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/orig_head_clean.png\",\n    \"-filter\", \"Lanczos\", \"-resize\", f\"{S}x{S}!\",\n    \"-modulate\", \"98,86,101.8\",\n    \"-channel\", \"R\", \"-gamma\", \"0.90\", \"-evaluate\", \"multiply\", \"0.95\",\n    \"-channel\", \"G\", \"-gamma\", \"0.99\", \"-evaluate\", \"multiply\", \"1.00\",\n    \"-channel\", \"B\", \"-gamma\", \"1.07\", \"-evaluate\", \"multiply\", \"1.03\",\n    \"+channel\",\n    \"-attenuate\", \"0.06\", \"+noise\", \"Gaussian\",\n    \".playwright-cli/orig_head_scaled.png\"\n])\n\n# 4. Build a 100%-OPAQUE-INTERIOR full face + jawline + chin + left ear polygon mask (very tight feather 3.5px at outer contour!)\n# Polygon points in 240x240 coords scaled by 1.56:\npts_240 = [\n    (83, 56), (105, 48), (128, 51), (144, 62), (153, 80),\n    (165, 84), (166, 98), (160, 114), (153, 122),\n    (147, 134), (135, 144), (116, 151), (98, 148),\n    (86, 137), (79, 118), (77, 94), (79, 72)\n]\npoly_str = \" \".join(f\"{round(x*scale)},{round(y*scale)}\" for x, y in pts_240)\nsubprocess.check_call([\n    \"convert\", \"-size\", f\"{S}x{S}\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", f\"polygon {poly_str}\",\n    \"-blur\", \"0x4.5\",\n    \".playwright-cli/full_face_mask.png\"\n])\n\n# 5. Prepare base portrait: slightly warm the neck/collarbone region (+3% warm peach) so it matches her radiant real face seamlessly,\n# AND softly darken any tiny outer jaw sliver of the AI face right behind her real jawline into natural hair shadow\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_faithful_1795347756012.jpg\",\n    \"(\", \"src/assets/images/owner_portrait_faithful_1795347756012.jpg\",\n         \"-modulate\", \"102,108,99.4\",\n         \"(\", \"-size\", \"848x1264\", \"xc:black\", \"-fill\", \"white\", \"-draw\", \"ellipse 445,445 75,70 0,360\", \"-blur\", \"0x24\", \")\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\",\n    \")\",\n    \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/base_warm_neck.png\"\n])\n\n# 6. Composite her 100% REAL unaltered face, jawline, chin, and left ear onto the base portrait at +263+173\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/base_warm_neck.png\",\n    \"(\", \".playwright-cli/orig_head_scaled.png\", \".playwright-cli/full_face_mask.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+263+173\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \".playwright-cli/owner_portrait_exact_full.jpg\"\n])\n\n# 7. Side-by-side close-up comparison (Real original vs Full-head composite)\nsubprocess.check_call([\n    \"convert\",\n    \"(\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\", \"-crop\", \"180x210+280+310\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"(\", \".playwright-cli/owner_portrait_exact_full.jpg\", \"-crop\", \"288x336+292+176\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"+append\", \".playwright-cli/face_compare_exact_full.jpg\"\n])\nprint(\"Full-head exact composite complete!\")\n\'"
