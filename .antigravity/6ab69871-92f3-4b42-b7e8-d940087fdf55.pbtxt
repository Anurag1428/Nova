  view_file {
    absolute_path_uri: "file:///src/components/BookingDrawer.tsx"
    end_line: 470
    content: "import React, { useEffect, useState } from \'react\';\nimport { SALON_CONFIG } from \'../data/salonData\';\nimport {\n  AVAILABLE_TIME_SLOTS,\n  BookingFormInput,\n  BookingValidationErrors,\n  ConfirmedDemoBooking,\n  createBookingRecord,\n  getCategoryServices,\n  validateBookingForm,\n} from \'../utils/bookingLogic\';\n\ninterface BookingDrawerProps {\n  isOpen: boolean;\n  initialCategoryId?: string;\n  initialRitualId?: string;\n  onClose: () => void;\n  onBookingConfirmed: (booking: ConfirmedDemoBooking) => void;\n  savedBookings: ConfirmedDemoBooking[];\n}\n\nexport const BookingDrawer: React.FC<BookingDrawerProps> = ({\n  isOpen,\n  initialCategoryId,\n  initialRitualId,\n  onClose,\n  onBookingConfirmed,\n  savedBookings,\n}) => {\n  const defaultCategory = initialCategoryId || SALON_CONFIG.treatmentCategories[0].id;\n  const defaultRituals = getCategoryServices(defaultCategory);\n  const defaultRitual = initialRitualId || defaultRituals[0]?.id || \'\';\n\n  const [form, setForm] = useState<BookingFormInput>({\n    categoryId: defaultCategory,\n    ritualId: defaultRitual,\n    clientName: \'\',\n    clientEmail: \'\',\n    clientPhone: \'\',\n    preferredDate: \'\',\n    preferredTime: AVAILABLE_TIME_SLOTS[1],\n    notes: \'\',\n  });\n\n  const [errors, setErrors] = useState<BookingValidationErrors>({});\n  const [latestConfirmed, setLatestConfirmed] = useState<ConfirmedDemoBooking | null>(null);\n\n  useEffect(() => {\n    if (isOpen) {\n      const catId = initialCategoryId || SALON_CONFIG.treatmentCategories[0].id;\n      const rituals = getCategoryServices(catId);\n      const ritId =\n        initialRitualId && rituals.some((r) => r.id === initialRitualId)\n          ? initialRitualId\n          : rituals[0]?.id || \'\';\n\n      setForm((prev) => ({\n        ...prev,\n        categoryId: catId,\n        ritualId: ritId,\n      }));\n      setErrors({});\n    }\n  }, [isOpen, initialCategoryId, initialRitualId]);\n\n  useEffect(() => {\n    if (!isOpen) return;\n    const onKeyDown = (e: KeyboardEvent) => {\n      if (e.key === \'Escape\') {\n        onClose();\n      }\n    };\n    window.addEventListener(\'keydown\', onKeyDown);\n    return () => window.removeEventListener(\'keydown\', onKeyDown);\n  }, [isOpen, onClose]);\n\n  if (!isOpen) return null;\n\n  const availableRituals = getCategoryServices(form.categoryId);\n\n  const handleCategoryChange = (newCategoryId: string) => {\n    const nextRituals = getCategoryServices(newCategoryId);\n    setForm((prev) => ({\n      ...prev,\n      categoryId: newCategoryId,\n      ritualId: nextRituals[0]?.id || \'\',\n    }));\n    setErrors((prev) => ({ ...prev, categoryId: undefined, ritualId: undefined }));\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    const validation = validateBookingForm(form);\n    if (!validation.isValid) {\n      setErrors(validation.errors);\n      return;\n    }\n\n    const record = createBookingRecord(form);\n    setLatestConfirmed(record);\n    onBookingConfirmed(record);\n  };\n\n  const handleStartAnother = () => {\n    setLatestConfirmed(null);\n    setErrors({});\n  };\n\n  return (\n    <div\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"booking-drawer-title\"\n      className=\"fixed inset-0 z-50 flex justify-end bg-[#121620]/60 backdrop-blur-xs transition-opacity\"\n    >\n      {/* Backdrop click to dismiss */}\n      <div\n        className=\"flex-1\"\n        onClick={onClose}\n        aria-hidden=\"true\"\n      />\n\n      <div className=\"relative w-full max-w-xl bg-[#F6F3EE] text-[#121620] h-full overflow-y-auto p-6 md:p-10 flex flex-col justify-between shadow-2xl border-l border-[#121620]/15\">\n        <div>\n          {/* Top Bar */}\n          <div className=\"flex items-center justify-between pb-6 border-b border-[#121620]/15\">\n            <div>\n              <span className=\"block text-[11px] uppercase tracking-[0.18em] text-[#5A585D]\">\n                Maison Aura Concierge\n              </span>\n              <h2\n                id=\"booking-drawer-title\"\n                className=\"font-serif-editorial text-3xl font-normal text-[#121620]\"\n              >\n                Request an Appointment\n              </h2>\n            </div>\n            <button\n              type=\"button\"\n              onClick={onClose}\n              aria-label=\"Close appointment panel\"\n              className=\"cursor-pointer px-3.5 py-2 text-xs uppercase tracking-[0.14em] border border-[#121620]/25 hover:border-[#121620] transition-colors whitespace-nowrap shrink-0\"\n            >\n              Close\n            </button>\n          </div>\n\n          {latestConfirmed ? (\n            /* Honest Frontend Demo Success State */\n            <div\n              data-testid=\"booking-success-state\"\n              className=\"mt-8 space-y-6 bg-[#EDE8E0] p-6 md:p-8 border border-[#121620]/15\"\n            >\n              <div className=\"flex items-center justify-between border-b border-[#121620]/15 pb-4\">\n                <span className=\"text-xs uppercase tracking-[0.18em] text-[#121620] font-medium\">\n                  Appointment Request Prepared (Demo)\n                </span>\n                <span className=\"font-mono-tabular text-xs text-[#5A585D]\">\n                  Ref: {latestConfirmed.referenceCode}\n                </span>\n              </div>\n\n              <div className=\"space-y-2\">\n                <h3 className=\"font-serif-editorial text-3xl font-normal\">\n                  Thank you, {latestConfirmed.clientName}.\n                </h3>\n                <p className=\"text-sm text-[#3B393E] leading-relaxed\">\n                  Your preferred ritual details have been validated and recorded in this interactive frontend preview. Because this is a demonstration template, no live booking has been transmitted to a third-party salon CRM yet.\n                </p>\n              </div>\n\n              <dl className=\"divide-y divide-[#121620]/10 border-y border-[#121620]/15 text-xs\">\n                <div className=\"py-3 flex justify-between gap-4\">\n                  <dt className=\"text-[#5A585D]\">Ritual</dt>\n                  <dd className=\"font-medium text-right\">{latestConfirmed.ritualName}</dd>\n                </div>\n                <div className=\"py-3 flex justify-between gap-4\">\n                  <dt className=\"text-[#5A585D]\">Duration &amp; Sample Fee</dt>\n                  <dd className=\"font-mono-tabular text-right\">\n                    {latestConfirmed.duration} \302\267 {latestConfirmed.examplePrice}\n                  </dd>\n                </div>\n                <div className=\"py-3 flex justify-between gap-4\">\n                  <dt className=\"text-[#5A585D]\">Requested Date &amp; Time</dt>\n                  <dd className=\"font-mono-tabular text-right\">\n                    {latestConfirmed.preferredDate} at {latestConfirmed.preferredTime}\n                  </dd>\n                </div>\n                <div className=\"py-3 flex justify-between gap-4\">\n                  <dt className=\"text-[#5A585D]\">Contact</dt>\n                  <dd className=\"text-right\">\n                    {latestConfirmed.clientEmail} \302\267 {latestConfirmed.clientPhone}\n                  </dd>\n                </div>\n              </dl>\n\n              <div className=\"flex flex-wrap items-center gap-3 pt-2\">\n                <button\n                  type=\"button\"\n                  onClick={handleStartAnother}\n                  className=\"cursor-pointer px-5 py-2.5 text-xs uppercase tracking-[0.14em] bg-[#121620] text-[#F6F3EE] hover:bg-[#273044] transition-colors whitespace-nowrap shrink-0\"\n                >\n                  Request another ritual\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={onClose}\n                  className=\"cursor-pointer px-5 py-2.5 text-xs uppercase tracking-[0.14em] border border-[#121620]/30 hover:border-[#121620] transition-colors whitespace-nowrap shrink-0\"\n                >\n                  Return to Maison Aura\n                </button>\n              </div>\n            </div>\n          ) : (\n            /* Appointment Booking Form */\n            <form onSubmit={handleSubmit} noValidate className=\"mt-6 space-y-5\">\n              <p className=\"text-xs text-[#5A585D] leading-relaxed\">\n                Select your desired ritual and preferred time window. Frontend demo mode: validates your request locally and prepares the payload structure for future booking system integration.\n              </p>\n\n              {/* Category Selection */}\n              <div>\n                <label\n                  htmlFor=\"booking-category\"\n                  className=\"block text-xs uppercase tracking-[0.14em] text-[#121620] mb-2\"\n                >\n                  1. Service Category\n                </label>\n                <select\n                  id=\"booking-category\"\n                  value={form.categoryId}\n                  onChange={(e) => handleCategoryChange(e.target.value)}\n                  className=\"w-full bg-[#EDE8E0] border border-[#121620]/20 px-3.5 py-2.5 text-sm text-[#121620] focus:border-[#121620] focus:outline-none\"\n                >\n                  {SALON_CONFIG.treatmentCategories.map((cat) => (\n                    <option key={cat.id} value={cat.id}>\n                      {cat.index}. {cat.title}\n                    </option>\n                  ))}\n                </select>\n                {errors.categoryId && (\n                  <p role=\"alert\" className=\"mt-1.5 text-xs text-[#9E2A2B]\">\n                    {errors.categoryId}\n                  </p>\n                )}\n              </div>\n\n              {/* Specific Ritual Selection */}\n              <div>\n                <label\n                  htmlFor=\"booking-ritual\"\n                  className=\"block text-xs uppercase tracking-[0.14em] text-[#121620] mb-2\"\n                >\n                  2. Specific Ritual\n                </label>\n                <select\n                  id=\"booking-ritual\"\n                  value={form.ritualId}\n                  onChange={(e) => {\n                    setForm((prev) => ({ ...prev, ritualId: e.target.value }));\n                    setErrors((prev) => ({ ...prev, ritualId: undefined }));\n                  }}\n                  className=\"w-full bg-[#EDE8E0] border border-[#121620]/20 px-3.5 py-2.5 text-sm text-[#121620] focus:border-[#121620] focus:outline-none\"\n                >\n                  {availableRituals.map((ritual) => (\n                    <option key={ritual.id} value={ritual.id}>\n                      {ritual.name} ({ritual.duration} \342\200\224 {ritual.examplePrice})\n                    </option>\n                  ))}\n                </select>\n                {errors.ritualId && (\n                  <p role=\"alert\" className=\"mt-1.5 text-xs text-[#9E2A2B]\">\n                    {errors.ritualId}\n                  </p>\n                )}\n              </div>\n\n              {/* Date and Time Row */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label\n                    htmlFor=\"booking-date\"\n                    className=\"block text-xs uppercase tracking-[0.14em] text-[#121620] mb-2\"\n                  >\n                    3. Preferred Date\n                  </label>\n                  <input\n                    id=\"booking-date\"\n                    type=\"date\"\n                    min=\"2026-10-24\"\n                    value={form.preferredDate}\n                    onChange={(e) => {\n                      setForm((prev) => ({ ...prev, preferredDate: e.target.value }));\n                      setErrors((prev) => ({ ...prev, preferredDate: undefined }));\n                    }}\n                    className=\"w-full bg-[#EDE8E0] border border-[#121620]/20 px-3.5 py-2.5 text-sm text-[#121620] focus:border-[#121620] focus:outline-none\"\n                  />\n                  {errors.preferredDate && (\n                    <p role=\"alert\" className=\"mt-1.5 text-xs text-[#9E2A2B]\">\n                      {errors.preferredDate}\n                    </p>\n                  )}\n                </div>\n\n                <div>\n                  <label\n                    htmlFor=\"booking-time\"\n                    className=\"block text-xs uppercase tracking-[0.14em] text-[#121620] mb-2\"\n                  >\n                    4. Preferred Time\n                  </label>\n                  <select\n                    id=\"booking-time\"\n                    value={form.preferredTime}\n                    onChange={(e) => {\n                      setForm((prev) => ({ ...prev, preferredTime: e.target.value }));\n                      setErrors((prev) => ({ ...prev, preferredTime: undefined }));\n                    }}\n                    className=\"w-full bg-[#EDE8E0] border border-[#121620]/20 px-3.5 py-2.5 text-sm text-[#121620] focus:border-[#121620] focus:outline-none\"\n                  >\n                    {AVAILABLE_TIME_SLOTS.map((slot) => (\n                      <option key={slot} value={slot}>\n                        {slot}\n                      </option>\n                    ))}\n                  </select>\n                  {errors.preferredTime && (\n                    <p role=\"alert\" className=\"mt-1.5 text-xs text-[#9E2A2B]\">\n                      {errors.preferredTime}\n                    </p>\n                  )}\n                </div>\n              </div>\n\n              {/* Client Name */}\n              <div>\n                <label\n                  htmlFor=\"booking-name\"\n                  className=\"block text-xs uppercase tracking-[0.14em] text-[#121620] mb-2\"\n                >\n                  5. Full Name\n                </label>\n                <input\n                  id=\"booking-name\"\n                  type=\"text\"\n                  placeholder=\"e.g. Claire Moreau\"\n                  value={form.clientName}\n                  onChange={(e) => {\n                    setForm((prev) => ({ ...prev, clientName: e.target.value }));\n                    setErrors((prev) => ({ ...prev, clientName: undefined }));\n                  }}\n                  className=\"w-full bg-[#EDE8E0] border border-[#121620]/20 px-3.5 py-2.5 text-sm text-[#121620] focus:border-[#121620] focus:outline-none\"\n                />\n                {errors.clientName && (\n                  <p role=\"alert\" className=\"mt-1.5 text-xs text-[#9E2A2B]\">\n                    {errors.clientName}\n                  </p>\n                )}\n              </div>\n\n              {/* Email & Phone */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label\n                    htmlFor=\"booking-email\"\n                    className=\"block text-xs uppercase tracking-[0.14em] text-[#121620] mb-2\"\n                  >\n                    6. Email Address\n                  </label>\n                  <input\n                    id=\"booking-email\"\n                    type=\"email\"\n                    placeholder=\"claire@example.com\"\n                    value={form.clientEmail}\n                    onChange={(e) => {\n                      setForm((prev) => ({ ...prev, clientEmail: e.target.value }));\n                      setErrors((prev) => ({ ...prev, clientEmail: undefined }));\n                    }}\n                    className=\"w-full bg-[#EDE8E0] border border-[#121620]/20 px-3.5 py-2.5 text-sm text-[#121620] focus:border-[#121620] focus:outline-none\"\n                  />\n                  {errors.clientEmail && (\n                    <p role=\"alert\" className=\"mt-1.5 text-xs text-[#9E2A2B]\">\n                      {errors.clientEmail}\n                    </p>\n                  )}\n                </div>\n\n                <div>\n                  <label\n                    htmlFor=\"booking-phone\"\n                    className=\"block text-xs uppercase tracking-[0.14em] text-[#121620] mb-2\"\n                  >\n                    7. Phone Number\n                  </label>\n                  <input\n                    id=\"booking-phone\"\n                    type=\"tel\"\n                    placeholder=\"+61 412 345 678\"\n                    value={form.clientPhone}\n                    onChange={(e) => {\n                      setForm((prev) => ({ ...prev, clientPhone: e.target.value }));\n                      setErrors((prev) => ({ ...prev, clientPhone: undefined }));\n                    }}\n                    className=\"w-full bg-[#EDE8E0] border border-[#121620]/20 px-3.5 py-2.5 text-sm text-[#121620] focus:border-[#121620] focus:outline-none\"\n                  />\n                  {errors.clientPhone && (\n                    <p role=\"alert\" className=\"mt-1.5 text-xs text-[#9E2A2B]\">\n                      {errors.clientPhone}\n                    </p>\n                  )}\n                </div>\n              </div>\n\n              {/* Optional Sensitivities / Ritual Notes */}\n              <div>\n                <label\n                  htmlFor=\"booking-notes\"\n                  className=\"block text-xs uppercase tracking-[0.14em] text-[#121620] mb-2\"\n                >\n                  8. Skin Sensitivities or Ritual Notes (Optional)\n                </label>\n                <textarea\n                  id=\"booking-notes\"\n                  rows={2}\n                  placeholder=\"Share any areas of focus, bridal dates, or fragrance preferences...\"\n                  value={form.notes}\n                  onChange={(e) => setForm((prev) => ({ ...prev, notes: e.target.value }))}\n                  className=\"w-full bg-[#EDE8E0] border border-[#121620]/20 px-3.5 py-2 text-sm text-[#121620] focus:border-[#121620] focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"pt-2\">\n                <button\n                  type=\"submit\"\n                  className=\"cursor-pointer w-full py-3.5 px-6 text-xs uppercase tracking-[0.18em] bg-[#121620] text-[#F6F3EE] hover:bg-[#273044] transition-colors whitespace-nowrap\"\n                >\n                  Confirm Appointment Request\n                </button>\n              </div>\n            </form>\n          )}\n        </div>\n\n        {/* Saved Session Requests */}\n        {savedBookings.length > 0 && (\n          <div className=\"mt-8 pt-6 border-t border-[#121620]/15\">\n            <span className=\"block text-[11px] uppercase tracking-[0.16em] text-[#5A585D] mb-2\">\n              Session Requests ({savedBookings.length})\n            </span>\n            <ul className=\"space-y-2 text-xs text-[#3B393E]\">\n              {savedBookings.map((b) => (\n                <li\n                  key={b.referenceCode + b.createdAtIso}\n                  className=\"flex items-center justify-between bg-[#EDE8E0]/60 px-3 py-2\"\n                >\n                  <span>\n                    {b.ritualName} \302\267 {b.preferredDate}\n                  </span>\n                  <span className=\"font-mono-tabular text-[#5A585D]\">\n                    {b.referenceCode}\n                  </span>\n                </li>\n              ))}\n            </ul>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 471
    num_bytes: 18963
    line_range_bytes: 18963
  }
}
