      arguments_json: "{\"Description\":\"Apply matching NavHoverLink dot hover effect to Footer directory links\", \"Instruction\":\"Import NavHoverLink and use it for the quick directory links in src/components/Footer.tsx\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":4, \"ReplacementContent\":\"import React, { useState } from \'react\';\\nimport { SALON_CONFIG } from \'../data/salonData\';\\nimport type { ActivePage } from \'./Header\';\\nimport { RollingMarble } from \'./RollingMarble\';\\nimport { NavHoverLink } from \'./NavHoverLink\';\", \"StartLine\":1, \"TargetContent\":\"import React, { useState } from \'react\';\\nimport { SALON_CONFIG } from \'../data/salonData\';\\nimport type { ActivePage } from \'./Header\';\\nimport { RollingMarble } from \'./RollingMarble\';\"}, {\"AllowMultiple\":false, \"EndLine\":175, \"ReplacementContent\":\"          {/* Right Column: Quick Directory Links */}\\n          <div className=\\\"md:col-span-3 lg:col-span-5 flex flex-col items-start md:items-end justify-between\\\">\\n            <div className=\\\"flex flex-wrap gap-7 pl-3 text-xs uppercase tracking-[0.12em]\\\">\\n              <NavHoverLink\\n                label=\\\"Home\\\"\\n                variant=\\\"header-light\\\"\\n                onClick={() => onNavigatePage(\'home\')}\\n                className=\\\"text-xs tracking-[0.12em]\\\"\\n              />\\n              <NavHoverLink\\n                label=\\\"Treatments\\\"\\n                variant=\\\"header-light\\\"\\n                onClick={() => onNavigatePage(\'treatments\')}\\n                className=\\\"text-xs tracking-[0.12em]\\\"\\n              />\\n              <NavHoverLink\\n                label=\\\"About\\\"\\n                variant=\\\"header-light\\\"\\n                onClick={() => onNavigatePage(\'about\')}\\n                className=\\\"text-xs tracking-[0.12em]\\\"\\n              />\\n              <NavHoverLink\\n                label=\\\"Book Consultation\