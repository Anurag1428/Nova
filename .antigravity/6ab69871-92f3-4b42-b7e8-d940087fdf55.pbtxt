    command_line: "trap \'playwright-cli close\' EXIT\nmkdir -p .playwright-cli\nplaywright-cli open --browser=chromium \"http://localhost:3000?autostart=1\" && \\\nplaywright-cli resize 1440 900 && \\\nplaywright-cli run-code \'async (page) => {\n  await page.waitForTimeout(450);\n\n  // Hover on TREATMENTS in Opening Horizon Navigation\n  const treatmentsBtn = page.getByRole(\"navigation\", { name: \"Opening Horizon Navigation\" }).getByRole(\"button\", { name: \"Treatments\" });\n  await treatmentsBtn.hover();\n  await page.waitForTimeout(380);\n\n  const heroHoverCheck = await treatmentsBtn.evaluate((el) => {\n    const cs = getComputedStyle(el);\n    const dot = el.querySelector(\"span[aria-hidden]\");\n    const dotCs = dot ? getComputedStyle(dot) : null;\n    return {\n      color: cs.color,\n      dotOpacity: dotCs?.opacity,\n      dotBg: dotCs?.backgroundColor,\n    };\n  });\n  await page.screenshot({ path: \".playwright-cli/nav-hover-hero.png\" });\n\n  // Scroll past hero to verify sticky header hover dot as well\n  await page.evaluate(() => window.scrollTo(0, 1950));\n  await page.waitForTimeout(550);\n  const stickyAboutBtn = page.getByRole(\"navigation\", { name: \"Main Navigation\" }).getByRole(\"button\", { name: \"About\" });\n  await stickyAboutBtn.hover();\n  await page.waitForTimeout(380);\n  const stickyHoverCheck = await stickyAboutBtn.evaluate((el) => {\n    const cs = getComputedStyle(el);\n    const dot = el.querySelector(\"span[aria-hidden]\");\n    const dotCs = dot ? getComputedStyle(dot) : null;\n    return {\n      color: cs.color,\n      dotOpacity: dotCs?.opacity,\n      dotBg: dotCs?.backgroundColor,\n    };\n  });\n  await page.screenshot({ path: \".playwright-cli/nav-hover-sticky.png\" });\n\n  console.log(\"NAV_HOVER_VERIFY:\", JSON.stringify({ heroHoverCheck, stickyHoverCheck }));\n}\' && \\\nplaywright-cli console"
