      thinking_signature: "\022\304\t\n\301\t\001i\024}\023\360\272L\372q\3265\343=\320Ek\242\363\032.\366\'\276\327q\275P\341\207\253\002~\300\034]\333\331\242\352\003d\354\370kB\241.\2466R\246_\334\371uj\330\a\022\246\376\330-M\364\037\340N_b\215J\252\a\030\035\212\211\213_\274q\321\017Y\232\357\335\003\232\247\3157#\356o\264\036@B\f\205\021\024h\246\236Z\370\321/P%\231z\004\341\'L\032B\036\035\225\272\227!\344\a\322 \266\312\334\363\254\223\333\307? \363\347FBe\032\271\255\357?xY\027\t\2177\225\255\366\r\243w\237D\023t\354\364\374\003\243\250\374\230\203_&4\027\324\207\212\227\232\275\023s\022\322\035X\204W+\252\006\262\365\306\346\360\326\320\377\242\247\020\332\v\240\023\253/\241\254CD\003\240\223\034\004\347n\315\363\364;\235\374\313\204\f\274\001-\006\264\365,\025\222gG\254+\026\2614\234\261\230vj\320\3561/\351F\270u\346+\264\260\365\250Q9 \177\330\256\234\325l\307\306um\341k\020\300\030\250\223Wf\326\274\177AK\235\356;v\263d\331j\262L\367\343vRO\306\035\221m\364=!X\000\373C\256\361x7\004\274\373\226\'j\004j\365\367i\207\373\255\265f\254\277\364\037\247\371\331]\353b\212\\YD\321A\266c\335\224\341?<\340\344 \362p\a\374\004\362f|I\207\332\311i\3059CoX\004\026h\314\350\227\321E\232\035*ai\233l5\204\310\251\224\2071\\J\241\225\240+\005\201\vh\325.\231.\254\253\217\235\303\224 Kqf\230\366e\341U\267\345\022z\221\301\346\306R-9\323*\035\207\370H\265\213\264~\026\334\n\326\222;\017\" \275\355\3366\1779\017\313\371\361\035\177%]-\201|\006\304\\\310d\223\266\214?\275\315S\321/\275\272\257`\311:j\301c_\016y\372\240!\266)\335(v\372\'X\212\275\313\344\342R\210\223\335\216x\311\324\324\320\206\344Q\030\f(xe\016\253\244v\340\324\032q\b\371\270\020\347\027z\243\247\277\004\253\211\036\0203\276J\337\275\330\275\2514.>U\377\241\016\373jV\264\a\353p>\016\237*F\034e![\306\255O)\304u0\237\267\tb)s\231\310\232O\362\257\212\203\b{\307\021|\330\367,\004\n\226\355:\240x\3702bRb\n3\226Yi\216\001\031\245\225q\354\321\302\000\240\216\2104\234r\177\250\314\305u\271N\363\372\270Y\3756\fvYT/\274\016\331\323\003\225\367\2603\230\330\327\323\352\331\215\202\'\353j$\302\016\254y6\332\261\302\033\267f\035k\323\352\337\020P[\240m\320\004\b4\243\031\234\242z7[\375\\\265\233\357\225\016\364\335O\223\321\332 k\313M\230\236z\231\346\220bY\353m\2211\271A\f\337\266x\217\\.\303\337\0369\022\221L=8\350\035 I7\324\215\272\241\005\245\314Y\273\344\026\205\302%\350\025\227\3533\005\211\207%\201\240\331\355\025\314\206\370}\032\252\001\362,?\aH\243}:\302\030l\247\242\b\t\227\t\233N|J\313beq\"\2136\247TU;c\270\376\360j\220X>\260\202jn\002\r2\242\023\306#\271\t>\377\271\317*\240h\207\227\345\3430t\357\270eO\002\216\006\224\031\246y\351\023\267$\365\376Z}lB\307\303I\026,\aJR>\245@\242\a\n\377\327\200Y\262# \203\364\270$\216\375\336\223\234K\025\361\242\b\314\265a\024\224\264\241\213AzY\v-\227\221\242iK~\351y*\201\323\305:\301\204CB\347@_\372\335\331\223]c\310G\364\351\325\317| $Lgl\253\366T\330\366\340-\330}\243[a/U\333wF\347\301\263\277p\201\316MG\033]\347;\aL\000DZ\361\302\003\255\b\034??\'\333\347q\263x\tJ.\365\251F\300\177X\'\3207\024\257g\031\bw\315\364\244\3154\245.\252\353)\203D\301JSi\262!1}i\034\271\335\304w$\004\216\251\256\024\263\234{\353~\222@C\244\311 \353r\b\352\267\363@\301\313\277\273\303\365\2458+\020R::\352\317hCcn\236_\233\211\000\352\202\031@!r\313>\337\033\223S=\357\325\303\253xv\361\034c]\212q\364\016u\r\201%hzUP\351\030t\270\224i\233\213\202\276q\027\303yx\"\316\002\264g}\347\364`/:[\303\266\202\022\342\004\311\321\307\2654\207%\3320\362\023\370\240\353\342\311"
