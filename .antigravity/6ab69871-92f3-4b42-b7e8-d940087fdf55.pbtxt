              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A restorative space delivering timeless beauty through a long term partnership\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    heroTitle: \'A quiet house devoted to unhurried beauty rituals.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    manifesto:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'is founded upon a philosophy of integrity and quiet artistry in hair, skin, and bridal beauty. This manifests in bespoke treatments, a timeless approach rather than following trends, and maintaining a long-lasting relationship with our guests throughout their beauty journey. We understand that what makes you feel radiant evolves with every season of life, and we are here to support and guide you through these natural stages.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    founder: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      label: \'Founder & Owner\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      title: \'Founder of NOVA Unisex Salon\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      specialty: \'Bespoke Skin Architecture, Hair Artistry & Bridal Direction\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      bio: \'Founded with a devotion to calm precision and personal care, she leads NOVA\342\200\231s signature consultations and bespoke rituals\342\200\224blending refined technique with unhurried hospitality at our Kingship by Kahlon sanctuary in Lucknow.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      consultationCaption: \'Personal ritual planning & tailored beauty consultations\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
