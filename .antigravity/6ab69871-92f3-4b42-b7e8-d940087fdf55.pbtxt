    command_line: "python3 -c \'\nimport subprocess\n\n# In orig (960x1280):\n# crop is 200x220+268+288\n# From grid_orig (+260+310):\n#   tilak center is around grid (102, 74) -> global (362, 384) -> local in face_raw (+268+288): (94, 96)\n#   clean forehead skin just to the right-top is grid (114, 62) -> global (374, 372) -> local: (106, 84)\n#   also clean forehead skin just to the left-top is grid (88, 66) -> global (348, 376) -> local: (80, 88)\n# Notice why previous heal picked up eyebrow: previous crop was +70+85 (x=70..88, y=85..103), and y=103 is right on her left eyebrow (grid y=82 -> local y=104)!\n# So clean forehead skin MUST stay strictly y=68..86 (well above eyebrow y=102)!\n\n# Step 1: Extract raw face region with gentle JPEG de-blocking (subtle bilateral/median-free smooth)\nsubprocess.check_call([\n    \"convert\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\",\n    \"-crop\", \"200x220+268+288\", \"+repage\",\n    \".playwright-cli/face_raw2.png\"\n])\n\n# Step 2: Gently heal ONLY the tiny orange tilak (local center 94, 95; radius ~6x8px)\n# Sample clean smooth forehead skin strictly ABOVE the tilak (local 94, 79 -> crop 16x16+86+71)\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/face_raw2.png\",\n    \"(\", \".playwright-cli/face_raw2.png\", \"-crop\", \"16x18+86+72\", \"+repage\",\n         \"-modulate\", \"101,96,100\",\n         \"(\", \"-size\", \"16x18\", \"xc:black\", \"-fill\", \"white\", \"-draw\", \"ellipse 8,9 5.5,7 0,360\", \"-blur\", \"0x2.2\", \")\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\",\n    \")\",\n    \"-geometry\", \"+86+86\", \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/face_clean2.png\"\n])\n\n# Step 3: Scale 1.60x smoothly with Lanczos, NO artifact-amplifying unsharp, and clean gamma-preserving color calibration\n# Instead of linear multiply on blue (which shifts blacks purple), use per-channel -gamma!\n# Per-channel gamma preserves pure black (0->0) and pure white (1->1) while shifting midtone skin warmth cleanly!\n# orig cheek (252,149,98) -> normalized (0.988, 0.584, 0.384)\n# gen  cheek (203,151,125) -> normalized (0.796, 0.592, 0.490)\n# Using gamma + gentle highlight rolloff:\n# R: bring down slightly via level/gamma (gamma ~ 0.72 pulls mid-high red down gently while keeping blacks black)\n# G: neutral (~1.01)\n# B: lift midtones via gamma ~ 1.32 (lifts warm orange midtones to neutral daylight WITHOUT tinting black eyebrows or pupils!)\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/face_clean2.png\",\n    \"-blur\", \"0x0.3\",\n    \"-filter\", \"Lanczos\", \"-resize\", \"320x352!\",\n    \"-channel\", \"R\", \"-gamma\", \"0.78\", \"-evaluate\", \"multiply\", \"0.93\",\n    \"-channel\", \"G\", \"-gamma\", \"0.99\", \"-evaluate\", \"multiply\", \"0.98\",\n    \"-channel\", \"B\", \"-gamma\", \"1.34\", \"-evaluate\", \"multiply\", \"0.99\",\n    \"+channel\",\n    \"-modulate\", \"99,86,100\",\n    \"-attenuate\", \"0.10\", \"+noise\", \"Gaussian\",\n    \".playwright-cli/face_color2.png\"\n])\n\n# Check resulting cheek RGB after calibration!\nout = subprocess.check_output([\n    \"convert\", \".playwright-cli/face_color2.png\", \"-crop\", \"24x24+182+190\", \"+repage\",\n    \"-resize\", \"1x1!\", \"-format\", \"%[fx:int(255*r)],%[fx:int(255*g)],%[fx:int(255*b)]\", \"info:\"\n]).decode().strip()\nprint(\"Calibrated face cheek RGB:\", out, \"(target gen cheek: 203,151,125)\")\n\n# Step 4: Soft feathered elliptical face mask (smoothly blending inside hairline, cheeks, and chin)\nsubprocess.check_call([\n    \"convert\", \"-size\", \"320x352\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"translate 163,195 rotate -8 ellipse 0,0 56,71 0,360\",\n    \"-blur\", \"0x11\",\n    \".playwright-cli/face_mask2.png\"\n])\n\n# Step 5: Composite onto gen portrait at +271+134\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_faithful_1795347756012.jpg\",\n    \"(\", \".playwright-cli/face_color2.png\", \".playwright-cli/face_mask2.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+271+134\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \".playwright-cli/owner_composite_v2.jpg\"\n])\n\n# Step 6: Side-by-side close-up comparison\nsubprocess.check_call([\n    \"convert\",\n    \"(\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\", \"-crop\", \"180x210+280+310\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"(\", \".playwright-cli/owner_composite_v2.jpg\", \"-crop\", \"288x336+292+176\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"+append\", \".playwright-cli/face_compare_v2.jpg\"\n])\nprint(\"v2 composite complete!\")\n\'"
    proposed_command_line: "python3 -c \'\nimport subprocess\n\n# In orig (960x1280):\n# crop is 200x220+268+288\n# From grid_orig (+260+310):\n#   tilak center is around grid (102, 74) -> global (362, 384) -> local in face_raw (+268+288): (94, 96)\n#   clean forehead skin just to the right-top is grid (114, 62) -> global (374, 372) -> local: (106, 84)\n#   also clean forehead skin just to the left-top is grid (88, 66) -> global (348, 376) -> local: (80, 88)\n# Notice why previous heal picked up eyebrow: previous crop was +70+85 (x=70..88, y=85..103), and y=103 is right on her left eyebrow (grid y=82 -> local y=104)!\n# So clean forehead skin MUST stay strictly y=68..86 (well above eyebrow y=102)!\n\n# Step 1: Extract raw face region with gentle JPEG de-blocking (subtle bilateral/median-free smooth)\nsubprocess.check_call([\n    \"convert\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\",\n    \"-crop\", \"200x220+268+288\", \"+repage\",\n    \".playwright-cli/face_raw2.png\"\n])\n\n# Step 2: Gently heal ONLY the tiny orange tilak (local center 94, 95; radius ~6x8px)\n# Sample clean smooth forehead skin strictly ABOVE the tilak (local 94, 79 -> crop 16x16+86+71)\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/face_raw2.png\",\n    \"(\", \".playwright-cli/face_raw2.png\", \"-crop\", \"16x18+86+72\", \"+repage\",\n         \"-modulate\", \"101,96,100\",\n         \"(\", \"-size\", \"16x18\", \"xc:black\", \"-fill\", \"white\", \"-draw\", \"ellipse 8,9 5.5,7 0,360\", \"-blur\", \"0x2.2\", \")\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\",\n    \")\",\n    \"-geometry\", \"+86+86\", \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/face_clean2.png\"\n])\n\n# Step 3: Scale 1.60x smoothly with Lanczos, NO artifact-amplifying unsharp, and clean gamma-preserving color calibration\n# Instead of linear multiply on blue (which shifts blacks purple), use per-channel -gamma!\n# Per-channel gamma preserves pure black (0->0) and pure white (1->1) while shifting midtone skin warmth cleanly!\n# orig cheek (252,149,98) -> normalized (0.988, 0.584, 0.384)\n# gen  cheek (203,151,125) -> normalized (0.796, 0.592, 0.490)\n# Using gamma + gentle highlight rolloff:\n# R: bring down slightly via level/gamma (gamma ~ 0.72 pulls mid-high red down gently while keeping blacks black)\n# G: neutral (~1.01)\n# B: lift midtones via gamma ~ 1.32 (lifts warm orange midtones to neutral daylight WITHOUT tinting black eyebrows or pupils!)\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/face_clean2.png\",\n    \"-blur\", \"0x0.3\",\n    \"-filter\", \"Lanczos\", \"-resize\", \"320x352!\",\n    \"-channel\", \"R\", \"-gamma\", \"0.78\", \"-evaluate\", \"multiply\", \"0.93\",\n    \"-channel\", \"G\", \"-gamma\", \"0.99\", \"-evaluate\", \"multiply\", \"0.98\",\n    \"-channel\", \"B\", \"-gamma\", \"1.34\", \"-evaluate\", \"multiply\", \"0.99\",\n    \"+channel\",\n    \"-modulate\", \"99,86,100\",\n    \"-attenuate\", \"0.10\", \"+noise\", \"Gaussian\",\n    \".playwright-cli/face_color2.png\"\n])\n\n# Check resulting cheek RGB after calibration!\nout = subprocess.check_output([\n    \"convert\", \".playwright-cli/face_color2.png\", \"-crop\", \"24x24+182+190\", \"+repage\",\n    \"-resize\", \"1x1!\", \"-format\", \"%[fx:int(255*r)],%[fx:int(255*g)],%[fx:int(255*b)]\", \"info:\"\n]).decode().strip()\nprint(\"Calibrated face cheek RGB:\", out, \"(target gen cheek: 203,151,125)\")\n\n# Step 4: Soft feathered elliptical face mask (smoothly blending inside hairline, cheeks, and chin)\nsubprocess.check_call([\n    \"convert\", \"-size\", \"320x352\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"translate 163,195 rotate -8 ellipse 0,0 56,71 0,360\",\n    \"-blur\", \"0x11\",\n    \".playwright-cli/face_mask2.png\"\n])\n\n# Step 5: Composite onto gen portrait at +271+134\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_faithful_1795347756012.jpg\",\n    \"(\", \".playwright-cli/face_color2.png\", \".playwright-cli/face_mask2.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+271+134\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \".playwright-cli/owner_composite_v2.jpg\"\n])\n\n# Step 6: Side-by-side close-up comparison\nsubprocess.check_call([\n    \"convert\",\n    \"(\", \"public/assets/aistudio/WhatsApp_Image_2026-11-22_at_14.49.44_890263a1.jpeg\", \"-crop\", \"180x210+280+310\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"(\", \".playwright-cli/owner_composite_v2.jpg\", \"-crop\", \"288x336+292+176\", \"+repage\", \"-resize\", \"300x350!\", \")\",\n    \"+append\", \".playwright-cli/face_compare_v2.jpg\"\n])\nprint(\"v2 composite complete!\")\n\'"
    shell_name: "bash"
  }
}
