    command_line: "trap \'playwright-cli close\' EXIT\nplaywright-cli open --browser=chromium \"http://localhost:3000?autostart=1\" && \\\n  playwright-cli resize 1440 900 && \\\n  sleep 0.4 && \\\n  playwright-cli video-start .playwright-cli/r5-treatments-transition.webm && \\\n  playwright-cli run-code \'async (page) => {\n    const navBtn = page.locator(\"nav[aria-label=\\\"Opening Horizon Navigation\\\"] button\", { hasText: \"Treatments\" });\n    const curtain = page.getByTestId(\"page-transition-curtain\");\n    const root = page.locator(\"#top\");\n\n    await navBtn.hover();\n    await page.waitForTimeout(180);\n    await navBtn.click();\n    await page.waitForTimeout(320);\n    const midPhase = await curtain.getAttribute(\"data-transition-phase\");\n    const midTop = await curtain.evaluate((el) => Math.round(el.getBoundingClientRect().top));\n    await page.screenshot({ path: \".playwright-cli/r5-transition-mid.png\" });\n\n    await page.waitForFunction(\n      () => document.querySelector(\"[data-testid=\\\"page-transition-curtain\\\"]\")?.getAttribute(\"data-transition-phase\") === \"idle\",\n      null,\n      { timeout: 5000 }\n    );\n    await page.waitForTimeout(250);\n    const settledView = await root.getAttribute(\"data-view\");\n    const settledPhase = await curtain.getAttribute(\"data-transition-phase\");\n    const scrollY = await page.evaluate(() => window.scrollY);\n    await page.screenshot({ path: \".playwright-cli/r5-treatments-arrived.png\" });\n\n    return JSON.stringify({ midPhase, midTop, settledView, settledPhase, scrollY });\n  }\' && \\\n  playwright-cli video-stop && \\\n  playwright-cli console"
    proposed_command_line: "trap \'playwright-cli close\' EXIT\nplaywright-cli open --browser=chromium \"http://localhost:3000?autostart=1\" && \\\n  playwright-cli resize 1440 900 && \\\n  sleep 0.4 && \\\n  playwright-cli video-start .playwright-cli/r5-treatments-transition.webm && \\\n  playwright-cli run-code \'async (page) => {\n    const navBtn = page.locator(\"nav[aria-label=\\\"Opening Horizon Navigation\\\"] button\", { hasText: \"Treatments\" });\n    const curtain = page.getByTestId(\"page-transition-curtain\");\n    const root = page.locator(\"#top\");\n\n    await navBtn.hover();\n    await page.waitForTimeout(180);\n    await navBtn.click();\n    await page.waitForTimeout(320);\n    const midPhase = await curtain.getAttribute(\"data-transition-phase\");\n    const midTop = await curtain.evaluate((el) => Math.round(el.getBoundingClientRect().top));\n    await page.screenshot({ path: \".playwright-cli/r5-transition-mid.png\" });\n\n    await page.waitForFunction(\n      () => document.querySelector(\"[data-testid=\\\"page-transition-curtain\\\"]\")?.getAttribute(\"data-transition-phase\") === \"idle\",\n      null,\n      { timeout: 5000 }\n    );\n    await page.waitForTimeout(250);\n    const settledView = await root.getAttribute(\"data-view\");\n    const settledPhase = await curtain.getAttribute(\"data-transition-phase\");\n    const scrollY = await page.evaluate(() => window.scrollY);\n    await page.screenshot({ path: \".playwright-cli/r5-treatments-arrived.png\" });\n\n    return JSON.stringify({ midPhase, midTop, settledView, settledPhase, scrollY });\n  }\' && \\\n  playwright-cli video-stop && \\\n  playwright-cli console"
