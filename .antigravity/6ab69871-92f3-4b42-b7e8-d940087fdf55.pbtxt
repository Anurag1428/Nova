    command_line: "python3 -c \'\nimport subprocess\n\n# Start from v2_394.png (exact clean forehead, eyes, nose, lips, chin, neck)\n# and base_394.png (original studio portrait with warm-black studio hair)\n\n# 1. Warm-balanced real face skin (matching v2_394 tone exactly!)\nsubprocess.run([\n    \"convert\", \".playwright-cli/exact2_scaled.png\",\n    \"-modulate\", \"98,84,102.0\",\n    \"-channel\", \"R\", \"-gamma\", \"0.99\",\n    \"-channel\", \"B\", \"-gamma\", \"1.02\",\n    \"+channel\",\n    \".playwright-cli/face_v2tone.png\"\n], check=True)\n\n# Very subtle de-pink ONLY on the outer right cheekbone blush (x=240..260, y=155..205)\nsubprocess.run([\n    \"convert\", \"-size\", \"394x394\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"polygon 238,150 262,150 260,210 236,210 242,180\",\n    \"-blur\", \"0x8\",\n    \".playwright-cli/r_depink_mask.png\"\n], check=True)\n\nsubprocess.run([\n    \"convert\", \".playwright-cli/face_v2tone.png\",\n    \"(\", \".playwright-cli/face_v2tone.png\", \"-modulate\", \"98,74,102.8\", \")\",\n    \".playwright-cli/r_depink_mask.png\",\n    \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/face_v2tone_clean.png\"\n], check=True)\n\n# 2. Clean studio dark hair backdrop JUST OUTSIDE both lower jaw edges on v2_394:\n#   Left outer jaw hair backdrop (replaces bluish/fuzzy halo at x=112..148, y=195..248)\n#   Right outer jaw hair backdrop below earlobe (replaces pale/grey smudge at x=238..264, y=206..248)\nsubprocess.run([\n    \"convert\", \"-size\", \"394x394\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"polygon 112,194 140,196 146,222 158,244 132,250 112,240\",\n    \"-blur\", \"0x3\",\n    \".playwright-cli/left_hair_bg_mask.png\"\n], check=True)\n\nsubprocess.run([\n    \"convert\", \"-size\", \"394x394\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"polygon 242,208 264,206 266,246 236,248 232,232\",\n    \"-blur\", \"0x3\",\n    \".playwright-cli/right_hair_bg_mask.png\"\n], check=True)\n\n# Apply warm-black studio hair from base_394 shifted slightly inward on left (+18,+4) and right (-10,+8)\nsubprocess.run([\n    \"convert\", \".playwright-cli/v2_394.png\",\n    \"(\", \".playwright-cli/base_394.png\", \"-roll\", \"+18+4\", \")\",\n    \".playwright-cli/left_hair_bg_mask.png\",\n    \"-compose\", \"Over\", \"-composite\",\n    \"(\", \".playwright-cli/base_394.png\", \"-roll\", \"-12+10\", \")\",\n    \".playwright-cli/right_hair_bg_mask.png\",\n    \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/v2_clean_hair_bg.png\"\n], check=True)\n\n# 3. Now composite ONLY her crisp real LOWER-LEFT and LOWER-RIGHT cheek/jaw skin\n#    (from y=170 down to y=246, smoothly feathered into v2_394 inside the face and\n#    CRISPLY feathered 2.0px along the exact outer left & right jaw contours!)\n#    Wait: using a crisp jaw contour on the lower half (y=165..248) preserves 100% of v2_394 forehead/eyes/nose/lips/neck!\nsubprocess.run([\n    \"convert\", \"-size\", \"394x394\", \"xc:black\",\n    \"-fill\", \"white\",\n    # Left lower cheek/jaw patch: hugs exact real left jaw contour on outside, feathers inward onto cheek\n    \"-draw\", \"polygon 125,180 156,184 166,238 164,244 150,235 138,222 130,204\",\n    # Right lower cheek/jaw patch: hugs exact real right jaw contour on outside, feathers inward onto cheek\n    \"-draw\", \"polygon 226,174 252,174 252,194 247,213 238,228 224,240 212,245 210,234 222,206\",\n    \"-blur\", \"0x2.2\",\n    \".playwright-cli/lower_jaw_sides_mask.png\"\n], check=True)\n\nsubprocess.run([\n    \"convert\", \".playwright-cli/v2_clean_hair_bg.png\",\n    \".playwright-cli/face_v2tone_clean.png\",\n    \".playwright-cli/lower_jaw_sides_mask.png\",\n    \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/merged_jaw_v2.png\"\n], check=True)\n\n# Gently feather ONLY the seam around the outer right cheek/ear junction (x=247..257, y=184..216)\n# by letting natural studio shadow sit softly right along the outer 3px of the right jaw next to the ear\nsubprocess.run([\n    \"convert\", \"-size\", \"394x394\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"polygon 246,182 258,182 256,216 242,232 238,228 247,212 250,196\",\n    \"-blur\", \"0x3.5\",\n    \".playwright-cli/r_edge_soft_shadow.png\"\n], check=True)\n\nsubprocess.run([\n    \"convert\", \".playwright-cli/merged_jaw_v2.png\",\n    \"(\", \".playwright-cli/merged_jaw_v2.png\", \"-modulate\", \"93,88,100\", \")\",\n    \".playwright-cli/r_edge_soft_shadow.png\",\n    \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/merged_jaw_v2_final.png\"\n], check=True)\n\n# Place back onto the full 848x1264 v2 image\nsubprocess.run([\n    \"convert\", \"src/assets/images/owner_portrait_clean_cheeks_v2.jpg\",\n    \"(\", \".playwright-cli/merged_jaw_v2_final.png\", \".playwright-cli/box_mask.png\", \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+254+166\",\n    \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_clean_jaw.jpg\"\n], check=True)\n\n# Generate tight zoomed before/after comparison + 3x zoom on jaw area\nsubprocess.run([\n    \"convert\", \"src/assets/images/owner_portrait_clean_jaw.jpg\",\n    \"-crop\", \"320x320+260+180\", \"+repage\", \"-resize\", \"640x640\",\n    \".playwright-cli/jaw_inspect_after2.png\"\n], check=True)\n\nsubprocess.run([\n    \"convert\", \"+append\", \".playwright-cli/jaw_inspect_before.png\", \".playwright-cli/jaw_inspect_after2.png\",\n    \".playwright-cli/jaw_before_after2.png\"\n], check=True)\n\n# Also zoomed tight crop of JUST the lower cheeks & jaw (before vs after)\nsubprocess.run([\n    \"convert\", \"src/assets/images/owner_portrait_clean_cheeks_v2.jpg\",\n    \"-crop\", \"220x130+340+320\", \"+repage\", \"-resize\", \"660x390\",\n    \".playwright-cli/jaw_tight_before.png\"\n], check=True)\nsubprocess.run([\n    \"convert\", \"src/assets/images/owner_portrait_clean_jaw.jpg\",\n    \"-crop\", \"220x130+340+320\", \"+repage\", \"-resize\", \"660x390\",\n    \".playwright-cli/jaw_tight_after.png\"\n], check=True)\nsubprocess.run([\n    \"convert\", \"+append\", \".playwright-cli/jaw_tight_before.png\", \".playwright-cli/jaw_tight_after.png\",\n    \".playwright-cli/jaw_tight_compare.png\"\n], check=True)\nprint(\"Done v2\")\n\'"
    proposed_command_line: "python3 -c \'\nimport subprocess\n\n# Start from v2_394.png (exact clean forehead, eyes, nose, lips, chin, neck)\n# and base_394.png (original studio portrait with warm-black studio hair)\n\n# 1. Warm-balanced real face skin (matching v2_394 tone exactly!)\nsubprocess.run([\n    \"convert\", \".playwright-cli/exact2_scaled.png\",\n    \"-modulate\", \"98,84,102.0\",\n    \"-channel\", \"R\", \"-gamma\", \"0.99\",\n    \"-channel\", \"B\", \"-gamma\", \"1.02\",\n    \"+channel\",\n    \".playwright-cli/face_v2tone.png\"\n], check=True)\n\n# Very subtle de-pink ONLY on the outer right cheekbone blush (x=240..260, y=155..205)\nsubprocess.run([\n    \"convert\", \"-size\", \"394x394\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"polygon 238,150 262,150 260,210 236,210 242,180\",\n    \"-blur\", \"0x8\",\n    \".playwright-cli/r_depink_mask.png\"\n], check=True)\n\nsubprocess.run([\n    \"convert\", \".playwright-cli/face_v2tone.png\",\n    \"(\", \".playwright-cli/face_v2tone.png\", \"-modulate\", \"98,74,102.8\", \")\",\n    \".playwright-cli/r_depink_mask.png\",\n    \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/face_v2tone_clean.png\"\n], check=True)\n\n# 2. Clean studio dark hair backdrop JUST OUTSIDE both lower jaw edges on v2_394:\n#   Left outer jaw hair backdrop (replaces bluish/fuzzy halo at x=112..148, y=195..248)\n#   Right outer jaw hair backdrop below earlobe (replaces pale/grey smudge at x=238..264, y=206..248)\nsubprocess.run([\n    \"convert\", \"-size\", \"394x394\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"polygon 112,194 140,196 146,222 158,244 132,250 112,240\",\n    \"-blur\", \"0x3\",\n    \".playwright-cli/left_hair_bg_mask.png\"\n], check=True)\n\nsubprocess.run([\n    \"convert\", \"-size\", \"394x394\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"polygon 242,208 264,206 266,246 236,248 232,232\",\n    \"-blur\", \"0x3\",\n    \".playwright-cli/right_hair_bg_mask.png\"\n], check=True)\n\n# Apply warm-black studio hair from base_394 shifted slightly inward on left (+18,+4) and right (-10,+8)\nsubprocess.run([\n    \"convert\", \".playwright-cli/v2_394.png\",\n    \"(\", \".playwright-cli/base_394.png\", \"-roll\", \"+18+4\", \")\",\n    \".playwright-cli/left_hair_bg_mask.png\",\n    \"-compose\", \"Over\", \"-composite\",\n    \"(\", \".playwright-cli/base_394.png\", \"-roll\", \"-12+10\", \")\",\n    \".playwright-cli/right_hair_bg_mask.png\",\n    \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/v2_clean_hair_bg.png\"\n], check=True)\n\n# 3. Now composite ONLY her crisp real LOWER-LEFT and LOWER-RIGHT cheek/jaw skin\n#    (from y=170 down to y=246, smoothly feathered into v2_394 inside the face and\n#    CRISPLY feathered 2.0px along the exact outer left & right jaw contours!)\n#    Wait: using a crisp jaw contour on the lower half (y=165..248) preserves 100% of v2_394 forehead/eyes/nose/lips/neck!\nsubprocess.run([\n    \"convert\", \"-size\", \"394x394\", \"xc:black\",\n    \"-fill\", \"white\",\n    # Left lower cheek/jaw patch: hugs exact real left jaw contour on outside, feathers inward onto cheek\n    \"-draw\", \"polygon 125,180 156,184 166,238 164,244 150,235 138,222 130,204\",\n    # Right lower cheek/jaw patch: hugs exact real right jaw contour on outside, feathers inward onto cheek\n    \"-draw\", \"polygon 226,174 252,174 252,194 247,213 238,228 224,240 212,245 210,234 222,206\",\n    \"-blur\", \"0x2.2\",\n    \".playwright-cli/lower_jaw_sides_mask.png\"\n], check=True)\n\nsubprocess.run([\n    \"convert\", \".playwright-cli/v2_clean_hair_bg.png\",\n    \".playwright-cli/face_v2tone_clean.png\",\n    \".playwright-cli/lower_jaw_sides_mask.png\",\n    \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/merged_jaw_v2.png\"\n], check=True)\n\n# Gently feather ONLY the seam around the outer right cheek/ear junction (x=247..257, y=184..216)\n# by letting natural studio shadow sit softly right along the outer 3px of the right jaw next to the ear\nsubprocess.run([\n    \"convert\", \"-size\", \"394x394\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", \"polygon 246,182 258,182 256,216 242,232 238,228 247,212 250,196\",\n    \"-blur\", \"0x3.5\",\n    \".playwright-cli/r_edge_soft_shadow.png\"\n], check=True)\n\nsubprocess.run([\n    \"convert\", \".playwright-cli/merged_jaw_v2.png\",\n    \"(\", \".playwright-cli/merged_jaw_v2.png\", \"-modulate\", \"93,88,100\", \")\",\n    \".playwright-cli/r_edge_soft_shadow.png\",\n    \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/merged_jaw_v2_final.png\"\n], check=True)\n\n# Place back onto the full 848x1264 v2 image\nsubprocess.run([\n    \"convert\", \"src/assets/images/owner_portrait_clean_cheeks_v2.jpg\",\n    \"(\", \".playwright-cli/merged_jaw_v2_final.png\", \".playwright-cli/box_mask.png\", \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+254+166\",\n    \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_clean_jaw.jpg\"\n], check=True)\n\n# Generate tight zoomed before/after comparison + 3x zoom on jaw area\nsubprocess.run([\n    \"convert\", \"src/assets/images/owner_portrait_clean_jaw.jpg\",\n    \"-crop\", \"320x320+260+180\", \"+repage\", \"-resize\", \"640x640\",\n    \".playwright-cli/jaw_inspect_after2.png\"\n], check=True)\n\nsubprocess.run([\n    \"convert\", \"+append\", \".playwright-cli/jaw_inspect_before.png\", \".playwright-cli/jaw_inspect_after2.png\",\n    \".playwright-cli/jaw_before_after2.png\"\n], check=True)\n\n# Also zoomed tight crop of JUST the lower cheeks & jaw (before vs after)\nsubprocess.run([\n    \"convert\", \"src/assets/images/owner_portrait_clean_cheeks_v2.jpg\",\n    \"-crop\", \"220x130+340+320\", \"+repage\", \"-resize\", \"660x390\",\n    \".playwright-cli/jaw_tight_before.png\"\n], check=True)\nsubprocess.run([\n    \"convert\", \"src/assets/images/owner_portrait_clean_jaw.jpg\",\n    \"-crop\", \"220x130+340+320\", \"+repage\", \"-resize\", \"660x390\",\n    \".playwright-cli/jaw_tight_after.png\"\n], check=True)\nsubprocess.run([\n    \"convert\", \"+append\", \".playwright-cli/jaw_tight_before.png\", \".playwright-cli/jaw_tight_after.png\",\n    \".playwright-cli/jaw_tight_compare.png\"\n], check=True)\nprint(\"Done v2\")\n\'"
    shell_name: "bash"
  }
}
