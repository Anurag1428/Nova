              text: "    {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      id: \'chapter-1\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      number: \'(1).\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      index: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      title: \'A considered experience\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      shortTitle: \'Considered space\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      description:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'More than an appointment, Maison Aura is a quiet pause. From warm linen and softened acoustics to unhurried transition time between rituals, every detail is composed to restore stillness.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      detailNote: \'Private suites \302\267 Unhurried pacing \302\267 Sensory calm\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
