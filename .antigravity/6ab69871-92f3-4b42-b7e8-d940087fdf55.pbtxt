    tool_calls {
      id: "call_3982060122819353936"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Replace all remaining Maison Aura references with NOVA across salonData.ts\", \"Instruction\":\"Update ritual names, sanctuary copy, alt text, and founder bio in src/data/salonData.ts to use NOVA consistently\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":116, \"ReplacementContent\":\"      alt: \'Calm, sunlit treatment sanctuary at NOVA with warm linen and natural stone\',\", \"StartLine\":113, \"TargetContent\":\"      alt: \'Calm, sunlit treatment sanctuary at Maison Aura with warm linen and natural stone\',\"}, {\"AllowMultiple\":false, \"EndLine\":162, \"ReplacementContent\":\"        \'More than an appointment, NOVA is a quiet pause. From warm linen and softened acoustics to unhurried transition time between rituals, every detail is composed to restore stillness.\',\", \"StartLine\":159, \"TargetContent\":\"        \'More than an appointment, Maison Aura is a quiet pause. From warm linen and softened acoustics to unhurried transition time between rituals, every detail is composed to restore stillness.\',\"}, {\"AllowMultiple\":false, \"EndLine\":255, \"ReplacementContent\":\"          id: \'nova-signature-facial\',\\n          name: \'The NOVA Signature Facial\',\", \"StartLine\":250, \"TargetContent\":\"          id: \'aura-signature-facial\',\\n          name: \'The Maison Aura Signature Facial\',\"}, {\"AllowMultiple\":false, \"EndLine\":396, \"ReplacementContent\":\"            \'Our recommended introduction to NOVA\342\200\224combining a 25-minute in-depth consultation with a 65-minute tailored facial treatment.\',\", \"StartLine\":393, \"TargetContent\":\"            \'Our recommended introduction to Maison Aura\342\200\224combining a 25-minute in-depth consultation with a 65-minute tailored facial treatment.\',\"}, {\"AllowMultiple\":false, \"EndLine\":429, \"ReplacementContent\":\"    lead:\\n      \'Every ritual at NOVA is guided by restraint, tactile skill, and respect for your natural features. We favour thoughtful consistency over aggressive trends.\',\\n    paragraphs: [\\n      \'We believe the most meaningful beauty treatments do not seek to disguise who you are. Instead, they create the quiet conditions in which healthy skin, cared-for hands, and unforced confidence can surface naturally.\',\\n      \'From the temperature of our compresses to the pacing of our consultations, nothing is rushed and nothing is standardized. We take the time to understand what feels restorative to you.\',\\n    ],\\n    linkLabel: \'Discover our sanctuary & team\',\\n  },\\n\\n  about: {\\n    heroKicker: \'ABOUT NOVA\',\\n    heroTitle: \'A quiet house devoted to unhurried beauty rituals.\',\\n    storyParagraphs: [\\n      \'Conceived as an intimate alternative to high-turnover salons, NOVA was created for guests who value stillness as much as craft. Our space pairs warm limewashed walls, natural travertine stone, and filtered daylight to soften the transition from the outside world.\',\", \"StartLine\":413, \"TargetContent\":\"    lead:\\n      \'Every ritual at Maison Aura is guided by restraint, tactile skill, and respect for your natural features. We favour thoughtful consistency over aggressive trends.\',\\n    paragraphs: [\\n      \'We believe the most meaningful beauty treatments do not seek to disguise who you are. Instead, they create the quiet conditions in which healthy skin, cared-for hands, and unforced confidence can surface naturally.\',\\n      \'From the temperature of our compresses to the pacing of our consultations, nothing is rushed and nothing is standardized. We take the time to understand what feels restorative to you.\',\\n    ],\\n    linkLabel: \'Discover our sanctuary & team\',\\n  },\\n\\n  about: {\\n    heroKicker: \'ABOUT MAISON AURA\',\\n    heroTitle: \'A quiet house devoted to unhurried beauty rituals.\',\\n    storyParagraphs: [\\n      \'Conceived as an intimate alternative to high-turnover salons, Maison Aura was created for guests who value stillness as much as craft. Our space pairs warm limewashed walls, natural travertine stone, and filtered daylight to soften the transition from the outside world.\',\"}, {\"AllowMultiple\":false, \"EndLine\":451, \"ReplacementContent\":\"        bio: \'Founder of NOVA Unisex Salon. Specializes in slow manual facial contouring, barrier restoration, and guiding clients toward effortless, enduring skin health.\',\", \"StartLine\":448, \"TargetContent\":\"        bio: \'Founder of Nova Maison Aura. Specializes in slow manual facial contouring, barrier restoration, and guiding clients toward effortless, enduring skin health.\',\"}], \"TargetFile\":\"/src/data/salonData.ts\", \"toolAction\":\"Updating salonData to NOVA branding\", \"toolSummary\":\"Update salonData to NOVA\"}"
