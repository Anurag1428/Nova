n\").first().click();    await page.waitForTimeout(450);    const nailsActive = await page.getByTestId(\"modality-chapter-nails\").getAttribute(\"data-active\");    // Click first nail ritual button to verify booking drawer opens    await page.getByTestId(\"modality-chapter-nails\").locator(\"ul button\").first().click();    await page.waitForTimeout(300);    const drawerVisible = await page.getByRole(\"dialog\").isVisible();    await page.keyboard.press(\"Escape\");    await page.waitForTimeout(250);    // Scroll to Pre & Aftercare band    await page.evaluate(() => {      const el = document.querySelector(\"[data-testid=\\\"treatments-aftercare\\\"]\");      if (el) window.scrollTo(0, el.offsetTop);    });    await page.waitForTimeout(500);    await page.screenshot({ path: \".playwright-cli/t1-aftercare.png\" });    // Check broken images    const brokenImgs = await page.evaluate(() =>      Array.from(document.querySelectorAll(\"img\"))        .filter((img) => img.complete && img.naturalWidth === 0)        .map((img) => img.getAttribute(\"src\"))    );    return JSON.stringify({ nailsActive, drawerVisible, brokenImgs });  })(page);```### ResultTotal messages: 3 (Errors: 0, Warnings: 0)Returning 1 messages for level \"info\"[INFO] %cDownload the React DevTools for a better development experience: https://react.dev/link/react-devtools font-weight:bold @ http://localhost:3000/node_modules/.vite/deps/react-dom_client.js?v=980e7826:15801Browser \'default\' closed\n\n### Latest snapshot (.playwright-cli/page-2026-11-22T06-31-44-756Z.yml)\n```yaml\n- generic [ref=e3]:\n  - banner \"Primary Sticky Navigation\":\n    - link \"NOVA\":\n      - /url: \"#top\"\n      - generic [aria-hidden]: \"N\"\n      - generic:\n        - generic [aria-hidden]: O\n        - generic [aria-hidden]: V\n      - generic [aria-hidden]: A\n    - navigation \"Main Navigation\":\n      - button \"Menu\"\n      - button \"Treatments\"\n      - button \"Concerns\"\n      - button \"About\"\n    - gen