    command_line: "python3 -c \'\nimport subprocess\n\nscale = 1.64\nS = int(round(240 * scale)) # 394\n\n# Reuse the EXACT same color-calibrated face pixels (exact2_scaled.png) so her face does NOT change by a single pixel!\n# Only fix the mask polygon along the chin/neck and clean any stray base chin-shadow sliver underneath!\n\n# Step 1: On base_warm2.png, gently smooth away the old base chin-bottom shadow line around y=402..424\n# and slightly tuck the left-lower base jaw curve into her natural dark hair shadow so ZERO double-jaw/extra-neck sliver can peek out!\n# First check what color her dark hair & smooth neck are right there:\nneck_rgb = subprocess.check_output([\n    \"convert\", \".playwright-cli/base_warm2.png\", \"-crop\", \"30x16+428+430\", \"+repage\",\n    \"-resize\", \"1x1!\", \"-format\", \"rgb(%[fx:int(255*r)],%[fx:int(255*g)],%[fx:int(255*b)])\", \"info:\"\n]).decode().strip()\nhair_rgb = subprocess.check_output([\n    \"convert\", \".playwright-cli/base_warm2.png\", \"-crop\", \"16x16+360+400\", \"+repage\",\n    \"-resize\", \"1x1!\", \"-format\", \"rgb(%[fx:int(255*r)],%[fx:int(255*g)],%[fx:int(255*b)])\", \"info:\"\n]).decode().strip()\nprint(\"Base neck RGB:\", neck_rgb, \"| Base hair RGB:\", hair_rgb)\n\n# Softly fill ONLY the tiny left-lower base chin-rim area (x=378..405, y=396..420) with subtle dark hair shadow\n# and smooth the chin-to-neck transition (x=402..478, y=406..432) with soft neck tone BEFORE compositing her real chin + real upper neck on top!\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/base_warm2.png\",\n    \"(\", \"-size\", \"848x1264\", \"xc:none\",\n         \"-fill\", hair_rgb,\n         \"-draw\", \"ellipse 384,412 20,18 0,360\",\n         \"-blur\", \"0x6\",\n    \")\", \"-compose\", \"Over\", \"-composite\",\n    \"(\", \"-size\", \"848x1264\", \"xc:none\",\n         \"-fill\", neck_rgb,\n         \"-draw\", \"ellipse 438,418 36,14 0,360\",\n         \"-blur\", \"0x7\",\n    \")\", \"-compose\", \"Over\", \"-composite\",\n    \".playwright-cli/base_clean_neck.png\"\n])\n\n# Step 2: Updated polygon mask that keeps her EXACT face (100% unchanged!) AND smoothly extends down across her REAL upper neck (y=148..166)\n# so her real chin + real smooth neck transition sits cleanly on top with ZERO double chin line!\n# Also tuck the viewer-right ear edge gently inside her hair line so no extra ear sliver sticks out.\npts_240 = [\n    (81, 56), (105, 48), (128, 51), (144, 62), (151, 80),\n    (152, 102), (149, 122), (144, 137), (145, 152), (144, 164),\n    (124, 166), (104, 164), (100, 152), (96, 146),\n    (85, 136), (79, 118), (77, 94), (79, 72)\n]\npoly_str = \" \".join(f\"{round(x*scale)},{round(y*scale)}\" for x, y in pts_240)\ntilak_x = round(102 * scale)\ntilak_y = round(73 * scale)\n\nsubprocess.check_call([\n    \"convert\", \"-size\", f\"{S}x{S}\", \"xc:black\",\n    \"-fill\", \"white\",\n    \"-draw\", f\"polygon {poly_str}\",\n    \"-blur\", \"0x7.5\",\n    \"(\", \"-size\", f\"{S}x{S}\", \"xc:white\",\n         \"-fill\", \"black\",\n         \"-draw\", f\"ellipse {tilak_x},{tilak_y} 13,15 0,360\",\n         \"-blur\", \"0x6\",\n    \")\",\n    \"-compose\", \"Multiply\", \"-composite\",\n    \".playwright-cli/neck_fixed_mask.png\"\n])\n\n# Step 3: Composite cleanly onto base_clean_neck.png at exact same +254+166 offset\nsubprocess.check_call([\n    \"convert\", \".playwright-cli/base_clean_neck.png\",\n    \"(\", \".playwright-cli/exact2_scaled.png\", \".playwright-cli/neck_fixed_mask.png\",\n         \"-alpha\", \"off\", \"-compose\", \"CopyOpacity\", \"-composite\", \")\",\n    \"-geometry\", \"+254+166\", \"-compose\", \"Over\", \"-composite\",\n    \"-quality\", \"95\",\n    \"src/assets/images/owner_portrait_clean_neck.jpg\"\n])\n\n# Step 4: Save tight zoomed crop matching the user screenshot (image_88f4d6e9.png) to inspect chin & neck at full zoom!\nsubprocess.check_call([\n    \"convert\", \"src/assets/images/owner_portrait_clean_neck.jpg\",\n    \"-crop\", \"420x260+230+205\", \"+repage\",\n    \".playwright-cli/neck_zoom_check.png\"\n])\nprint(\"Neck fix complete!\")\n\'"
