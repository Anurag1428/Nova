      name: "run_command"
      arguments_json: "{\"CommandLine\":\"trap \'playwright-cli close\' EXIT\\nmkdir -p .playwright-cli\\nplaywright-cli open --browser=chromium http://localhost:3000 && \\\\\\nplaywright-cli resize 1440 900 && \\\\\\nplaywright-cli run-code \'async (page) => {\\n  await page.getByRole(\\\"navigation\\\", { name: \\\"Opening Horizon Navigation\\\" }).getByRole(\\\"button\\\", { name: \\\"Treatments\\\" }).click();\\n  await page.waitForSelector(\\\"[data-testid=treatments-journey]\\\", { timeout: 12000 });\\n  await page.waitForFunction(() => {\\n    const c = document.querySelector(\\\"[data-testid=page-transition-curtain]\\\");\\n    return !c || c.getAttribute(\\\"data-transition-phase\\\") === \\\"idle\\\";\\n  }, { timeout: 12000 });\\n\\n  // Open Menu -> click Book Consultation -> verify Booking Dialog opens\\n  await page.getByRole(\\\"navigation\\\", { name: \\\"Main Navigation\\\" }).getByRole(\\\"button\\\", { name: \\\"Menu\\\" }).click();\\n  await page.waitForSelector(\\\"[data-testid=nova-menu-drawer]\\\", { timeout: 5000 });\\n  await page.waitForTimeout(450);\\n  await page.locator(\\\"[data-testid=nova-menu-drawer] nav button\\\", { hasText: \\\"Book Consultation\\\" }).click();\\n  await page.waitForTimeout(450);\\n  const bookingOpened = await page.getByRole(\\\"dialog\\\").isVisible();\\n  await page.keyboard.press(\\\"Escape\\\");\\n  await page.waitForTimeout(300);\\n\\n  // Re-open Menu -> verify exact Close button closes cleanly\\n  await page.getByRole(\\\"navigation\\\", { name: \\\"Main Navigation\\\" }).getByRole(\\\"button\\\", { name: \\\"Menu\\\" }).click();\\n  await page.waitForSelector(\\\"[data-testid=nova-menu-drawer]\\\", { timeout: 5000 });\\n  await page.waitForTimeout(450);\\n  await page.getByRole(\\\"button\\\", { name: \\\"Close navigation menu\\\", exact: true }).click();\\n  await page.waitForTimeout(550);\\n  const menuClosedCount = await page.locator(\\\"[data-testid=nova-menu-drawer]\\\").count();\\n\\n  // Re-open Menu -> click About -> verify page navigates to About\\n  await page.getByRole(\\\"navigation\\\", { name: \\\"Main Navigation\\\" }).getByRole(\\\"button\\\", { name: \\\"Menu\\\" }).click();\\n  await page.waitForSelector(\\\"[data-testid=nova-menu-drawer]\\\", { timeout: 5000 });\\n  await page.waitForTimeout(450);\\n  await page.locator(\\\"[data-testid=nova-menu-drawer] nav button\\\", { hasText: \\\"About\\\" }).click();\\n  await page.waitForFunction(() => document.getElementById(\\\"top\\\")?.getAttribute(\\\"data-view\\\") === \\\"about\\\", { timeout: 12000 });\\n  await page.waitForFunction(() => {\\n    const c = document.querySelector(\\\"[data-testid=page-transition-curtain]\\\");\\n    return !c || c.getAttribute(\\\"data-transition-phase\\\") === \\\"idle\\\";\\n  }, { timeout: 12000 });\\n  const navigatedToAbout = await page.evaluate(() => document.getElementById(\\\"top\\\")?.getAttribute(\\\"data-view\\\"));\\n\\n  // Mobile 390x844 check\\n  await page.setViewportSize({ width: 390, height: 844 });\\n  await page.waitForTimeout(250);\\n  await page.getByRole(\\\"button\\\", { name: \\\"Open navigation menu\\\" }).click();\\n  await page.waitForSelector(\\\"[data-testid=nova-menu-drawer]\\\", { timeout: 5000 });\\n  await page.waitForTimeout(650);\\n  const mobileOverflow = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\\n  await page.screenshot({ path: \\\".playwright-cli/menu-mobile-v2.png\\\" });\\n\\n  console.log(\\\"MENU_VERIFY_OK:\\\", JSON.stringify({\\n    bookingOpened,\\n    menuClosedCount,\\n    navigatedToAbout,\\n    mobileOverflow,\\n  }));\\n}\' && \\\\\\nplaywright-cli console\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Completing MenuDrawer journey and mobile verification\", \"toolSummary\":\"Complete MenuDrawer verification\"}"
